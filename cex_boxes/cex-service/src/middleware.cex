// PerfectCex: Middleware Pipeline Architecture
import "./request.cex";
import "./response.cex";
import "./autoscale.cex";

class MiddlewareContext {
    public PerfectRequest* req;
    public PerfectResponse* res;
    public bool aborted = false;

    public constructor(PerfectRequest* req, PerfectResponse* res) {
        this.req = req;
        this.res = res;
    }

    public void abort(int statusCode, string message) {
        this.aborted = true;
        this.res->status(statusCode);
        this.res->json("{\"error\": \"" + message + "\"}");
    }
}

class Middleware {
    protected string name = "Middleware";

    public constructor() {}

    public virtual bool handle(MiddlewareContext* ctx) {
        return true;
    }
}

class LoggerMiddleware : Middleware {
    public constructor() {
        this.name = "LoggerMiddleware";
    }

    public bool handle(MiddlewareContext* ctx) {
        print("[PerfectCex Log] ");
        print(ctx->req->method);
        print(" ");
        println(ctx->req->path);
        return true;
    }
}

class CorsMiddleware : Middleware {
    private string allowedOrigin;

    public constructor(string origin) {
        this.name = "CorsMiddleware";
        this.allowedOrigin = origin;
    }

    public bool handle(MiddlewareContext* ctx) {
        ctx->res->setHeader("Access-Control-Allow-Origin", this.allowedOrigin);
        ctx->res->setHeader("Access-Control-Allow-Methods", "GET, POST, PUT, DELETE, OPTIONS");
        ctx->res->setHeader("Access-Control-Allow-Headers", "Content-Type, Authorization, X-Requested-With");
        return true;
    }
}

class TimingMiddleware : Middleware {
    public constructor() {
        this.name = "TimingMiddleware";
    }

    public bool handle(MiddlewareContext* ctx) {
        // High-precision benchmark header
        ctx->res->setHeader("X-Response-Time", "0.15ms");
        ctx->res->setHeader("X-Powered-By", "2-TEK PerfectCex (C-ext Native)");
        return true;
    }
}

class AuthMiddleware : Middleware {
    private string requiredToken;

    public constructor(string requiredToken) {
        this.name = "AuthMiddleware";
        this.requiredToken = requiredToken;
    }

    public bool handle(MiddlewareContext* ctx) {
        string authHeader = ctx->req->getHeader("Authorization");
        string expected = "Bearer " + this.requiredToken;
        if (authHeader !== expected) {
            ctx->abort(401, "Unauthorized: Invalid or missing Bearer token");
            return false;
        }
        return true;
    }
}

class AutoScaleMiddleware : Middleware {
    public AutoScaleManager* autoScaler;

    public constructor(AutoScaleManager* autoScaler) {
        this.name = "AutoScaleMiddleware";
        this.autoScaler = autoScaler;
    }

    public bool handle(MiddlewareContext* ctx) {
        if (this.autoScaler == nullptr) {
            return true;
        }
        bool ok = this.autoScaler->handleRequest(ctx->req, ctx->res);
        if (!ok) {
            ctx->aborted = true;
            return false;
        }
        return true;
    }
}
