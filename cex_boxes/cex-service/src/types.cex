// PerfectCex: Common Types, Headers, and Status Constants
// Next.js-inspired High-Performance Web Framework for C-ext

class HttpHeader {
    public string key;
    public string val;

    public constructor(string key, string val) {
        this.key = key;
        this.val = val;
    }
}

class RouteParam {
    public string key;
    public string val;
    public string value;

    public constructor(string key, string val) {
        this.key = key;
        this.val = val;
        this.value = val;
    }
}

class HttpStatus {
    static public string getReasonPhrase(int code) {
        switch (code) {
            case 200: {
                return "OK";
            }
            case 201: {
                return "Created";
            }
            case 204: {
                return "No Content";
            }
            case 301: {
                return "Moved Permanently";
            }
            case 302: {
                return "Found";
            }
            case 304: {
                return "Not Modified";
            }
            case 400: {
                return "Bad Request";
            }
            case 401: {
                return "Unauthorized";
            }
            case 403: {
                return "Forbidden";
            }
            case 404: {
                return "Not Found";
            }
            case 405: {
                return "Method Not Allowed";
            }
            case 500: {
                return "Internal Server Error";
            }
            default: {
                return "Unknown";
            }
        }
    }
}
