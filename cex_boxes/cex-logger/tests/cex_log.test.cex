// CexLog: Comprehensive Test Suite (C-ext)
// Powered by cex-t (Test, Assertions & Verification)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths)

import fs from "fs";
import "@cext/src/assert.cex";
import "@cext/src/runner.cex";
import "@cex-log/src/log.cex";

int main() {
    println("===============================================================================");
    println("       2-TEK CexLog Test Suite (CexT Test Engine)                              ");
    println("===============================================================================");

    TestSuite* suite = new TestSuite("CexLog Precision & Delay Profiler Tests");
    int mark = 0;

    // Test 1: Stopwatch lifecycle
    Stopwatch* sw = Log::start("Unit Workload");
    Assert::equalsString(sw->label, "Unit Workload", "Stopwatch label initialized");
    Assert::isTrue(sw->isRunning, "Stopwatch is running initially");
    Assert::isTrue(sw->startTimeNs > 0, "Start time is positive");

    int64 sum = 0;
    for (int i = 0; i < 5000; i++) {
        sum = sum + i;
    }

    double elapsed = sw->stop();
    Assert::isTrue(!sw->isRunning, "Stopwatch is stopped");
    Assert::isTrue(sw->endTimeNs >= sw->startTimeNs, "End time >= start time");
    Assert::isTrue(elapsed >= 0.0, "Elapsed ms is non-negative");
    Assert::isTrue(sw->elapsedNs() >= 0, "Elapsed ns is non-negative");

    string formatted = sw->format();
    Assert::isTrue(formatted.length() > 0, "Stopwatch formatted output is not empty");
    suite->addResult("test_stopwatch_lifecycle", Assert::getFailures() == mark, "assertions failed - see [FAIL] lines above", 1);
    mark = Assert::getFailures();

    // Test 2: Delay formatting
    string f1 = Log::formatDelay(0.0005);
    Assert::isTrue(f1.find("ns") != -1, "Sub-microsecond formatted as ns");

    string f2 = Log::formatDelay(0.5);
    Assert::isTrue(f2.find("µs") != -1, "Sub-millisecond formatted as µs");

    string f3 = Log::formatDelay(150.0);
    Assert::isTrue(f3.find("ms") != -1, "Millisecond formatted as ms");

    string f4 = Log::formatDelay(2500.0);
    Assert::isTrue(f4.find("s") != -1, "Multi-second formatted as s");
    suite->addResult("test_delay_formatting", Assert::getFailures() == mark, "assertions failed - see [FAIL] lines above", 1);
    mark = Assert::getFailures();

    // Test 3: Clocks
    int64 t1 = Log::nowNs();
    double t2 = Log::nowMs();
    Assert::isTrue(t1 > 0, "nowNs returns valid positive nanoseconds");
    Assert::isTrue(t2 > 0.0, "nowMs returns valid positive milliseconds");
    suite->addResult("test_now_clocks", Assert::getFailures() == mark, "assertions failed - see [FAIL] lines above", 1);
    mark = Assert::getFailures();

    println("\n");
    TestReporter::printSummary(suite);
    int failures = Assert::getFailures();
    if (failures > 0) {
        return 1;
    }
    return suite->failCount() > 0 ? 1 : 0;
}
