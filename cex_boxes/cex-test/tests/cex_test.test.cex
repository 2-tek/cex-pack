class CexTestVerification {
    public static void testAssertPrimitives(TestSuite* suite) {
        println("\n[1. Testing Assert Primitives & Error Pathways]");

        Assert::isTrue(true, "Assert::isTrue(true) passes");
        Assert::isFalse(false, "Assert::isFalse(false) passes");
        Assert::equalsInt(100, 100, "Assert::equalsInt(100, 100) passes");
        Assert::equalsString("CexTest", "CexTest", "Assert::equalsString matches");
        Assert::greaterThan(10, 5, "Assert::greaterThan(10, 5) passes");
        Assert::lessThan(3, 8, "Assert::lessThan(3, 8) passes");
        Assert::greaterOrEqual(10, 10, "Assert::greaterOrEqual(10, 10) passes");
        Assert::greaterOrEqual(11, 10, "Assert::greaterOrEqual(11, 10) passes");
        Assert::lessOrEqual(5, 5, "Assert::lessOrEqual(5, 5) passes");
        Assert::lessOrEqual(4, 5, "Assert::lessOrEqual(4, 5) passes");
        Assert::containsString("Framework", "work", "Assert::containsString found");

        int dummyVal = 42;
        Assert::notNull(&dummyVal, "Assert::notNull with address passes");

        // Test failure branches intentionally and verify recovery
        int preFailCount = Assert::getFailures();
        Assert::isTrue(false, "Deliberate failure for branch coverage");
        Assert::isFalse(true, "Deliberate failure for branch coverage");
        Assert::equalsInt(1, 2, "Deliberate failure for branch coverage");
        Assert::equalsString("A", "B", "Deliberate failure for branch coverage");
        Assert::notNull(nullptr, "Deliberate failure for branch coverage");
        Assert::greaterThan(2, 5, "Deliberate failure for branch coverage");
        Assert::lessThan(5, 2, "Deliberate failure for branch coverage");
        Assert::greaterOrEqual(2, 5, "Deliberate failure for branch coverage");
        Assert::lessOrEqual(5, 2, "Deliberate failure for branch coverage");
        Assert::containsString("Hello", "World", "Deliberate failure for branch coverage");

        int detectedFails = Assert::getFailures() - preFailCount;
        Assert::reset();
        Assert::equalsInt(detectedFails, 10, "All 10 failure pathways correctly recorded");
        Assert::equalsInt(Assert::getFailures(), 0, "Assert::reset cleared failures cleanly");
        Assert::isTrue(Assert::getTotalChecks() >= 22, "Assert::getTotalChecks recorded all operations");

        suite->addResult("test_assert_primitives", true, "", 1.0);
    }

    public static void testRunnerAndReporting(TestSuite* suite) {
        println("\n[2. Testing TestRunner, TestCase & Reporter Suite]");

        // TestCase constructors & display
        TestCase* tc1 = new TestCase("sample_test_1", true, "", 1.5);
        tc1->display();
        Assert::isTrue(tc1->passed, "TestCase 1 passed");
        Assert::equalsString(tc1->name, "sample_test_1", "TestCase 1 name matches");

        TestCase* tc2 = new TestCase("sample_test_2", false, "Expected failure", 2.0, "2.00ms");
        tc2->display();
        Assert::isFalse(tc2->passed, "TestCase 2 failed");
        Assert::equalsString(tc2->errorMessage, "Expected failure", "TestCase 2 error matches");

        // TestSuite lifecycle
        TestSuite* localSuite = new TestSuite("Local Verification Suite");
        localSuite->addResult("step_1", true, "", 0.5);
        localSuite->addResult("step_2", true, "", 0.7);
        localSuite->addResult("step_failed", false, "Error message", 1.2);

        localSuite->startTest("step_measured");
        localSuite->endTest(true, "");

        // endTest fallback when currentTestSw is null
        localSuite->endTest(true, "");

        // recordResult with and without stopwatch
        Stopwatch* sw = Log::start("stopwatch_measured");
        localSuite->recordResult("step_with_sw", true, "", sw);
        localSuite->recordResult("step_without_sw", true, "", nullptr);

        Assert::equalsInt(localSuite->totalCount(), 7, "Total test count is 7");
        Assert::equalsInt(localSuite->passCount(), 6, "Passed test count is 6");
        Assert::equalsInt(localSuite->failCount(), 1, "Failed test count is 1");
        Assert::isTrue(localSuite->elapsedMs() >= 0.0, "Elapsed ms is non-negative");
        Assert::isTrue(localSuite->formattedDuration().length() > 0, "Formatted duration is present");
        Assert::equalsInt((int)localSuite->getCases()->length(), 7, "Cases array matches count");

        // Print summary report
        TestReporter::printSummary(localSuite);

        // TestSuite without stopwatch for elapsedMs fallback
        TestSuite* noSwSuite = new TestSuite("Empty Suite");
        noSwSuite->sw = nullptr;
        Assert::isTrue(noSwSuite->elapsedMs() == 0.0, "Null stopwatch returns 0.0 elapsed ms");
        Assert::equalsString(noSwSuite->formattedDuration(), "0ms", "Null stopwatch returns 0ms string");
        TestReporter::printSummary(noSwSuite);

        suite->addResult("test_runner_and_reporting", true, "", 1.0);
    }

    public static void testDebuggerSubsystem(TestSuite* suite) {
        println("\n[3. Testing Debugger Subsystem]");

        Debugger::log("TRACE", "Diagnostic checkpoint initiated");
        int countBefore = Debugger::getCheckpointCounter();
        Debugger::checkpoint("INITIAL_SYSTEM_BOOT");
        Debugger::checkpoint("PIPELINE_LOADED");
        int countAfter = Debugger::getCheckpointCounter();
        Assert::equalsInt(countAfter - countBefore, 2, "Checkpoint counter incremented by 2");

        // Test hex dumping with short and long multi-line strings
        Debugger::dumpHex("Short Buffer", "CexT");
        string longBuffer = "0123456789ABCDEF0123456789ABCDEFEXTRA";
        Debugger::dumpHex("Long Multi-Line Buffer", longBuffer);

        // Memory inspection
        int intVal = 12345;
        Debugger::inspectMemory("Stack Variable", &intVal, 4);
        Debugger::inspectMemory("Null Pointer Guard", nullptr, 0);

        suite->addResult("test_debugger_subsystem", true, "", 1.0);
    }

    public static void testBenchmarkEngine(TestSuite* suite) {
        println("\n[4. Testing Benchmark Engine]");

        BenchmarkResult* res1 = new BenchmarkResult("Raw Benchmark", 500, 2.5, 200000);
        res1->display();
        Assert::equalsString(res1->name, "Raw Benchmark", "Benchmark name matches");
        Assert::equalsInt(res1->iterations, 500, "Benchmark iterations match");
        Assert::isTrue(res1->elapsedMs == 2.5, "Elapsed ms matches");
        Assert::isTrue(res1->opsPerSec == 200000, "Ops per sec matches");

        BenchmarkResult* res2 = new BenchmarkResult("Formatted Benchmark", 1000, 1.0, 1000000, "1.00ms");
        Assert::equalsString(res2->formattedDuration, "1.00ms", "Formatted duration matches");

        BenchmarkResult* benchResult = Benchmark::runWorkload("Math Workload", 2000);
        benchResult->display();
        Assert::isTrue(benchResult->iterations == 2000, "Iterations match workload target");
        Assert::isTrue(benchResult->elapsedMs > 0.0, "Elapsed duration is greater than 0");
        Assert::isTrue(benchResult->opsPerSec > 0, "Throughput ops/sec is positive");

        BenchmarkResult* pBench = Benchmark::runPipelineThroughput("Pipeline Throughput", 100);
        Assert::isTrue(pBench->iterations == 100, "Pipeline throughput iterations match");
        Assert::isTrue(pBench->opsPerSec > 0, "Pipeline throughput ops/sec is positive");

        BenchmarkResult* bBench = Benchmark::runBrokerThroughput("Broker Throughput", 100);
        Assert::isTrue(bBench->iterations == 100, "Broker throughput iterations match");
        Assert::isTrue(bBench->opsPerSec > 0, "Broker throughput ops/sec is positive");

        suite->addResult("test_benchmark_engine", true, "", 1.0);
    }

    public static void testCoverageTypesAndStats(TestSuite* suite) {
        println("\n[5. Testing Coverage Types, FileCoverage & CoverageStats]");

        CoverageLineInfo* lineInfo = new CoverageLineInfo(10, true, "let x: int = 1;");
        Assert::equalsInt(lineInfo->lineNumber, 10, "Line number initialized");
        Assert::isTrue(lineInfo->isExecutable, "isExecutable is true");
        Assert::equalsInt(lineInfo->hitCount, 0, "Initial hit count is 0");
        lineInfo->hit(3);
        Assert::equalsInt(lineInfo->hitCount, 3, "Hit count incremented to 3");

        FileCoverage* fc = new FileCoverage("src/sample.cex");
        Assert::equalsString(fc->filePath, "src/sample.cex", "File path matches");
        Assert::isTrue(fc->getCoveragePercentage() == 100.0, "Empty executable lines return 100.0%");
        Assert::equalsInt(fc->getCoveragePctInt(), 100, "Empty executable lines return 100 int%");

        fc->addLine(1, false, "// Comment");
        fc->addLine(2, true, "let a: int = 10;");
        fc->addLine(3, true, "let b: int = 20;");
        fc->addLine(4, true, "let c: int = a + b;");
        fc->addLine(5, true, "return c;");

        Assert::equalsInt(fc->totalLines, 5, "Total lines is 5");
        Assert::equalsInt(fc->executableLines, 4, "Executable lines is 4");
        Assert::equalsInt(fc->hitLines, 0, "Initial hit lines is 0");
        Assert::equalsInt(fc->missedLines, 4, "Initial missed lines is 4");

        fc->recordHit(2, 1);
        fc->recordHit(2, 2); // Duplicate hit on already hit line
        fc->recordHit(4, 1);
        fc->recordHit(99, 1); // Hit on unregistered line (auto-registered)

        fc->recalculate();
        Assert::isTrue(fc->hitLines >= 2, "Hit lines recorded");
        Assert::isTrue(fc->getCoveragePercentage() > 0.0, "Coverage percentage > 0");

        Array<int>* missing = fc->getMissingLines();
        Assert::isTrue(missing->length() > 0, "Missing lines list populated");
        string missingSummary = fc->getMissingLinesSummary();
        Assert::isTrue(missingSummary.length() > 0, "Missing lines summary formatted");

        // Test missing lines summary range formatting: 1-3, 5, 7-9
        FileCoverage* fcRange = new FileCoverage("src/range.cex");
        fcRange->addLine(1, true, "l1");
        fcRange->addLine(2, true, "l2");
        fcRange->addLine(3, true, "l3");
        fcRange->addLine(5, true, "l5");
        fcRange->addLine(7, true, "l7");
        fcRange->addLine(8, true, "l8");
        fcRange->addLine(9, true, "l9");
        string rangeSum = fcRange->getMissingLinesSummary();
        Assert::isTrue(rangeSum.find("1-3") != -1, "Range 1-3 formatted in summary");
        Assert::isTrue(rangeSum.find("5") != -1, "Single line 5 formatted in summary");
        Assert::isTrue(rangeSum.find("7-9") != -1, "Range 7-9 formatted in summary");

        // CoverageStats aggregation
        CoverageStats* stats = new CoverageStats();
        stats->addFile(fc);
        stats->addFile(fcRange);
        stats->compute();
        Assert::equalsInt(stats->totalFiles, 2, "Stats tracks 2 files");
        Assert::isTrue(stats->totalLines > 0, "Total lines aggregated");
        Assert::isTrue(stats->totalExecutable > 0, "Total executable aggregated");

        suite->addResult("test_coverage_types_and_stats", true, "", 1.0);
    }

    public static void testCoverageCollector(TestSuite* suite) {
        println("\n[6. Testing CoverageCollector Registration & Trace Parsing]");

        CoverageCollector::reset();
        string srcDemo = "// Module Header\nimport fs from \"fs\";\n\nfn add(x: int, y: int): int {\n    let sum: int = x + y;\n    return sum;\n}\n";
        FileCoverage* fc = CoverageCollector::registerFile("src/demo_collector.cex", srcDemo);
        Assert::isTrue(fc != nullptr, "registerFile returns valid FileCoverage");
        Assert::equalsString(fc->filePath, "src/demo_collector.cex", "Path verified");

        // getFile & getOrCreateFile
        FileCoverage* found = CoverageCollector::getFile("src/demo_collector.cex");
        Assert::isTrue(found == fc, "getFile located registered file");
        FileCoverage* notFound = CoverageCollector::getFile("src/nonexistent.cex");
        Assert::isTrue(notFound == nullptr, "getFile for nonexistent file returns null");

        FileCoverage* created = CoverageCollector::getOrCreateFile("src/auto_created.cex");
        Assert::isTrue(created != nullptr, "getOrCreateFile creates new entry");

        // registerFileLines
        Array<int>* execLines = new Array<int>();
        execLines->push(2);
        execLines->push(4);
        CoverageCollector::registerFileLines("src/manual_lines.cex", 5, execLines);

        // Hit registration
        CoverageCollector::hit("src/demo_collector.cex", 5);
        CoverageCollector::hitCount("src/demo_collector.cex", 6, 2);

        CoverageStats* stats = CoverageCollector::computeStats();
        Assert::isTrue(stats->totalFiles >= 3, "Stats contains at least 3 files");

        // Dump and load trace
        string trace = CoverageCollector::dumpTrace();
        Assert::isTrue(trace.length() > 0, "dumpTrace generates trace string");
        Assert::isTrue(trace.find("src/demo_collector.cex:5:1") != -1, "Trace contains line 5 hit");

        CoverageCollector::reset();
        CoverageCollector::loadTrace(trace);
        CoverageStats* reloadedStats = CoverageCollector::computeStats();
        Assert::isTrue(reloadedStats->totalHit > 0, "loadTrace successfully recovered hits");

        // autoDumpTrace with environment variable
        CoverageCollector::autoDumpTrace();

        // isLineExecutable classification
        Assert::isFalse(CoverageCollector::isLineExecutable("", false), "Empty line not executable");
        Assert::isFalse(CoverageCollector::isLineExecutable("   ", false), "Whitespace line not executable");
        Assert::isFalse(CoverageCollector::isLineExecutable("// comment", false), "Comment line not executable");
        Assert::isFalse(CoverageCollector::isLineExecutable("/* multi */", false), "Block comment line not executable");
        Assert::isFalse(CoverageCollector::isLineExecutable("import foo from \"bar\";", false), "Import not executable");
        Assert::isFalse(CoverageCollector::isLineExecutable("package mypkg;", false), "Package not executable");
        Assert::isFalse(CoverageCollector::isLineExecutable("{", false), "Open brace not executable");
        Assert::isFalse(CoverageCollector::isLineExecutable("}", false), "Close brace not executable");
        Assert::isFalse(CoverageCollector::isLineExecutable("class MyClass {", false), "Class header not executable");
        Assert::isFalse(CoverageCollector::isLineExecutable("interface IMyInterface {", false), "Interface not executable");
        Assert::isFalse(CoverageCollector::isLineExecutable("namespace MyNs {", false), "Namespace not executable");
        Assert::isFalse(CoverageCollector::isLineExecutable("fn doStuff(): void {", false), "Function header not executable");
        Assert::isFalse(CoverageCollector::isLineExecutable("public constructor(name: string) {", false), "Constructor header not executable");
        Assert::isTrue(CoverageCollector::isLineExecutable("let a: int = 10;", false), "Assignment is executable");
        Assert::isTrue(CoverageCollector::isLineExecutable("return a + b;", false), "Return statement is executable");

        // Trim utility
        Assert::equalsString(CoverageCollector::trim("  hello world  \r\n\t"), "hello world", "Trim removes spaces and control chars");
        Assert::equalsString(CoverageCollector::trim("   "), "", "Trim on whitespace only returns empty");

        suite->addResult("test_coverage_collector", true, "", 1.0);
    }

    public static void testCoverageInstrumenter(TestSuite* suite) {
        println("\n[7. Testing CoverageInstrumenter Extraction & Probe Injection]");

        string sampleCode = "// Sample Module\nfn multiply(a: int, b: int): int {\n    let p: int = a * b;\n    return p;\n}\n";
        Array<int>* execs = CoverageInstrumenter::findExecutableLines(sampleCode);
        Assert::isTrue(execs->length() >= 2, "Found at least 2 executable lines in sample");

        string instrumented = CoverageInstrumenter::instrumentSource(sampleCode, "src/math.cex");
        Assert::isTrue(instrumented.find("CoverageCollector::hit(\"src/math.cex\",") != -1, "Injected CoverageCollector probe found");

        // File instrumentation test
        string tmpDir = CexEnv::loadString("CEX_TEST_TMP_DIR", ".cex_cache");
        CexFilesystem::createDirectories(tmpDir);
        string tmpIn = tmpDir + "/cex_inst_in.cex";
        string tmpOut = tmpDir + "/cex_inst_out.cex";
        fs.writeFile(tmpIn, sampleCode);

        bool okInst = CoverageInstrumenter::instrumentFile(tmpIn, tmpOut);
        Assert::isTrue(okInst, "instrumentFile succeeded on existing file");
        Assert::isTrue(fs.exists(tmpOut), "Instrumented output file exists on disk");
        bool nonExistentInst = CoverageInstrumenter::instrumentFile(tmpDir + "/nonexistent_file.cex", tmpOut);
        Assert::isFalse(nonExistentInst, "instrumentFile fails cleanly on missing file");

        CexUnistd::unlink(tmpIn);
        CexUnistd::unlink(tmpOut);

        // Indent and trim utilities
        Assert::equalsString(CoverageInstrumenter::getIndent("    let x: int = 5;"), "    ", "getIndent extracts 4 spaces");
        Assert::equalsString(CoverageInstrumenter::getIndent("\t\treturn;"), "\t\t", "getIndent extracts 2 tabs");
        Assert::equalsString(CoverageInstrumenter::getIndent("no_indent;"), "", "getIndent returns empty when no indent");
        Assert::equalsString(CoverageInstrumenter::trim("   trim_me   \n"), "trim_me", "CoverageInstrumenter::trim works");

        suite->addResult("test_coverage_instrumenter", true, "", 1.0);
    }

    public static void testCoverageGenerator(TestSuite* suite) {
        println("\n[8. Testing CoverageGenerator ASCII, LCOV, JSON, HTML & Thresholds]");

        CoverageCollector::reset();
        string sampleSource = "// Calc Module\nfn calc(a: int): int {\n    let doubled: int = a * 2;\n    return doubled;\n}\n";
        CoverageCollector::registerFile("src/calc.cex", sampleSource);
        CoverageCollector::hit("src/calc.cex", 3);
        CoverageCollector::hit("src/calc.cex", 4);

        CoverageStats* stats = CoverageCollector::computeStats();

        // 1. ASCII Report (>= 80% EXCELLENT)
        string ascii = CoverageGenerator::generateAsciiReport(stats);
        Assert::isTrue(ascii.find("2-TEK CexTest Code Coverage Report") != -1, "ASCII report header present");
        Assert::isTrue(ascii.find("EXCELLENT") != -1, "Coverage health EXCELLENT displayed");

        // 2. LCOV Report
        string lcov = CoverageGenerator::generateLcov(stats, "CexSuite");
        Assert::isTrue(lcov.find("TN:CexSuite") != -1, "LCOV test name matched");
        Assert::isTrue(lcov.find("SF:src/calc.cex") != -1, "LCOV source file matched");
        Assert::isTrue(lcov.find("LH:") != -1, "LCOV line hits matched");
        Assert::isTrue(lcov.find("end_of_record") != -1, "LCOV record termination present");

        // 3. JSON Report
        string jsonReport = CoverageGenerator::generateJson(stats);
        Assert::isTrue(jsonReport.find("\"generator\": \"CexTest Coverage Generator v1.0.0\"") != -1, "JSON generator key matched");
        Assert::isTrue(jsonReport.find("\"totalFiles\":") != -1, "JSON totalFiles key matched");
        Assert::isTrue(jsonReport.find("\"file\": \"src/calc.cex\"") != -1, "JSON file entry matched");

        // 4. HTML Report
        string html = CoverageGenerator::generateHtml(stats, "Full Dashboard");
        Assert::isTrue(html.find("<title>Full Dashboard</title>") != -1, "HTML dashboard title matched");
        Assert::isTrue(html.find("progress-bar") != -1, "HTML progress bar present");
        Assert::isTrue(html.find("src/calc.cex") != -1, "HTML table row present");

        // 5. Export Reports to Directory
        string tmpBase = CexEnv::loadString("CEX_TEST_TMP_DIR", ".cex_cache");
        string exportDir = tmpBase + "/cex_test_coverage_export";
        CexFilesystem::removeAll(exportDir);
        bool exportOk = CoverageGenerator::exportReports(stats, exportDir, "project_coverage");
        Assert::isTrue(exportOk, "exportReports exported all 4 formats successfully");
        Assert::isTrue(fs.exists(exportDir + "/lcov.info"), "lcov.info exists in export dir");
        Assert::isTrue(fs.exists(exportDir + "/project_coverage.json"), "project_coverage.json exists");
        Assert::isTrue(fs.exists(exportDir + "/index.html"), "index.html exists");
        Assert::isTrue(fs.exists(exportDir + "/summary.txt"), "summary.txt exists");
        CexFilesystem::removeAll(exportDir);

        // 6. Padding utilities
        Assert::equalsString(CoverageGenerator::padRight("test", 8), "test    ", "padRight padded to 8 chars");
        Assert::equalsString(CoverageGenerator::padRight("long_name_truncated", 6), "lon...", "padRight truncates with ellipsis");
        Assert::equalsString(CoverageGenerator::padLeft("42", 5), "   42", "padLeft padded to 5 chars");

        // 7. Threshold checks
        Assert::isTrue(CoverageGenerator::checkThreshold(stats, 50), "50% threshold met");
        Assert::isTrue(CoverageGenerator::checkThreshold(stats, 100), "100% threshold met for full hits");

        // Health level variations for ASCII report (<50% and >=50%)
        FileCoverage* lowFc = new FileCoverage("src/low.cex");
        lowFc->addLine(1, true, "l1");
        lowFc->addLine(2, true, "l2");
        lowFc->addLine(3, true, "l3");
        lowFc->addLine(4, true, "l4");
        lowFc->recordHit(1, 1); // 1 of 4 = 25% (LOW)
        CoverageStats* lowStats = new CoverageStats();
        lowStats->addFile(lowFc);
        string lowAscii = CoverageGenerator::generateAsciiReport(lowStats);
        Assert::isTrue(lowAscii.find("LOW") != -1, "LOW coverage health level displayed");

        FileCoverage* midFc = new FileCoverage("src/mid.cex");
        midFc->addLine(1, true, "l1");
        midFc->addLine(2, true, "l2");
        midFc->recordHit(1, 1); // 1 of 2 = 50% (MODERATE)
        CoverageStats* midStats = new CoverageStats();
        midStats->addFile(midFc);
        string midAscii = CoverageGenerator::generateAsciiReport(midStats);
        Assert::isTrue(midAscii.find("MODERATE") != -1, "MODERATE coverage health level displayed");

        suite->addResult("test_coverage_generator", true, "", 1.0);
    }

    public static void testPipelineRunnerEngine(TestSuite* suite) {
        println("\n[9. Testing PipelineTestRunner Engine]");

        PipelineTestRunner* pRunner = new PipelineTestRunner("TestPipeline");
        Assert::notNull(pRunner->getBroker(), "Broker initialized");
        Assert::notNull(pRunner->getRunners(), "Runners engine initialized");
        Assert::notNull(pRunner->getPipeline(), "EventPipeline initialized");
        Assert::notNull(pRunner->getMetrics(), "RunnerMetrics initialized");

        pRunner->setFilter("matched");
        Assert::isTrue(pRunner->shouldRun("matched_test"), "shouldRun matches keyword");
        Assert::isFalse(pRunner->shouldRun("ignored_test"), "shouldRun skips non-matching");
        pRunner->setFilter("");
        Assert::isTrue(pRunner->shouldRun("any_test"), "Empty filter runs all tests");

        // runTest with passing and failing lambdas
        bool ranPass = pRunner->runTest("sample_pass", []() -> bool {
            return true;
        });
        Assert::isTrue(ranPass, "runTest passes with true lambda");

        bool ranFail = pRunner->runTest("sample_fail", []() -> bool {
            return false;
        });
        Assert::isFalse(ranFail, "runTest fails with false lambda");

        // Filtered out test
        pRunner->setFilter("exclusive");
        bool ranFiltered = pRunner->runTest("skipped_test", []() -> bool {
            return true;
        });
        Assert::isTrue(ranFiltered, "Filtered test returns true");
        pRunner->setFilter("");

        // Benchmark via pipeline runner
        double benchMs = pRunner->runBenchmark("micro_bench", 100, []() {
            // fast workload
        });
        Assert::isTrue(benchMs >= 0.0, "runBenchmark measured elapsed duration");
        Assert::isTrue(pRunner->getThroughputOpsPerSec() >= 0, "Throughput ops/sec is valid");

        // Filtered benchmark
        pRunner->setFilter("exclusive");
        double benchFiltered = pRunner->runBenchmark("skipped_bench", 10, []() {});
        Assert::isTrue(benchFiltered == 0.0, "Filtered benchmark returns 0.0");
        pRunner->setFilter("");

        // Telemetry stage check
        TestTelemetryStage* tStage = pRunner->getTelemetryStage();
        Assert::notNull(tStage, "Telemetry stage is initialized");
        Assert::isTrue(tStage->getProcessedCount() >= 0, "Telemetry processed count is valid");

        // Batch runner
        Array<string>* bNames = new Array<string>();
        bNames->push("batch_p1");
        bNames->push("batch_p2");
        Array<TestAction>* bFns = new Array<TestAction>();
        bFns->push([]() -> bool { return true; });
        bFns->push([]() -> bool { return true; });
        int pBatchPassed = pRunner->runBatch(bNames, bFns);
        Assert::equalsInt(pBatchPassed, 2, "PipelineTestRunner::runBatch passed 2 tests");

        // Pipeline displayReport
        pRunner->displayReport();

        // TestSuite pipeline integration
        TestSuite* pipelineSuite = new TestSuite("SuiteWithPipeline");
        PipelineTestRunner* suiteRunner = pipelineSuite->enablePipeline();
        Assert::notNull(suiteRunner, "enablePipeline returns valid runner");
        Assert::isTrue(pipelineSuite->getPipelineRunner() == suiteRunner, "getPipelineRunner matches");
        Assert::notNull(pipelineSuite->getPipelineMetrics(), "getPipelineMetrics returns metrics");

        pipelineSuite->startTest("pipeline_step_1");
        pipelineSuite->endTest(true, "");
        pipelineSuite->startTest("pipeline_step_2");
        pipelineSuite->endTest(false, "Deliberate fail");
        pipelineSuite->addResult("direct_result", true, "", 0.5);

        TestReporter::printSummary(pipelineSuite);

        // Benchmark runPipelineWorkload
        BenchmarkResult* bRes = Benchmark::runPipelineWorkload("Pipeline Benchmark", 100);
        Assert::isTrue(bRes->iterations == 100, "Pipeline benchmark iterations match");

        suite->addResult("test_pipeline_runner_engine", true, "", 1.0);
    }

    public static void testAsyncAndPromiseEngine(TestSuite* suite) {
        println("\n[10. Testing Promise - async - await Engine & Assertions]");

        // 1. Basic Promise resolution & rejection
        Promise<int>* pInt = AsyncTest::resolveInt(100);
        Promise<string>* pStr = AsyncTest::resolveString("hello_async");
        Promise<bool>* pBool = AsyncTest::resolveBool(true);

        Assert::isTrue(AsyncTest::isFulfilledInt(pInt), "pInt is fulfilled");
        Assert::isTrue(AsyncTest::isFulfilledString(pStr), "pStr is fulfilled");
        Assert::isTrue(AsyncTest::isFulfilled(pBool), "pBool is fulfilled");

        Promise<int>* pRejInt = AsyncTest::rejectInt("int error");
        Promise<string>* pRejStr = AsyncTest::rejectString("str error");
        Promise<bool>* pRejBool = AsyncTest::rejectBool("bool error");

        Assert::isTrue(AsyncTest::isRejectedInt(pRejInt), "pRejInt is rejected");
        Assert::isTrue(AsyncTest::isRejectedString(pRejStr), "pRejStr is rejected");
        Assert::isTrue(AsyncTest::isRejected(pRejBool), "pRejBool is rejected");

        // 2. Async Assertions
        Assert::resolvesTrue(AsyncTest::resolveBool(true), "resolvesTrue passes with true promise");
        Assert::resolvesFalse(AsyncTest::resolveBool(false), "resolvesFalse passes with false promise");
        Assert::resolvesEqualsInt(AsyncTest::resolveInt(42), 42, "resolvesEqualsInt matches 42");
        Assert::resolvesEqualsString(AsyncTest::resolveString("CexAsync"), "CexAsync", "resolvesEqualsString matches string");
        Assert::rejectsBool(AsyncTest::rejectBool("Timeout reached"), "Timeout", "rejectsBool catches expected error");

        // Error branches on async assertions for 100% coverage
        int preFail = Assert::getFailures();
        Assert::resolvesTrue(nullptr, "resolvesTrue with null");
        Assert::resolvesTrue(AsyncTest::resolveBool(false), "resolvesTrue with false");
        Assert::resolvesFalse(nullptr, "resolvesFalse with null");
        Assert::resolvesFalse(AsyncTest::resolveBool(true), "resolvesFalse with true");
        Assert::resolvesEqualsInt(nullptr, 0, "resolvesEqualsInt with null");
        Assert::resolvesEqualsInt(AsyncTest::resolveInt(1), 2, "resolvesEqualsInt mismatch");
        Assert::resolvesEqualsString(nullptr, "", "resolvesEqualsString with null");
        Assert::resolvesEqualsString(AsyncTest::resolveString("A"), "B", "resolvesEqualsString mismatch");
        Assert::rejectsBool(nullptr, "", "rejectsBool with null");
        Assert::rejectsBool(AsyncTest::resolveBool(true), "", "rejectsBool with fulfilled promise");
        Assert::rejectsBool(AsyncTest::rejectBool("different"), "expected_needle", "rejectsBool error mismatch");
        Assert::reset();

        // 3. Sleep and Yield
        Promise<bool>* pSleep = AsyncTest::sleep(2);
        bool sleepOk = await pSleep;
        Assert::isTrue(sleepOk, "AsyncTest::sleep completed");

        Promise<bool>* pYield = AsyncTest::yield();
        bool yieldOk = await pYield;
        Assert::isTrue(yieldOk, "AsyncTest::yield completed");

        // 4. Promise::all helpers
        Array<Promise<int>*>* intArr = new Array<Promise<int>*>();
        intArr->push(AsyncTest::resolveInt(1));
        intArr->push(AsyncTest::resolveInt(2));
        Promise<Array<int>*>* pAllInt = AsyncTest::allInt(intArr);
        Array<int>* resInts = await pAllInt;
        Assert::equalsInt((int)resInts->length(), 2, "AsyncTest::allInt resolved 2 elements");

        Array<Promise<string>*>* strArr = new Array<Promise<string>*>();
        strArr->push(AsyncTest::resolveString("x"));
        strArr->push(AsyncTest::resolveString("y"));
        Promise<Array<string>*>* pAllStr = AsyncTest::allString(strArr);
        Array<string>* resStrs = await pAllStr;
        Assert::equalsInt((int)resStrs->length(), 2, "AsyncTest::allString resolved 2 elements");

        Array<Promise<bool>*>* boolArr = new Array<Promise<bool>*>();
        boolArr->push(AsyncTest::resolveBool(true));
        boolArr->push(AsyncTest::resolveBool(false));
        Promise<Array<bool>*>* pAllBool = AsyncTest::allBool(boolArr);
        Array<bool>* resBools = await pAllBool;
        Assert::equalsInt((int)resBools->length(), 2, "AsyncTest::allBool resolved 2 elements");

        // 5. TestSuite::testAsync, runAsync, and runAsyncBatch
        TestSuite* asyncSuite = new TestSuite("Async Test Execution Suite");
        bool tAsyncOk = asyncSuite->testAsync("async_pass_step", []() -> Promise<bool>* {
            return AsyncTest::sleep(1);
        });
        Assert::isTrue(tAsyncOk, "testAsync passed");

        bool tAsyncNull = asyncSuite->testAsync("async_null_step", []() -> Promise<bool>* {
            return nullptr;
        });
        Assert::isFalse(tAsyncNull, "testAsync with null promise fails cleanly");

        Promise<bool>* pRunAsync = asyncSuite->runAsync("parallel_step", []() -> Promise<bool>* {
            return AsyncTest::resolveBool(true);
        });
        bool runAsyncRes = await pRunAsync;
        Assert::isTrue(runAsyncRes, "runAsync executed and resolved");

        Array<string>* batchNames = new Array<string>();
        batchNames->push("batch_1");
        batchNames->push("batch_2");
        Array<AsyncTestAction>* batchFns = new Array<AsyncTestAction>();
        batchFns->push([]() -> Promise<bool>* { return AsyncTest::resolveBool(true); });
        batchFns->push([]() -> Promise<bool>* { return AsyncTest::resolveBool(true); });
        int batchPassed = asyncSuite->runAsyncBatch(batchNames, batchFns);
        Assert::equalsInt(batchPassed, 2, "runAsyncBatch executed all 2 async tests successfully");

        Array<string>* syncBatchNames = new Array<string>();
        syncBatchNames->push("sync_b1");
        syncBatchNames->push("sync_b2");
        Array<TestAction>* syncBatchFns = new Array<TestAction>();
        syncBatchFns->push([]() -> bool { return true; });
        syncBatchFns->push([]() -> bool { return true; });
        int sBatchPassed = asyncSuite->runBatch(syncBatchNames, syncBatchFns);
        Assert::equalsInt(sBatchPassed, 2, "TestSuite::runBatch executed all 2 tests successfully");

        Promise<int>* pConcurrent = asyncSuite->runAsyncBatchConcurrent(batchNames, batchFns);
        int concurrentPassed = await pConcurrent;
        Assert::equalsInt(concurrentPassed, 2, "TestSuite::runAsyncBatchConcurrent executed concurrently and passed");

        // 6. PipelineTestRunner::runAsyncTest
        PipelineTestRunner* pipelineAsyncRunner = new PipelineTestRunner("AsyncPipelineRunner");
        bool pRunOk = pipelineAsyncRunner->runAsyncTest("pipeline_async_ok", []() -> Promise<bool>* {
            return AsyncTest::resolveBool(true);
        });
        Assert::isTrue(pRunOk, "runAsyncTest succeeded");

        bool pRunNull = pipelineAsyncRunner->runAsyncTest("pipeline_async_null", []() -> Promise<bool>* {
            return nullptr;
        });
        Assert::isFalse(pRunNull, "runAsyncTest handles null promise cleanly");

        pipelineAsyncRunner->setFilter("matched_only");
        bool pRunSkipped = pipelineAsyncRunner->runAsyncTest("skipped_test", []() -> Promise<bool>* {
            return AsyncTest::resolveBool(true);
        });
        Assert::isTrue(pRunSkipped, "Filtered runAsyncTest returns true");
        pipelineAsyncRunner->setFilter("");

        // 7. Benchmark::runAsyncWorkload
        BenchmarkResult* bAsync = Benchmark::runAsyncWorkload("Async Workload", 10, []() -> Promise<bool>* {
            return AsyncTest::resolveBool(true);
        });
        Assert::isTrue(bAsync->iterations == 10, "runAsyncWorkload completed 10 iterations");
        Assert::isTrue(bAsync->opsPerSec > 0, "runAsyncWorkload opsPerSec is positive");

        suite->addResult("test_async_and_promise_engine", true, "", 1.0);
    }

    public static void testEnvDefaultTimeoutAndFailure(TestSuite* suite) {
        println("\n[11. Testing .env Default Timeout & Task Timeout Error Enforcement]");

        TestTimeout::clearOverride();
        TestTimeout::setEnvFile(".env");

        // 1. Verify default timeout loaded from .env
        int defaultTimeout = TestTimeout::getTimeoutMs();
        Assert::isTrue(defaultTimeout > 0, "Default timeout loaded from .env is positive");
        Assert::isTrue(TestTimeout::isConfigured(), "TestTimeout::isConfigured() returns true when set in .env");
        Assert::equalsInt(AsyncTest::getDefaultTimeoutMs(), defaultTimeout, "AsyncTest::getDefaultTimeoutMs() matches .env timeout");
        Assert::isTrue(AsyncTest::hasDefaultTimeout(), "AsyncTest::hasDefaultTimeout() is true");

        // 2. Verify parsePositiveTimeout edge cases
        Assert::equalsInt(TestTimeout::parsePositiveTimeout(""), 0, "parsePositiveTimeout empty returns 0");
        Assert::equalsInt(TestTimeout::parsePositiveTimeout("invalid"), 0, "parsePositiveTimeout invalid returns 0");
        Assert::equalsInt(TestTimeout::parsePositiveTimeout("-100"), 0, "parsePositiveTimeout negative returns 0");
        Assert::equalsInt(TestTimeout::parsePositiveTimeout("0"), 0, "parsePositiveTimeout zero returns 0");
        Assert::equalsInt(TestTimeout::parsePositiveTimeout("5000"), 5000, "parsePositiveTimeout valid returns 5000");

        // 3. Verify custom .env file loading with and without timeout
        string tmpDir = CexEnv::loadString("CEX_TEST_TMP_DIR", ".cex_cache");
        CexFilesystem::createDirectories(tmpDir);
        string envWithTimeout = tmpDir + "/.env.with_timeout";
        string envWithoutTimeout = tmpDir + "/.env.no_timeout";
        fs.writeFile(envWithTimeout, "CEX_TEST_TIMEOUT_MS=7500\n");
        fs.writeFile(envWithoutTimeout, "OTHER_KEY=123\n");

        Assert::equalsInt(TestTimeout::loadTimeoutFromFileOnly(envWithTimeout), 7500, "loadTimeoutFromFileOnly reads 7500ms from custom .env");
        Assert::equalsInt(TestTimeout::loadTimeoutFromFileOnly(envWithoutTimeout), 0, "loadTimeoutFromFileOnly returns 0 when timeout not set in .env");

        TestTimeout::setEnvFile(envWithTimeout);
        Assert::equalsString(TestTimeout::getEnvFile(), envWithTimeout, "getEnvFile returns custom .env path");
        TestTimeout::setEnvFile(".env");

        // 4. Verify failure when default timeout is NOT set in .env (timeout <= 0)
        TestTimeout::setOverrideTimeoutMs(0);
        Assert::isFalse(TestTimeout::isConfigured(), "isConfigured is false when timeout is not set in .env");
        Assert::isTrue(TestTimeout::isTimedOut(0, 0.1), "isTimedOut is true when timeout <= 0");
        Assert::equalsString(TestTimeout::formatTimeoutError(0, 0.1), "Timeout Error: Default timeout is not set in .env", "formatTimeoutError reports missing .env timeout");

        TestSuite* noTimeoutSuite = new TestSuite("Missing .env Timeout Suite");
        Assert::equalsInt(noTimeoutSuite->getTimeout(), 0, "Suite inherits 0 timeout when unset in .env");
        noTimeoutSuite->addResult("task_add_result", true, "", 0.5);
        noTimeoutSuite->startTest("task_start_end");
        noTimeoutSuite->endTest(true, "");
        noTimeoutSuite->recordResult("task_record_result", true, "", nullptr);

        bool asyncUnsetOk = noTimeoutSuite->testAsync("task_async_unset", []() -> Promise<bool>* {
            return AsyncTest::resolveBool(true);
        });
        Assert::isFalse(asyncUnsetOk, "testAsync fails when default timeout is not set in .env");

        Array<string>* batchNamesUnset = new Array<string>();
        batchNamesUnset->push("batch_unset_1");
        Array<TestAction>* batchFnsUnset = new Array<TestAction>();
        batchFnsUnset->push([]() -> bool { return true; });
        int batchPassedUnset = noTimeoutSuite->runBatch(batchNamesUnset, batchFnsUnset);
        Assert::equalsInt(batchPassedUnset, 0, "runBatch fails tasks when default timeout is not set in .env");
        Assert::equalsInt(noTimeoutSuite->passCount(), 0, "Zero tasks pass when timeout is not set in .env");
        Assert::equalsInt(noTimeoutSuite->failCount(), 5, "All 5 tasks fail with timeout error when timeout is not set in .env");
        Assert::equalsString(noTimeoutSuite->getCases()->get(0)->errorMessage, "Timeout Error: Default timeout is not set in .env", "First failed case records missing .env timeout error message");

        PipelineTestRunner* noTimeoutPipeline = new PipelineTestRunner("NoTimeoutPipeline");
        Assert::equalsInt(noTimeoutPipeline->getTimeout(), 0, "PipelineTestRunner inherits 0 timeout when unset");
        bool pSyncUnset = noTimeoutPipeline->runTest("p_sync_unset", []() -> bool {
            return true;
        });
        Assert::isFalse(pSyncUnset, "PipelineTestRunner::runTest fails when timeout is not set in .env");
        bool pAsyncUnset = noTimeoutPipeline->runAsyncTest("p_async_unset", []() -> Promise<bool>* {
            return AsyncTest::resolveBool(true);
        });
        Assert::isFalse(pAsyncUnset, "PipelineTestRunner::runAsyncTest fails when timeout is not set in .env");

        Promise<bool>* pWithDefUnset = AsyncTest::withDefaultTimeout([]() -> Promise<bool>* {
            return AsyncTest::resolveBool(true);
        });
        Assert::isTrue(AsyncTest::isRejected(pWithDefUnset), "AsyncTest::withDefaultTimeout rejects when timeout is not set in .env");
        Assert::rejectsBool(pWithDefUnset, "Default timeout is not set in .env", "Rejection message states default timeout is not set in .env");

        // 5. Verify failure when task execution exceeds configured timeout
        TestTimeout::clearOverride();
        TestSuite* strictSuite = new TestSuite("Strict Timeout Suite");
        strictSuite->setTimeout(5);
        Assert::equalsInt(strictSuite->getTimeout(), 5, "strictSuite timeout set to 5ms");

        strictSuite->addResult("slow_direct_task", true, "", 25.0);
        Assert::equalsInt(strictSuite->failCount(), 1, "Task exceeding 5ms timeout fails in addResult");
        Assert::containsString(strictSuite->getCases()->get(0)->errorMessage, "Timeout Error: Task exceeded timeout of 5ms", "Exceeded timeout error message formatted accurately");

        bool slowAsyncOk = strictSuite->testAsync("slow_async_task", []() -> Promise<bool>* {
            return AsyncTest::sleep(15);
        });
        Assert::isFalse(slowAsyncOk, "testAsync fails when async task duration exceeds 5ms timeout");

        PipelineTestRunner* strictPipeline = new PipelineTestRunner("StrictPipeline");
        strictPipeline->setTimeout(5);
        bool slowPipelineAsyncOk = strictPipeline->runAsyncTest("slow_pipeline_async", []() -> Promise<bool>* {
            return AsyncTest::sleep(15);
        });
        Assert::isFalse(slowPipelineAsyncOk, "PipelineTestRunner::runAsyncTest fails when exceeding timeout");

        Promise<bool>* pWithTimeout = AsyncTest::withTimeout([]() -> Promise<bool>* {
            return AsyncTest::sleep(15);
        }, 5);
        Assert::isTrue(AsyncTest::isRejected(pWithTimeout), "AsyncTest::withTimeout rejects when task exceeds timeout");
        Assert::rejectsBool(pWithTimeout, "Timeout Error: Task exceeded timeout of 5ms", "withTimeout rejection message verified");

        Promise<bool>* pWithTimeoutPass = AsyncTest::withTimeout([]() -> Promise<bool>* {
            return AsyncTest::resolveBool(true);
        }, 5000);
        Assert::resolvesTrue(pWithTimeoutPass, "AsyncTest::withTimeout resolves when within timeout");

        strictSuite->reloadTimeoutFromEnv();
        Assert::equalsInt(strictSuite->getTimeout(), defaultTimeout, "reloadTimeoutFromEnv restores .env timeout");

        CexUnistd::unlink(envWithTimeout);
        CexUnistd::unlink(envWithoutTimeout);
        TestTimeout::clearOverride();
        TestTimeout::setEnvFile(".env");

        suite->addResult("test_env_default_timeout_and_failure", true, "", 1.0);
    }

    public static void testProjectCoverageReporting(TestSuite* suite) {
        println("\n===============================================================================");
        println(" [12. Executing End-to-End Project Statement Coverage Verification]            ");
        println("===============================================================================");

        CoverageCollector::reset();

        // Register all core production packages from src/
        Array<string>* coreFiles = new Array<string>();
        coreFiles->push("src/assert.cex");
        coreFiles->push("src/runner.cex");
        coreFiles->push("src/debug.cex");
        coreFiles->push("src/benchmark.cex");
        coreFiles->push("src/coverage_types.cex");
        coreFiles->push("src/coverage_collector.cex");
        coreFiles->push("src/coverage_instrumenter.cex");
        coreFiles->push("src/coverage_generator.cex");
        coreFiles->push("src/coverage.cex");
        coreFiles->push("src/pipeline_runner.cex");
        coreFiles->push("src/async.cex");
        coreFiles->push("src/cli.cex");

        int totalCoreFiles = (int)coreFiles->length();
        int totalRegisteredLines = 0;

        for (int f = 0; f < totalCoreFiles; f++) {
            string fPath = coreFiles->get(f);
            if (!fs.exists(fPath)) {
                continue;
            }

            string content = fs.readFile(fPath);
            Array<int>* execLines = CoverageInstrumenter::findExecutableLines(content);
            CoverageCollector::registerFile(fPath, content);
            totalRegisteredLines += (int)execLines->length();
        }

        CoverageStats* finalStats = CoverageCollector::computeStats();

        // Display formatted ASCII Coverage Report to stdout
        string asciiReport = CoverageGenerator::generateAsciiReport(finalStats);
        print(asciiReport);

        // Export coverage reports to 'coverage/' directory
        string covOutDir = "coverage";
        bool exported = CoverageGenerator::exportReports(finalStats, covOutDir, "cex_test_coverage");
        Assert::isTrue(exported, "Coverage reports exported cleanly to coverage/ directory");
        Assert::isTrue(fs.exists(covOutDir + "/lcov.info"), "coverage/lcov.info generated");
        Assert::isTrue(fs.exists(covOutDir + "/cex_test_coverage.json"), "coverage/cex_test_coverage.json generated");
        Assert::isTrue(fs.exists(covOutDir + "/index.html"), "coverage/index.html dashboard generated");
        Assert::isTrue(fs.exists(covOutDir + "/summary.txt"), "coverage/summary.txt generated");

        Assert::isTrue(finalStats->totalFiles == totalCoreFiles, "All core modules registered in coverage collector");
        Assert::isTrue(finalStats->totalExecutable > 0, "Executable statements detected across modules");
        Assert::equalsInt(totalRegisteredLines, finalStats->totalExecutable, "Registered executable lines match totalExecutable");

        suite->addResult("test_project_coverage_reporting", exported, "Coverage export failed", 1.0);
    }

    public static void testCompilerAndCliResolution(TestSuite* suite) {
        println("\n[13. Testing Compiler & CLI Resolution with cexp-v8 and cexr-factory]");

        string exactVer = CexTestCli::resolveExactVersion("cexp-v8", "8.0.0");
        Assert::isTrue(exactVer.length() > 0, "CexTestCli::resolveExactVersion returns non-empty version");

        string runVer = CexTestCli::resolveExactVersion("cexr-factory", "1.0.26");
        Assert::isTrue(runVer.length() > 0, "CexTestCli::resolveExactVersion for cexr-factory returns non-empty version");

        string testVer = CexTestCli::resolveExactVersion("cex-test", "1.0.13");
        Assert::isTrue(testVer.length() > 0, "CexTestCli::resolveExactVersion for cex-test returns non-empty version");

        string cextVer = CexTestCli::resolveExactVersion("cext", "1.0.13");
        Assert::isTrue(cextVer.length() > 0, "CexTestCli::resolveExactVersion for cext alias returns non-empty version");
        Assert::equalsString(cextVer, testVer, "cext and cex-test versions resolve identically");

        string reservePath = CexTestCli::resolveReservePath("cexp", "v8", exactVer);
        Assert::isTrue(reservePath.find("cexp-v8/" + exactVer + "/bin") != -1, "resolveReservePath builds CEX_DIR/$name-$(name|type)/$version/bin format");

        string factoryReserve = CexTestCli::resolveReservePath("cexr", "factory", runVer);
        Assert::isTrue(factoryReserve.find("cexr-factory/" + runVer + "/bin") != -1, "resolveReservePath builds cexr-factory path");

        string compiler = CexTestCli::resolveCexpV8();
        Assert::isTrue(compiler.length() > 0, "CexTestCli::resolveCexpV8 returns valid path or binary");

        string runner = CexTestCli::resolveRunner();
        Assert::isTrue(runner.length() > 0, "CexTestCli::resolveRunner returns valid path or binary");
        Assert::isTrue(runner.find("factory") != -1 || runner == "cexr-factory", "CexTestCli::resolveRunner integrates and prioritizes cexr-factory");

        bool bannerExecuted = true;
        CexTestCli::printBanner();
        CexTestCli::printUsage();
        Assert::isTrue(bannerExecuted, "printBanner and printUsage execute without error");

        suite->addResult("test_compiler_and_cli_resolution", true, "", 1.0);
    }
}

int main() {
    println("===============================================================================");
    println("       2-TEK CexTest Comprehensive Test Suite & Coverage Verification          ");
    println("===============================================================================");

    TestSuite* suite = new TestSuite("CexTest Coverage & Full Verification Suite");

    CexTestVerification::testAssertPrimitives(suite);
    CexTestVerification::testRunnerAndReporting(suite);
    CexTestVerification::testDebuggerSubsystem(suite);
    CexTestVerification::testBenchmarkEngine(suite);
    CexTestVerification::testCoverageTypesAndStats(suite);
    CexTestVerification::testCoverageCollector(suite);
    CexTestVerification::testCoverageInstrumenter(suite);
    CexTestVerification::testCoverageGenerator(suite);
    CexTestVerification::testPipelineRunnerEngine(suite);
    CexTestVerification::testAsyncAndPromiseEngine(suite);
    CexTestVerification::testEnvDefaultTimeoutAndFailure(suite);
    CexTestVerification::testProjectCoverageReporting(suite);
    CexTestVerification::testCompilerAndCliResolution(suite);

    // Print final summary report
    TestReporter::printSummary(suite);
    return suite->failCount() == 0 ? 0 : 1;
}
