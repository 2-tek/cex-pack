// CexPack Manifest Validator Engine (C-ext)

import "./types.cex";
import "./parser.cex";
import "./schema.cex";
import "./reporter.cex";
import fs from "fs";

class PackValidator {
    private SchemaValidator* schemaVal = new SchemaValidator();
    private DiagnosticReporter* reporter = new DiagnosticReporter();

    public constructor() {}

    public ValidationResult* validateContent(string manifestContent) {
        // 1. JSON Syntax & Structural Token Parsing
        JsonParser* parser = new JsonParser(manifestContent);
        ValidationResult* result = parser->parseAndValidateSyntax();

        // 2. Schema and Rule 69 Validation
        this.schemaVal->validateManifestSchema(manifestContent, result);

        // 3. Rule 29 EOF Newline Check
        this.schemaVal->validateEofNewline(manifestContent, result);

        // 4. Thunder Quick-Define Build Validation
        this.schemaVal->validateThunderRule(manifestContent, result);

        // 5. Environment Options & Process.Env Syntax Validation
        this.schemaVal->validateEnvsRule(manifestContent, result);
        this.schemaVal->validateProcessEnvRule(manifestContent, result);

        // 6. CVM Repository & Manifest Path Rule Validation
        this.schemaVal->validateCvmRepositoryRule(manifestContent, result);

        return result;
    }

    public bool validateFile(string filepath) {
        if (!fs.exists(filepath)) {
            ValidationResult* emptyRes = new ValidationResult();
            emptyRes->addError("FILE_NOT_FOUND", "Could not read file or file is empty: " + filepath, 1, 1);
            this.reporter->printResult(filepath, emptyRes);
            return false;
        }

        string content = fs.readFile(filepath);
        if (content.length() == 0) {
            ValidationResult* emptyRes = new ValidationResult();
            emptyRes->addError("FILE_NOT_FOUND", "Could not read file or file is empty: " + filepath, 1, 1);
            this.reporter->printResult(filepath, emptyRes);
            return false;
        }

        ValidationResult* result = this.validateContent(content);
        this.reporter->printResult(filepath, result);
        return result->isValid;
    }
}
