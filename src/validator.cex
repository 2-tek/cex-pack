// CexPack Manifest Validator Engine (C-ext)

import "./types.cex";
import "./parser.cex";
import "./schema.cex";
import "./reporter.cex";
import fs from "fs";

class PackValidator {
    private schemaVal: SchemaValidator*;
    private reporter: DiagnosticReporter*;

    public constructor() {
        this.schemaVal = new SchemaValidator();
        this.reporter = new DiagnosticReporter();
    }

    public validateContent(manifestContent: string): ValidationResult* {
        // 1. JSON Syntax & Structural Token Parsing
        let parser: JsonParser* = new JsonParser(manifestContent);
        let result: ValidationResult* = parser->parseAndValidateSyntax();

        // 2. Schema and Rule 69 Validation
        this.schemaVal->validateManifestSchema(manifestContent, result);

        // 3. Rule 29 EOF Newline Check
        this.schemaVal->validateEofNewline(manifestContent, result);

        // 4. Thunder Quick-Define Build Validation
        this.schemaVal->validateThunderRule(manifestContent, result);

        return result;
    }

    public validateFile(filepath: string): bool {
        if (!fs.exists(filepath)) {
            let emptyRes: ValidationResult* = new ValidationResult();
            emptyRes->addError("FILE_NOT_FOUND", "Could not read file or file is empty: " + filepath, 1, 1);
            this.reporter->printResult(filepath, emptyRes);
            return false;
        }

        let content: string = fs.readFile(filepath);
        if (content.length() == 0) {
            let emptyRes: ValidationResult* = new ValidationResult();
            emptyRes->addError("FILE_NOT_FOUND", "Could not read file or file is empty: " + filepath, 1, 1);
            this.reporter->printResult(filepath, emptyRes);
            return false;
        }

        let result: ValidationResult* = this.validateContent(content);
        this.reporter->printResult(filepath, result);
        return result->isValid;
    }
}
