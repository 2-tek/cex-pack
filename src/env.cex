// CexPack Environment Loader and Process.Env Manager (C-ext)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths)

import "./types.cex";
import fs from "fs";
import "cpp.string";

class EnvParser {
    static public string trim(string s) {
        string res = s;
        while (res.length() > 0 && (res.substr(0, 1) == " " || res.substr(0, 1) == "\t" || res.substr(0, 1) == "\r" || res.substr(0, 1) == "\n")) {
            res = res.substr(1, res.length() - 1);
        }
        while (res.length() > 0 && (res.substr(res.length() - 1, 1) == " " || res.substr(res.length() - 1, 1) == "\t" || res.substr(res.length() - 1, 1) == "\r" || res.substr(res.length() - 1, 1) == "\n")) {
            res = res.substr(0, res.length() - 1);
        }
        return res;
    }

    static public bool parseLine(string line, string& outKey, string& outVal) {
        string l = EnvParser::trim(line);
        if (l.empty() || l.substr(0, 1) == "#") {
            return false;
        }

        if (l.length() >= 7 && l.substr(0, 7) == "export ") {
            l = EnvParser::trim(l.substr(7));
        }

        int eqPos = (int)l.find("=");
        if (eqPos == -1) {
            return false;
        }

        string k = EnvParser::trim(l.substr(0, eqPos));
        if (k.empty()) {
            return false;
        }

        string rawVal = l.substr(eqPos + 1);
        while (rawVal.length() > 0 && (rawVal.substr(0, 1) == " " || rawVal.substr(0, 1) == "\t")) {
            rawVal = rawVal.substr(1, rawVal.length() - 1);
        }

        string v = "";
        if (!rawVal.empty() && rawVal.substr(0, 1) == "\"") {
            rawVal = rawVal.substr(1, rawVal.length() - 1);
            int len = (int)rawVal.length();
            bool escaped = false;
            for (int i = 0; i < len; i = i + 1) {
                string c = rawVal.substr(i, 1);
                if (escaped) {
                    if (c == "n") v = v + "\n";
                    else if (c == "t") v = v + "\t";
                    else if (c == "r") v = v + "\r";
                    else if (c == "\"") v = v + "\"";
                    else if (c == "\\") v = v + "\\";
                    else v = v + c;
                    escaped = false;
                } else if (c == "\\") {
                    escaped = true;
                } else if (c == "\"") {
                    break;
                } else {
                    v = v + c;
                }
            }
        } else if (!rawVal.empty() && rawVal.substr(0, 1) == "'") {
            rawVal = rawVal.substr(1, rawVal.length() - 1);
            int closePos = (int)rawVal.find("'");
            if (closePos != -1) {
                v = rawVal.substr(0, closePos);
            } else {
                v = rawVal;
            }
        } else {
            int hashPos = (int)rawVal.find("#");
            if (hashPos != -1) {
                rawVal = rawVal.substr(0, hashPos);
            }
            v = EnvParser::trim(rawVal);
        }

        outKey = k;
        outVal = v;
        return true;
    }

    static public string extractVarName(string val) {
        string trimmed = EnvParser::trim(val);
        // Format 1: "ENV::[variableName]"
        if (trimmed.length() >= 7 && trimmed.substr(0, 6) == "ENV::[") {
            int closeBracket = (int)trimmed.find("]", 6);
            if (closeBracket != -1) {
                return EnvParser::trim(trimmed.substr(6, closeBracket - 6));
            }
            int closeBrace = (int)trimmed.find("}", 6);
            if (closeBrace != -1) {
                return EnvParser::trim(trimmed.substr(6, closeBrace - 6));
            }
        }
        // Format 2: "ENV::variableName"
        if (trimmed.length() > 5 && trimmed.substr(0, 5) == "ENV::") {
            return EnvParser::trim(trimmed.substr(5));
        }
        // Format 3: "{{ENV->[variableName]}}" or "{{ENV->[variableName}"
        if (trimmed.length() >= 9 && trimmed.substr(0, 8) == "{{ENV->[") {
            int closeBracket = (int)trimmed.find("]", 8);
            if (closeBracket != -1) {
                return EnvParser::trim(trimmed.substr(8, closeBracket - 8));
            }
            int closeBrace = (int)trimmed.find("}", 8);
            if (closeBrace != -1) {
                return EnvParser::trim(trimmed.substr(8, closeBrace - 8));
            }
        }
        // Format 4: "{{ENV->variableName}}"
        if (trimmed.length() >= 7 && trimmed.substr(0, 7) == "{{ENV->") {
            int closeBraces = (int)trimmed.find("}}", 7);
            if (closeBraces != -1) {
                return EnvParser::trim(trimmed.substr(7, closeBraces - 7));
            }
        }
        return "";
    }

    static public bool isDynamic(string val) {
        string vName = EnvParser::extractVarName(val);
        return vName.length() > 0;
    }

    static public string interpolateString(string val, Array<EnvItem*>* envItems) {
        string result = val;
        string prefix = "ENV::[";
        int idx = (int)result.find(prefix);
        while (idx != -1) {
            int closeIdx = (int)result.find("]", idx + 6);
            if (closeIdx == -1) {
                break;
            }
            string varName = result.substr(idx + 6, closeIdx - (idx + 6));
            string resolved = "";
            int count = (int)envItems->length();
            bool found = false;
            for (int i = 0; i < count; i = i + 1) {
                EnvItem* it = envItems->get(i);
                if (it->key == varName) {
                    resolved = it->resolvedValue;
                    found = true;
                    break;
                }
            }
            if (!found) {
                char* sysVal = (char*)std::getenv(varName.c_str());
                if (sysVal != nullptr) {
                    resolved = std::string(sysVal);
                }
            }
            result = result.substr(0, idx) + resolved + result.substr(closeIdx + 1);
            idx = (int)result.find(prefix, idx + (int)resolved.length());
        }
        return result;
    }
}

class EnvManager {
    static private Array<string>* s_keys;
    static private Array<string>* s_values;

    static public void init() {
        if (EnvManager::s_keys == nullptr) {
            EnvManager::s_keys = new Array<string>();
            EnvManager::s_values = new Array<string>();
        }
    }

    static public void store(string key, string val) {
        EnvManager::init();
        int count = (int)EnvManager::s_keys->length();
        for (int i = 0; i < count; i = i + 1) {
            if (EnvManager::s_keys->get(i) == key) {
                EnvManager::s_values->set(i, val);
                return;
            }
        }
        EnvManager::s_keys->push(key);
        EnvManager::s_values->push(val);
    }

    static public string get(string key, string defaultVal) {
        EnvManager::init();
        int count = (int)EnvManager::s_keys->length();
        for (int i = 0; i < count; i = i + 1) {
            if (EnvManager::s_keys->get(i) == key) {
                return EnvManager::s_values->get(i);
            }
        }
        char* envV = (char*)std::getenv(key.c_str());
        if (envV != nullptr) {
            return std::string(envV);
        }
        return defaultVal;
    }

    static public void set(string key, string val) {
        setenv(key.c_str(), val.c_str(), 1);
        EnvManager::store(key, val);
    }

    static public bool has(string key) {
        EnvManager::init();
        int count = (int)EnvManager::s_keys->length();
        for (int i = 0; i < count; i = i + 1) {
            if (EnvManager::s_keys->get(i) == key) {
                return true;
            }
        }
        char* envV = (char*)std::getenv(key.c_str());
        return envV != nullptr;
    }

    static public int getInt(string key, int defaultVal) {
        string v = EnvManager::get(key, "");
        if (v.length() == 0) return defaultVal;
        try {
            return std::stoi(v);
        } catch (...) {
            return defaultVal;
        }
    }

    static public bool getBool(string key, bool defaultVal) {
        string v = EnvManager::get(key, "");
        if (v == "true" || v == "1" || v == "yes" || v == "on") return true;
        if (v == "false" || v == "0" || v == "no" || v == "off") return false;
        return defaultVal;
    }

    static public Array<string>* getAllKeys() {
        EnvManager::init();
        return EnvManager::s_keys;
    }

    static public void clear() {
        EnvManager::s_keys = new Array<string>();
        EnvManager::s_values = new Array<string>();
    }

    static public EnvConfigOptions* parseEnvsOptions(string content) {
        EnvConfigOptions* cfg = new EnvConfigOptions();

        // 1. Look for options.envs: "options" -> "envs"
        int envsIdx = -1;
        int optIdx = (int)content.find("\"options\"");
        if (optIdx != -1) {
            int optOpen = (int)content.find("{", optIdx);
            int optClose = -1;
            if (optOpen != -1) {
                int depth = 0;
                int cLen = (int)content.length();
                for (int i = optOpen; i < cLen; i = i + 1) {
                    string ch = content.substr(i, 1);
                    if (ch == "{") depth = depth + 1;
                    else if (ch == "}") {
                        depth = depth - 1;
                        if (depth == 0) {
                            optClose = i;
                            break;
                        }
                    }
                }
            }
            if (optOpen != -1 && optClose != -1) {
                string insideOpt = content.substr(optOpen, optClose - optOpen + 1);
                int eIdx = (int)insideOpt.find("\"envs\"");
                if (eIdx != -1) {
                    envsIdx = optOpen + eIdx;
                }
            }
        }

        // 2. If not found in options, check top-level "envs"
        if (envsIdx == -1) {
            envsIdx = (int)content.find("\"envs\"");
        }

        if (envsIdx == -1) {
            return cfg;
        }

        int openBrace = (int)content.find("{", envsIdx);
        if (openBrace == -1) {
            return cfg;
        }

        int closeBrace = -1;
        int depth = 0;
        int cLen = (int)content.length();
        for (int i = openBrace; i < cLen; i = i + 1) {
            string ch = content.substr(i, 1);
            if (ch == "{") depth = depth + 1;
            else if (ch == "}") {
                depth = depth - 1;
                if (depth == 0) {
                    closeBrace = i;
                    break;
                }
            }
        }

        if (closeBrace == -1 || closeBrace <= openBrace) {
            return cfg;
        }

        string envBlock = content.substr(openBrace + 1, closeBrace - openBrace - 1);
        int bLen = (int)envBlock.length();
        int pos = 0;
        while (pos < bLen) {
            int q1 = (int)envBlock.find("\"", pos);
            if (q1 == -1) break;
            int q2 = (int)envBlock.find("\"", q1 + 1);
            if (q2 == -1) break;
            string envName = envBlock.substr(q1 + 1, q2 - q1 - 1);

            int colon = (int)envBlock.find(":", q2 + 1);
            if (colon == -1) break;

            int vq1 = (int)envBlock.find("\"", colon + 1);
            if (vq1 == -1) break;
            int vq2 = (int)envBlock.find("\"", vq1 + 1);
            if (vq2 == -1) break;
            string rootPath = envBlock.substr(vq1 + 1, vq2 - vq1 - 1);

            cfg->addEnv(envName, rootPath);
            pos = vq2 + 1;
        }

        return cfg;
    }

    static public Array<EnvItem*>* parseProcessEnv(string content) {
        Array<EnvItem*>* items = new Array<EnvItem*>();

        int targetOpen = -1;
        int targetClose = -1;

        // Form 1: "process.env"
        int pEnvIdx = (int)content.find("\"process.env\"");
        if (pEnvIdx != -1) {
            targetOpen = (int)content.find("{", pEnvIdx);
        }

        // Form 2: "process" -> "env"
        if (targetOpen == -1) {
            int pIdx = (int)content.find("\"process\"");
            if (pIdx != -1) {
                int eIdx = (int)content.find("\"env\"", pIdx);
                if (eIdx != -1) {
                    targetOpen = (int)content.find("{", eIdx);
                }
            }
        }

        // Form 3: "env": { ... } (must be an object, not a string like "env": "./.env" in thunder)
        if (targetOpen == -1) {
            int eIdx = 0;
            while (true) {
                eIdx = (int)content.find("\"env\"", eIdx);
                if (eIdx == -1) break;
                if (content.length() > eIdx + 5 && content.substr(eIdx, 6) == "\"envs\"") {
                    eIdx = eIdx + 6;
                    continue;
                }
                int colon = (int)content.find(":", eIdx);
                if (colon != -1) {
                    int nextPos = colon + 1;
                    while (nextPos < (int)content.length() && (content.substr(nextPos, 1) == " " || content.substr(nextPos, 1) == "\t" || content.substr(nextPos, 1) == "\n" || content.substr(nextPos, 1) == "\r")) {
                        nextPos = nextPos + 1;
                    }
                    if (nextPos < (int)content.length() && content.substr(nextPos, 1) == "{") {
                        targetOpen = nextPos;
                        break;
                    }
                }
                eIdx = eIdx + 5;
            }
        }

        if (targetOpen == -1) {
            return items;
        }

        int depth = 0;
        int cLen = (int)content.length();
        for (int i = targetOpen; i < cLen; i = i + 1) {
            string ch = content.substr(i, 1);
            if (ch == "{") depth = depth + 1;
            else if (ch == "}") {
                depth = depth - 1;
                if (depth == 0) {
                    targetClose = i;
                    break;
                }
            }
        }

        if (targetClose == -1 || targetClose <= targetOpen) {
            return items;
        }

        string block = content.substr(targetOpen + 1, targetClose - targetOpen - 1);
        int bLen = (int)block.length();
        int pos = 0;
        while (pos < bLen) {
            int q1 = (int)block.find("\"", pos);
            if (q1 == -1) break;
            int q2 = (int)block.find("\"", q1 + 1);
            if (q2 == -1) break;
            string keyName = block.substr(q1 + 1, q2 - q1 - 1);

            int colon = (int)block.find(":", q2 + 1);
            if (colon == -1) break;

            int valStart = colon + 1;
            while (valStart < bLen && (block.substr(valStart, 1) == " " || block.substr(valStart, 1) == "\t" || block.substr(valStart, 1) == "\r" || block.substr(valStart, 1) == "\n")) {
                valStart = valStart + 1;
            }
            if (valStart >= bLen) break;

            string rawVal = "";
            int nextPos = valStart;

            if (block.substr(valStart, 1) == "\"") {
                int vq2 = (int)block.find("\"", valStart + 1);
                if (vq2 != -1) {
                    rawVal = block.substr(valStart + 1, vq2 - valStart - 1);
                    nextPos = vq2 + 1;
                }
            } else {
                int comma = (int)block.find(",", valStart);
                int brace = (int)block.find("}", valStart);
                int endVal = bLen;
                if (comma != -1 && comma < endVal) endVal = comma;
                if (brace != -1 && brace < endVal) endVal = brace;
                rawVal = EnvParser::trim(block.substr(valStart, endVal - valStart));
                nextPos = endVal + 1;
            }

            bool isDyn = EnvParser::isDynamic(rawVal);
            string srcVar = "";
            if (isDyn) {
                srcVar = EnvParser::extractVarName(rawVal);
            }

            items->push(new EnvItem(keyName, rawVal, "", isDyn, srcVar));
            pos = nextPos;
        }

        return items;
    }

    static public Array<EnvItem*>* loadEnvFile(string path) {
        Array<EnvItem*>* items = new Array<EnvItem*>();
        if (!fs.exists(path)) {
            return items;
        }

        string content = fs.readFile(path);
        int len = (int)content.length();
        if (len == 0) {
            return items;
        }

        int lineStart = 0;
        for (int i = 0; i <= len; i = i + 1) {
            if (i == len || content.substr(i, 1) == "\n") {
                if (i > lineStart) {
                    string line = content.substr(lineStart, i - lineStart);
                    string k = "";
                    string v = "";
                    if (EnvParser::parseLine(line, k, v)) {
                        items->push(new EnvItem(k, v, v, false, ""));
                    }
                }
                lineStart = i + 1;
            }
        }
        return items;
    }

    static public string resolveActiveEnvironment(string explicitEnv) {
        if (explicitEnv.length() > 0) {
            return explicitEnv;
        }
        char* cexEnv = (char*)std::getenv("CEX_ENV");
        if (cexEnv != nullptr && std::string(cexEnv).length() > 0) {
            return std::string(cexEnv);
        }
        char* nodeEnv = (char*)std::getenv("NODE_ENV");
        if (nodeEnv != nullptr && std::string(nodeEnv).length() > 0) {
            return std::string(nodeEnv);
        }
        char* appEnv = (char*)std::getenv("APP_ENV");
        if (appEnv != nullptr && std::string(appEnv).length() > 0) {
            return std::string(appEnv);
        }
        char* envName = (char*)std::getenv("ENVIRONMENT");
        if (envName != nullptr && std::string(envName).length() > 0) {
            return std::string(envName);
        }
        return "development";
    }

    static public int autoLoad(string manifestPath, string explicitEnv) {
        string targetManifest = manifestPath;
        if (targetManifest.length() == 0) {
            targetManifest = "cex-pack.json";
        }

        string manifestDir = ".";
        int lastSlash = -1;
        int mLen = (int)targetManifest.length();
        for (int i = 0; i < mLen; i = i + 1) {
            if (targetManifest.substr(i, 1) == "/") {
                lastSlash = i;
            }
        }
        if (lastSlash != -1) {
            manifestDir = targetManifest.substr(0, lastSlash);
        }

        string manifestContent = "";
        if (fs.exists(targetManifest)) {
            manifestContent = fs.readFile(targetManifest);
        }

        string activeEnv = EnvManager::resolveActiveEnvironment(explicitEnv);
        EnvConfigOptions* envOptions = EnvManager::parseEnvsOptions(manifestContent);

        string rootEnvPath = "";
        if (envOptions->hasEnv(activeEnv)) {
            rootEnvPath = envOptions->getPathForEnv(activeEnv);
        } else if (envOptions->hasEnv("default")) {
            rootEnvPath = envOptions->getPathForEnv("default");
        } else if (activeEnv == "development" && envOptions->hasEnv("dev")) {
            rootEnvPath = envOptions->getPathForEnv("dev");
        } else if (activeEnv == "production" && envOptions->hasEnv("prod")) {
            rootEnvPath = envOptions->getPathForEnv("prod");
        }

        string targetEnvFile = "";
        if (rootEnvPath.length() > 0) {
            if (fs.exists(rootEnvPath)) {
                targetEnvFile = rootEnvPath;
            } else if (manifestDir != ".") {
                string candidate = "";
                if (rootEnvPath.substr(0, 2) == "./") {
                    candidate = manifestDir + "/" + rootEnvPath.substr(2);
                } else {
                    candidate = manifestDir + "/" + rootEnvPath;
                }
                if (fs.exists(candidate)) {
                    targetEnvFile = candidate;
                } else {
                    targetEnvFile = rootEnvPath;
                }
            } else {
                targetEnvFile = rootEnvPath;
            }
        } else {
            string cand1 = manifestDir == "." ? ".env." + activeEnv : manifestDir + "/.env." + activeEnv;
            string cand2 = manifestDir == "." ? ".env" : manifestDir + "/.env";
            if (fs.exists(cand1)) {
                targetEnvFile = cand1;
            } else if (fs.exists(cand2)) {
                targetEnvFile = cand2;
            } else if (fs.exists(".env")) {
                targetEnvFile = ".env";
            }
        }

        int loadedCount = 0;
        Array<EnvItem*>* envItems = new Array<EnvItem*>();

        if (targetEnvFile.length() > 0 && fs.exists(targetEnvFile)) {
            envItems = EnvManager::loadEnvFile(targetEnvFile);
            int count = (int)envItems->length();
            for (int i = 0; i < count; i = i + 1) {
                EnvItem* it = envItems->get(i);
                setenv(it->key.c_str(), it->resolvedValue.c_str(), 1);
                EnvManager::store(it->key, it->resolvedValue);
                loadedCount = loadedCount + 1;
            }
        }

        if (manifestContent.length() > 0) {
            Array<EnvItem*>* procEnvItems = EnvManager::parseProcessEnv(manifestContent);
            int pCount = (int)procEnvItems->length();
            for (int i = 0; i < pCount; i = i + 1) {
                EnvItem* pIt = procEnvItems->get(i);
                string finalVal = "";

                if (pIt->isDynamic) {
                    string srcName = pIt->sourceVarName;
                    bool found = false;
                    int eCount = (int)envItems->length();
                    for (int j = 0; j < eCount; j = j + 1) {
                        EnvItem* eIt = envItems->get(j);
                        if (eIt->key == srcName) {
                            finalVal = eIt->resolvedValue;
                            found = true;
                            break;
                        }
                    }
                    if (!found) {
                        char* sysV = (char*)std::getenv(srcName.c_str());
                        if (sysV != nullptr) {
                            finalVal = std::string(sysV);
                        }
                    }
                } else {
                    finalVal = EnvParser::interpolateString(pIt->rawValue, envItems);
                }

                pIt->resolvedValue = finalVal;
                setenv(pIt->key.c_str(), finalVal.c_str(), 1);
                EnvManager::store(pIt->key, finalVal);
                loadedCount = loadedCount + 1;
            }
        }

        return loadedCount;
    }

    static public int loadFromPath(string envFilePath) {
        int loadedCount = 0;
        if (!fs.exists(envFilePath)) {
            return 0;
        }
        Array<EnvItem*>* envItems = EnvManager::loadEnvFile(envFilePath);
        int count = (int)envItems->length();
        for (int i = 0; i < count; i = i + 1) {
            EnvItem* it = envItems->get(i);
            setenv(it->key.c_str(), it->resolvedValue.c_str(), 1);
            EnvManager::store(it->key, it->resolvedValue);
            loadedCount = loadedCount + 1;
        }
        return loadedCount;
    }

    static public string resolveManifest(string manifestContent, string explicitEnv, string manifestPath) {
        string activeEnv = EnvManager::resolveActiveEnvironment(explicitEnv);
        EnvConfigOptions* envOptions = EnvManager::parseEnvsOptions(manifestContent);

        string manifestDir = ".";
        int lastSlash = -1;
        int mLen = (int)manifestPath.length();
        for (int i = 0; i < mLen; i = i + 1) {
            if (manifestPath.substr(i, 1) == "/") {
                lastSlash = i;
            }
        }
        if (lastSlash != -1) {
            manifestDir = manifestPath.substr(0, lastSlash);
        }

        string rootEnvPath = "";
        if (envOptions->hasEnv(activeEnv)) {
            rootEnvPath = envOptions->getPathForEnv(activeEnv);
        } else if (envOptions->hasEnv("default")) {
            rootEnvPath = envOptions->getPathForEnv("default");
        } else if (activeEnv == "development" && envOptions->hasEnv("dev")) {
            rootEnvPath = envOptions->getPathForEnv("dev");
        } else if (activeEnv == "production" && envOptions->hasEnv("prod")) {
            rootEnvPath = envOptions->getPathForEnv("prod");
        } else {
            rootEnvPath = ".env";
        }

        string targetEnvFile = "";
        if (rootEnvPath.length() > 0) {
            if (fs.exists(rootEnvPath)) {
                targetEnvFile = rootEnvPath;
            } else if (manifestDir != ".") {
                string candidate = "";
                if (rootEnvPath.substr(0, 2) == "./") {
                    candidate = manifestDir + "/" + rootEnvPath.substr(2);
                } else {
                    candidate = manifestDir + "/" + rootEnvPath;
                }
                if (fs.exists(candidate)) {
                    targetEnvFile = candidate;
                } else {
                    targetEnvFile = rootEnvPath;
                }
            } else {
                targetEnvFile = rootEnvPath;
            }
        }

        Array<EnvItem*>* envItems = new Array<EnvItem*>();
        if (targetEnvFile.length() > 0 && fs.exists(targetEnvFile)) {
            envItems = EnvManager::loadEnvFile(targetEnvFile);
        }

        string result = manifestContent;

        string prefix1 = "ENV::[";
        int idx1 = (int)result.find(prefix1);
        while (idx1 != -1) {
            int close1 = (int)result.find("]", idx1 + 6);
            if (close1 == -1) break;
            string varName = result.substr(idx1 + 6, close1 - (idx1 + 6));
            string resolved = "";
            bool found = false;
            int eCount = (int)envItems->length();
            for (int i = 0; i < eCount; i = i + 1) {
                EnvItem* it = envItems->get(i);
                if (it->key == varName) {
                    resolved = it->resolvedValue;
                    found = true;
                    break;
                }
            }
            if (!found) {
                char* sysV = (char*)std::getenv(varName.c_str());
                if (sysV != nullptr) resolved = std::string(sysV);
            }
            result = result.substr(0, idx1) + resolved + result.substr(close1 + 1);
            idx1 = (int)result.find(prefix1, idx1 + (int)resolved.length());
        }

        string prefix2 = "ENV::";
        int idx2 = (int)result.find(prefix2);
        while (idx2 != -1) {
            if (result.length() > idx2 + 5 && result.substr(idx2 + 5, 1) == "[") {
                idx2 = (int)result.find(prefix2, idx2 + 5);
                continue;
            }
            int endVar = (int)result.find("\"", idx2 + 5);
            if (endVar == -1) break;
            string varName = result.substr(idx2 + 5, endVar - (idx2 + 5));
            string resolved = "";
            bool found = false;
            int eCount = (int)envItems->length();
            for (int i = 0; i < eCount; i = i + 1) {
                EnvItem* it = envItems->get(i);
                if (it->key == varName) {
                    resolved = it->resolvedValue;
                    found = true;
                    break;
                }
            }
            if (!found) {
                char* sysV = (char*)std::getenv(varName.c_str());
                if (sysV != nullptr) resolved = std::string(sysV);
            }
            result = result.substr(0, idx2) + resolved + result.substr(endVar);
            idx2 = (int)result.find(prefix2, idx2 + (int)resolved.length());
        }

        return result;
    }
}

class ProcessEnv {
    static public string get(string key, string defaultVal) {
        return EnvManager::get(key, defaultVal);
    }

    static public void set(string key, string val) {
        EnvManager::set(key, val);
    }

    static public bool has(string key) {
        return EnvManager::has(key);
    }

    static public int getInt(string key, int defaultVal) {
        return EnvManager::getInt(key, defaultVal);
    }

    static public bool getBool(string key, bool defaultVal) {
        return EnvManager::getBool(key, defaultVal);
    }

    static public Array<string>* getAllKeys() {
        return EnvManager::getAllKeys();
    }

    static public int autoLoad(string manifestPath, string explicitEnv) {
        return EnvManager::autoLoad(manifestPath, explicitEnv);
    }

    static public int loadFromPath(string envFilePath) {
        return EnvManager::loadFromPath(envFilePath);
    }

    static public void clear() {
        EnvManager::clear();
    }
}

class ProcessEnvMap {
    public string get(string key, string defaultVal) {
        return ProcessEnv::get(key, defaultVal);
    }

    public void set(string key, string val) {
        ProcessEnv::set(key, val);
    }

    public bool has(string key) {
        return ProcessEnv::has(key);
    }

    public int getInt(string key, int defaultVal) {
        return ProcessEnv::getInt(key, defaultVal);
    }

    public bool getBool(string key, bool defaultVal) {
        return ProcessEnv::getBool(key, defaultVal);
    }
}

class ProcessObject {
    public ProcessEnvMap env;

    public constructor() {}
}

inline ProcessObject process;
