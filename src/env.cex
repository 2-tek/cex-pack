// CexPack Environment Loader and Process.Env Manager (C-ext)
// Rule Conformance: Rule 69 (Target), Rule 29 (EOF), Rule 72 (Dynamic Paths)

import "./types.cex";
import fs from "fs";
import "cpp.string";

class EnvParser {
    public static trim(s: string): string {
        let res: string = s;
        while (res.length() > 0 && (res.substr(0, 1) == " " || res.substr(0, 1) == "\t" || res.substr(0, 1) == "\r" || res.substr(0, 1) == "\n")) {
            res = res.substr(1, res.length() - 1);
        }
        while (res.length() > 0 && (res.substr(res.length() - 1, 1) == " " || res.substr(res.length() - 1, 1) == "\t" || res.substr(res.length() - 1, 1) == "\r" || res.substr(res.length() - 1, 1) == "\n")) {
            res = res.substr(0, res.length() - 1);
        }
        return res;
    }

    public static parseLine(line: string, outKey: string&, outVal: string&): bool {
        let l: string = EnvParser::trim(line);
        if (l.empty() || l.substr(0, 1) == "#") {
            return false;
        }

        if (l.length() >= 7 && l.substr(0, 7) == "export ") {
            l = EnvParser::trim(l.substr(7));
        }

        let eqPos: int = (int)l.find("=");
        if (eqPos == -1) {
            return false;
        }

        let k: string = EnvParser::trim(l.substr(0, eqPos));
        if (k.empty()) {
            return false;
        }

        let rawVal: string = l.substr(eqPos + 1);
        while (rawVal.length() > 0 && (rawVal.substr(0, 1) == " " || rawVal.substr(0, 1) == "\t")) {
            rawVal = rawVal.substr(1, rawVal.length() - 1);
        }

        let v: string = "";
        if (!rawVal.empty() && rawVal.substr(0, 1) == "\"") {
            rawVal = rawVal.substr(1, rawVal.length() - 1);
            let len: int = (int)rawVal.length();
            let escaped: bool = false;
            for (let i: int = 0; i < len; i = i + 1) {
                let c: string = rawVal.substr(i, 1);
                if (escaped) {
                    if (c == "n") v = v + "\n";
                    else if (c == "t") v = v + "\t";
                    else if (c == "r") v = v + "\r";
                    else if (c == "\"") v = v + "\"";
                    else if (c == "\\") v = v + "\\";
                    else v = v + c;
                    escaped = false;
                } else if (c == "\\") {
                    escaped = true;
                } else if (c == "\"") {
                    break;
                } else {
                    v = v + c;
                }
            }
        } else if (!rawVal.empty() && rawVal.substr(0, 1) == "'") {
            rawVal = rawVal.substr(1, rawVal.length() - 1);
            let closePos: int = (int)rawVal.find("'");
            if (closePos != -1) {
                v = rawVal.substr(0, closePos);
            } else {
                v = rawVal;
            }
        } else {
            let hashPos: int = (int)rawVal.find("#");
            if (hashPos != -1) {
                rawVal = rawVal.substr(0, hashPos);
            }
            v = EnvParser::trim(rawVal);
        }

        outKey = k;
        outVal = v;
        return true;
    }

    public static extractVarName(val: string): string {
        let trimmed: string = EnvParser::trim(val);
        // Format 1: "ENV::[variableName]"
        if (trimmed.length() >= 7 && trimmed.substr(0, 6) == "ENV::[") {
            let closeBracket: int = (int)trimmed.find("]", 6);
            if (closeBracket != -1) {
                return EnvParser::trim(trimmed.substr(6, closeBracket - 6));
            }
            let closeBrace: int = (int)trimmed.find("}", 6);
            if (closeBrace != -1) {
                return EnvParser::trim(trimmed.substr(6, closeBrace - 6));
            }
        }
        // Format 2: "ENV::variableName"
        if (trimmed.length() > 5 && trimmed.substr(0, 5) == "ENV::") {
            return EnvParser::trim(trimmed.substr(5));
        }
        // Format 3: "{{ENV->[variableName]}}" or "{{ENV->[variableName}"
        if (trimmed.length() >= 9 && trimmed.substr(0, 8) == "{{ENV->[") {
            let closeBracket: int = (int)trimmed.find("]", 8);
            if (closeBracket != -1) {
                return EnvParser::trim(trimmed.substr(8, closeBracket - 8));
            }
            let closeBrace: int = (int)trimmed.find("}", 8);
            if (closeBrace != -1) {
                return EnvParser::trim(trimmed.substr(8, closeBrace - 8));
            }
        }
        // Format 4: "{{ENV->variableName}}"
        if (trimmed.length() >= 7 && trimmed.substr(0, 7) == "{{ENV->") {
            let closeBraces: int = (int)trimmed.find("}}", 7);
            if (closeBraces != -1) {
                return EnvParser::trim(trimmed.substr(7, closeBraces - 7));
            }
        }
        return "";
    }

    public static isDynamic(val: string): bool {
        let vName: string = EnvParser::extractVarName(val);
        return vName.length() > 0;
    }

    public static interpolateString(val: string, envItems: Array<EnvItem*>*): string {
        let result: string = val;
        let prefix: string = "ENV::[";
        let idx: int = (int)result.find(prefix);
        while (idx != -1) {
            let closeIdx: int = (int)result.find("]", idx + 6);
            if (closeIdx == -1) {
                break;
            }
            let varName: string = result.substr(idx + 6, closeIdx - (idx + 6));
            let resolved: string = "";
            let count: int = (int)envItems->length();
            let found: bool = false;
            for (let i: int = 0; i < count; i = i + 1) {
                let it: EnvItem* = envItems->get(i);
                if (it->key == varName) {
                    resolved = it->resolvedValue;
                    found = true;
                    break;
                }
            }
            if (!found) {
                let sysVal: char* = (char*)std::getenv(varName.c_str());
                if (sysVal != nullptr) {
                    resolved = std::string(sysVal);
                }
            }
            result = result.substr(0, idx) + resolved + result.substr(closeIdx + 1);
            idx = (int)result.find(prefix, idx + (int)resolved.length());
        }
        return result;
    }
}

class EnvManager {
    private static s_keys: Array<string>*;
    private static s_values: Array<string>*;

    public static init(): void {
        if (EnvManager::s_keys == nullptr) {
            EnvManager::s_keys = new Array<string>();
            EnvManager::s_values = new Array<string>();
        }
    }

    public static store(key: string, val: string): void {
        EnvManager::init();
        let count: int = (int)EnvManager::s_keys->length();
        for (let i: int = 0; i < count; i = i + 1) {
            if (EnvManager::s_keys->get(i) == key) {
                EnvManager::s_values->set(i, val);
                return;
            }
        }
        EnvManager::s_keys->push(key);
        EnvManager::s_values->push(val);
    }

    public static get(key: string, defaultVal: string): string {
        EnvManager::init();
        let count: int = (int)EnvManager::s_keys->length();
        for (let i: int = 0; i < count; i = i + 1) {
            if (EnvManager::s_keys->get(i) == key) {
                return EnvManager::s_values->get(i);
            }
        }
        let envV: char* = (char*)std::getenv(key.c_str());
        if (envV != nullptr) {
            return std::string(envV);
        }
        return defaultVal;
    }

    public static set(key: string, val: string): void {
        setenv(key.c_str(), val.c_str(), 1);
        EnvManager::store(key, val);
    }

    public static has(key: string): bool {
        EnvManager::init();
        let count: int = (int)EnvManager::s_keys->length();
        for (let i: int = 0; i < count; i = i + 1) {
            if (EnvManager::s_keys->get(i) == key) {
                return true;
            }
        }
        let envV: char* = (char*)std::getenv(key.c_str());
        return envV != nullptr;
    }

    public static getInt(key: string, defaultVal: int): int {
        let v: string = EnvManager::get(key, "");
        if (v.length() == 0) return defaultVal;
        try {
            return std::stoi(v);
        } catch (...) {
            return defaultVal;
        }
    }

    public static getBool(key: string, defaultVal: bool): bool {
        let v: string = EnvManager::get(key, "");
        if (v == "true" || v == "1" || v == "yes" || v == "on") return true;
        if (v == "false" || v == "0" || v == "no" || v == "off") return false;
        return defaultVal;
    }

    public static getAllKeys(): Array<string>* {
        EnvManager::init();
        return EnvManager::s_keys;
    }

    public static clear(): void {
        EnvManager::s_keys = new Array<string>();
        EnvManager::s_values = new Array<string>();
    }

    public static parseEnvsOptions(content: string): EnvConfigOptions* {
        let cfg: EnvConfigOptions* = new EnvConfigOptions();

        // 1. Look for options.envs: "options" -> "envs"
        let envsIdx: int = -1;
        let optIdx: int = (int)content.find("\"options\"");
        if (optIdx != -1) {
            let optOpen: int = (int)content.find("{", optIdx);
            let optClose: int = -1;
            if (optOpen != -1) {
                let depth: int = 0;
                let cLen: int = (int)content.length();
                for (let i: int = optOpen; i < cLen; i = i + 1) {
                    let ch: string = content.substr(i, 1);
                    if (ch == "{") depth = depth + 1;
                    else if (ch == "}") {
                        depth = depth - 1;
                        if (depth == 0) {
                            optClose = i;
                            break;
                        }
                    }
                }
            }
            if (optOpen != -1 && optClose != -1) {
                let insideOpt: string = content.substr(optOpen, optClose - optOpen + 1);
                let eIdx: int = (int)insideOpt.find("\"envs\"");
                if (eIdx != -1) {
                    envsIdx = optOpen + eIdx;
                }
            }
        }

        // 2. If not found in options, check top-level "envs"
        if (envsIdx == -1) {
            envsIdx = (int)content.find("\"envs\"");
        }

        if (envsIdx == -1) {
            return cfg;
        }

        let openBrace: int = (int)content.find("{", envsIdx);
        if (openBrace == -1) {
            return cfg;
        }

        let closeBrace: int = -1;
        let depth: int = 0;
        let cLen: int = (int)content.length();
        for (let i: int = openBrace; i < cLen; i = i + 1) {
            let ch: string = content.substr(i, 1);
            if (ch == "{") depth = depth + 1;
            else if (ch == "}") {
                depth = depth - 1;
                if (depth == 0) {
                    closeBrace = i;
                    break;
                }
            }
        }

        if (closeBrace == -1 || closeBrace <= openBrace) {
            return cfg;
        }

        let envBlock: string = content.substr(openBrace + 1, closeBrace - openBrace - 1);
        let bLen: int = (int)envBlock.length();
        let pos: int = 0;
        while (pos < bLen) {
            let q1: int = (int)envBlock.find("\"", pos);
            if (q1 == -1) break;
            let q2: int = (int)envBlock.find("\"", q1 + 1);
            if (q2 == -1) break;
            let envName: string = envBlock.substr(q1 + 1, q2 - q1 - 1);

            let colon: int = (int)envBlock.find(":", q2 + 1);
            if (colon == -1) break;

            let vq1: int = (int)envBlock.find("\"", colon + 1);
            if (vq1 == -1) break;
            let vq2: int = (int)envBlock.find("\"", vq1 + 1);
            if (vq2 == -1) break;
            let rootPath: string = envBlock.substr(vq1 + 1, vq2 - vq1 - 1);

            cfg->addEnv(envName, rootPath);
            pos = vq2 + 1;
        }

        return cfg;
    }

    public static parseProcessEnv(content: string): Array<EnvItem*>* {
        let items: Array<EnvItem*>* = new Array<EnvItem*>();

        let targetOpen: int = -1;
        let targetClose: int = -1;

        // Form 1: "process.env"
        let pEnvIdx: int = (int)content.find("\"process.env\"");
        if (pEnvIdx != -1) {
            targetOpen = (int)content.find("{", pEnvIdx);
        }

        // Form 2: "process" -> "env"
        if (targetOpen == -1) {
            let pIdx: int = (int)content.find("\"process\"");
            if (pIdx != -1) {
                let eIdx: int = (int)content.find("\"env\"", pIdx);
                if (eIdx != -1) {
                    targetOpen = (int)content.find("{", eIdx);
                }
            }
        }

        // Form 3: "env": { ... } (must be an object, not a string like "env": "./.env" in thunder)
        if (targetOpen == -1) {
            let eIdx: int = 0;
            while (true) {
                eIdx = (int)content.find("\"env\"", eIdx);
                if (eIdx == -1) break;
                if (content.length() > eIdx + 5 && content.substr(eIdx, 6) == "\"envs\"") {
                    eIdx = eIdx + 6;
                    continue;
                }
                let colon: int = (int)content.find(":", eIdx);
                if (colon != -1) {
                    let nextPos: int = colon + 1;
                    while (nextPos < (int)content.length() && (content.substr(nextPos, 1) == " " || content.substr(nextPos, 1) == "\t" || content.substr(nextPos, 1) == "\n" || content.substr(nextPos, 1) == "\r")) {
                        nextPos = nextPos + 1;
                    }
                    if (nextPos < (int)content.length() && content.substr(nextPos, 1) == "{") {
                        targetOpen = nextPos;
                        break;
                    }
                }
                eIdx = eIdx + 5;
            }
        }

        if (targetOpen == -1) {
            return items;
        }

        let depth: int = 0;
        let cLen: int = (int)content.length();
        for (let i: int = targetOpen; i < cLen; i = i + 1) {
            let ch: string = content.substr(i, 1);
            if (ch == "{") depth = depth + 1;
            else if (ch == "}") {
                depth = depth - 1;
                if (depth == 0) {
                    targetClose = i;
                    break;
                }
            }
        }

        if (targetClose == -1 || targetClose <= targetOpen) {
            return items;
        }

        let block: string = content.substr(targetOpen + 1, targetClose - targetOpen - 1);
        let bLen: int = (int)block.length();
        let pos: int = 0;
        while (pos < bLen) {
            let q1: int = (int)block.find("\"", pos);
            if (q1 == -1) break;
            let q2: int = (int)block.find("\"", q1 + 1);
            if (q2 == -1) break;
            let keyName: string = block.substr(q1 + 1, q2 - q1 - 1);

            let colon: int = (int)block.find(":", q2 + 1);
            if (colon == -1) break;

            let valStart: int = colon + 1;
            while (valStart < bLen && (block.substr(valStart, 1) == " " || block.substr(valStart, 1) == "\t" || block.substr(valStart, 1) == "\r" || block.substr(valStart, 1) == "\n")) {
                valStart = valStart + 1;
            }
            if (valStart >= bLen) break;

            let rawVal: string = "";
            let nextPos: int = valStart;

            if (block.substr(valStart, 1) == "\"") {
                let vq2: int = (int)block.find("\"", valStart + 1);
                if (vq2 != -1) {
                    rawVal = block.substr(valStart + 1, vq2 - valStart - 1);
                    nextPos = vq2 + 1;
                }
            } else {
                let comma: int = (int)block.find(",", valStart);
                let brace: int = (int)block.find("}", valStart);
                let endVal: int = bLen;
                if (comma != -1 && comma < endVal) endVal = comma;
                if (brace != -1 && brace < endVal) endVal = brace;
                rawVal = EnvParser::trim(block.substr(valStart, endVal - valStart));
                nextPos = endVal + 1;
            }

            let isDyn: bool = EnvParser::isDynamic(rawVal);
            let srcVar: string = "";
            if (isDyn) {
                srcVar = EnvParser::extractVarName(rawVal);
            }

            items->push(new EnvItem(keyName, rawVal, "", isDyn, srcVar));
            pos = nextPos;
        }

        return items;
    }

    public static loadEnvFile(path: string): Array<EnvItem*>* {
        let items: Array<EnvItem*>* = new Array<EnvItem*>();
        if (!fs.exists(path)) {
            return items;
        }

        let content: string = fs.readFile(path);
        let len: int = (int)content.length();
        if (len == 0) {
            return items;
        }

        let lineStart: int = 0;
        for (let i: int = 0; i <= len; i = i + 1) {
            if (i == len || content.substr(i, 1) == "\n") {
                if (i > lineStart) {
                    let line: string = content.substr(lineStart, i - lineStart);
                    let k: string = "";
                    let v: string = "";
                    if (EnvParser::parseLine(line, k, v)) {
                        items->push(new EnvItem(k, v, v, false, ""));
                    }
                }
                lineStart = i + 1;
            }
        }
        return items;
    }

    public static resolveActiveEnvironment(explicitEnv: string): string {
        if (explicitEnv.length() > 0) {
            return explicitEnv;
        }
        let cexEnv: char* = (char*)std::getenv("CEX_ENV");
        if (cexEnv != nullptr && std::string(cexEnv).length() > 0) {
            return std::string(cexEnv);
        }
        let nodeEnv: char* = (char*)std::getenv("NODE_ENV");
        if (nodeEnv != nullptr && std::string(nodeEnv).length() > 0) {
            return std::string(nodeEnv);
        }
        let appEnv: char* = (char*)std::getenv("APP_ENV");
        if (appEnv != nullptr && std::string(appEnv).length() > 0) {
            return std::string(appEnv);
        }
        let envName: char* = (char*)std::getenv("ENVIRONMENT");
        if (envName != nullptr && std::string(envName).length() > 0) {
            return std::string(envName);
        }
        return "development";
    }

    public static autoLoad(manifestPath: string, explicitEnv: string): int {
        let targetManifest: string = manifestPath;
        if (targetManifest.length() == 0) {
            targetManifest = "cex-pack.json";
        }

        let manifestDir: string = ".";
        let lastSlash: int = -1;
        let mLen: int = (int)targetManifest.length();
        for (let i: int = 0; i < mLen; i = i + 1) {
            if (targetManifest.substr(i, 1) == "/") {
                lastSlash = i;
            }
        }
        if (lastSlash != -1) {
            manifestDir = targetManifest.substr(0, lastSlash);
        }

        let manifestContent: string = "";
        if (fs.exists(targetManifest)) {
            manifestContent = fs.readFile(targetManifest);
        }

        let activeEnv: string = EnvManager::resolveActiveEnvironment(explicitEnv);
        let envOptions: EnvConfigOptions* = EnvManager::parseEnvsOptions(manifestContent);

        let rootEnvPath: string = "";
        if (envOptions->hasEnv(activeEnv)) {
            rootEnvPath = envOptions->getPathForEnv(activeEnv);
        } else if (envOptions->hasEnv("default")) {
            rootEnvPath = envOptions->getPathForEnv("default");
        } else if (activeEnv == "development" && envOptions->hasEnv("dev")) {
            rootEnvPath = envOptions->getPathForEnv("dev");
        } else if (activeEnv == "production" && envOptions->hasEnv("prod")) {
            rootEnvPath = envOptions->getPathForEnv("prod");
        }

        let targetEnvFile: string = "";
        if (rootEnvPath.length() > 0) {
            if (fs.exists(rootEnvPath)) {
                targetEnvFile = rootEnvPath;
            } else if (manifestDir != ".") {
                let candidate: string = "";
                if (rootEnvPath.substr(0, 2) == "./") {
                    candidate = manifestDir + "/" + rootEnvPath.substr(2);
                } else {
                    candidate = manifestDir + "/" + rootEnvPath;
                }
                if (fs.exists(candidate)) {
                    targetEnvFile = candidate;
                } else {
                    targetEnvFile = rootEnvPath;
                }
            } else {
                targetEnvFile = rootEnvPath;
            }
        } else {
            let cand1: string = manifestDir == "." ? ".env." + activeEnv : manifestDir + "/.env." + activeEnv;
            let cand2: string = manifestDir == "." ? ".env" : manifestDir + "/.env";
            if (fs.exists(cand1)) {
                targetEnvFile = cand1;
            } else if (fs.exists(cand2)) {
                targetEnvFile = cand2;
            } else if (fs.exists(".env")) {
                targetEnvFile = ".env";
            }
        }

        let loadedCount: int = 0;
        let envItems: Array<EnvItem*>* = new Array<EnvItem*>();

        if (targetEnvFile.length() > 0 && fs.exists(targetEnvFile)) {
            envItems = EnvManager::loadEnvFile(targetEnvFile);
            let count: int = (int)envItems->length();
            for (let i: int = 0; i < count; i = i + 1) {
                let it: EnvItem* = envItems->get(i);
                setenv(it->key.c_str(), it->resolvedValue.c_str(), 1);
                EnvManager::store(it->key, it->resolvedValue);
                loadedCount = loadedCount + 1;
            }
        }

        if (manifestContent.length() > 0) {
            let procEnvItems: Array<EnvItem*>* = EnvManager::parseProcessEnv(manifestContent);
            let pCount: int = (int)procEnvItems->length();
            for (let i: int = 0; i < pCount; i = i + 1) {
                let pIt: EnvItem* = procEnvItems->get(i);
                let finalVal: string = "";

                if (pIt->isDynamic) {
                    let srcName: string = pIt->sourceVarName;
                    let found: bool = false;
                    let eCount: int = (int)envItems->length();
                    for (let j: int = 0; j < eCount; j = j + 1) {
                        let eIt: EnvItem* = envItems->get(j);
                        if (eIt->key == srcName) {
                            finalVal = eIt->resolvedValue;
                            found = true;
                            break;
                        }
                    }
                    if (!found) {
                        let sysV: char* = (char*)std::getenv(srcName.c_str());
                        if (sysV != nullptr) {
                            finalVal = std::string(sysV);
                        }
                    }
                } else {
                    finalVal = EnvParser::interpolateString(pIt->rawValue, envItems);
                }

                pIt->resolvedValue = finalVal;
                setenv(pIt->key.c_str(), finalVal.c_str(), 1);
                EnvManager::store(pIt->key, finalVal);
                loadedCount = loadedCount + 1;
            }
        }

        return loadedCount;
    }

    public static loadFromPath(envFilePath: string): int {
        let loadedCount: int = 0;
        if (!fs.exists(envFilePath)) {
            return 0;
        }
        let envItems: Array<EnvItem*>* = EnvManager::loadEnvFile(envFilePath);
        let count: int = (int)envItems->length();
        for (let i: int = 0; i < count; i = i + 1) {
            let it: EnvItem* = envItems->get(i);
            setenv(it->key.c_str(), it->resolvedValue.c_str(), 1);
            EnvManager::store(it->key, it->resolvedValue);
            loadedCount = loadedCount + 1;
        }
        return loadedCount;
    }

    public static resolveManifest(manifestContent: string, explicitEnv: string, manifestPath: string): string {
        let activeEnv: string = EnvManager::resolveActiveEnvironment(explicitEnv);
        let envOptions: EnvConfigOptions* = EnvManager::parseEnvsOptions(manifestContent);

        let manifestDir: string = ".";
        let lastSlash: int = -1;
        let mLen: int = (int)manifestPath.length();
        for (let i: int = 0; i < mLen; i = i + 1) {
            if (manifestPath.substr(i, 1) == "/") {
                lastSlash = i;
            }
        }
        if (lastSlash != -1) {
            manifestDir = manifestPath.substr(0, lastSlash);
        }

        let rootEnvPath: string = "";
        if (envOptions->hasEnv(activeEnv)) {
            rootEnvPath = envOptions->getPathForEnv(activeEnv);
        } else if (envOptions->hasEnv("default")) {
            rootEnvPath = envOptions->getPathForEnv("default");
        } else if (activeEnv == "development" && envOptions->hasEnv("dev")) {
            rootEnvPath = envOptions->getPathForEnv("dev");
        } else if (activeEnv == "production" && envOptions->hasEnv("prod")) {
            rootEnvPath = envOptions->getPathForEnv("prod");
        } else {
            rootEnvPath = ".env";
        }

        let targetEnvFile: string = "";
        if (rootEnvPath.length() > 0) {
            if (fs.exists(rootEnvPath)) {
                targetEnvFile = rootEnvPath;
            } else if (manifestDir != ".") {
                let candidate: string = "";
                if (rootEnvPath.substr(0, 2) == "./") {
                    candidate = manifestDir + "/" + rootEnvPath.substr(2);
                } else {
                    candidate = manifestDir + "/" + rootEnvPath;
                }
                if (fs.exists(candidate)) {
                    targetEnvFile = candidate;
                } else {
                    targetEnvFile = rootEnvPath;
                }
            } else {
                targetEnvFile = rootEnvPath;
            }
        }

        let envItems: Array<EnvItem*>* = new Array<EnvItem*>();
        if (targetEnvFile.length() > 0 && fs.exists(targetEnvFile)) {
            envItems = EnvManager::loadEnvFile(targetEnvFile);
        }

        let result: string = manifestContent;

        let prefix1: string = "ENV::[";
        let idx1: int = (int)result.find(prefix1);
        while (idx1 != -1) {
            let close1: int = (int)result.find("]", idx1 + 6);
            if (close1 == -1) break;
            let varName: string = result.substr(idx1 + 6, close1 - (idx1 + 6));
            let resolved: string = "";
            let found: bool = false;
            let eCount: int = (int)envItems->length();
            for (let i: int = 0; i < eCount; i = i + 1) {
                let it: EnvItem* = envItems->get(i);
                if (it->key == varName) {
                    resolved = it->resolvedValue;
                    found = true;
                    break;
                }
            }
            if (!found) {
                let sysV: char* = (char*)std::getenv(varName.c_str());
                if (sysV != nullptr) resolved = std::string(sysV);
            }
            result = result.substr(0, idx1) + resolved + result.substr(close1 + 1);
            idx1 = (int)result.find(prefix1, idx1 + (int)resolved.length());
        }

        let prefix2: string = "ENV::";
        let idx2: int = (int)result.find(prefix2);
        while (idx2 != -1) {
            if (result.length() > idx2 + 5 && result.substr(idx2 + 5, 1) == "[") {
                idx2 = (int)result.find(prefix2, idx2 + 5);
                continue;
            }
            let endVar: int = (int)result.find("\"", idx2 + 5);
            if (endVar == -1) break;
            let varName: string = result.substr(idx2 + 5, endVar - (idx2 + 5));
            let resolved: string = "";
            let found: bool = false;
            let eCount: int = (int)envItems->length();
            for (let i: int = 0; i < eCount; i = i + 1) {
                let it: EnvItem* = envItems->get(i);
                if (it->key == varName) {
                    resolved = it->resolvedValue;
                    found = true;
                    break;
                }
            }
            if (!found) {
                let sysV: char* = (char*)std::getenv(varName.c_str());
                if (sysV != nullptr) resolved = std::string(sysV);
            }
            result = result.substr(0, idx2) + resolved + result.substr(endVar);
            idx2 = (int)result.find(prefix2, idx2 + (int)resolved.length());
        }

        return result;
    }
}

class ProcessEnv {
    public static get(key: string, defaultVal: string): string {
        return EnvManager::get(key, defaultVal);
    }

    public static set(key: string, val: string): void {
        EnvManager::set(key, val);
    }

    public static has(key: string): bool {
        return EnvManager::has(key);
    }

    public static getInt(key: string, defaultVal: int): int {
        return EnvManager::getInt(key, defaultVal);
    }

    public static getBool(key: string, defaultVal: bool): bool {
        return EnvManager::getBool(key, defaultVal);
    }

    public static getAllKeys(): Array<string>* {
        return EnvManager::getAllKeys();
    }

    public static autoLoad(manifestPath: string, explicitEnv: string): int {
        return EnvManager::autoLoad(manifestPath, explicitEnv);
    }

    public static loadFromPath(envFilePath: string): int {
        return EnvManager::loadFromPath(envFilePath);
    }

    public static clear(): void {
        EnvManager::clear();
    }
}

class ProcessEnvMap {
    public get(key: string, defaultVal: string): string {
        return ProcessEnv::get(key, defaultVal);
    }

    public set(key: string, val: string): void {
        ProcessEnv::set(key, val);
    }

    public has(key: string): bool {
        return ProcessEnv::has(key);
    }

    public getInt(key: string, defaultVal: int): int {
        return ProcessEnv::getInt(key, defaultVal);
    }

    public getBool(key: string, defaultVal: bool): bool {
        return ProcessEnv::getBool(key, defaultVal);
    }
}

class ProcessObject {
    public env: ProcessEnvMap;

    public constructor() {}
}

inline ProcessObject process;
