// CexPack Types and Data Structures (C-ext)

class ValidationError {
    public string ruleId;
    public string message;
    public int line;
    public int column;
    public string severity;

    public constructor(string rId, string msg, int l, int col, string sev) {
        this.ruleId = rId;
        this.message = msg;
        this.line = l;
        this.column = col;
        this.severity = sev;
    }
}

class ValidationResult {
    public bool isValid = true;
    public Array<ValidationError*>* errors = new Array<ValidationError*>();
    public Array<ValidationError*>* warnings = new Array<ValidationError*>();
    public int errorCount = 0;
    public int warningCount = 0;

    public constructor() {}

    public void addError(string ruleId, string msg, int line, int col) {
        this.isValid = false;
        this.errors->push(new ValidationError(ruleId, msg, line, col, "ERROR"));
        this.errorCount = this.errorCount + 1;
    }

    public void addWarning(string ruleId, string msg, int line, int col) {
        this.warnings->push(new ValidationError(ruleId, msg, line, col, "WARNING"));
        this.warningCount = this.warningCount + 1;
    }
}

class ThunderOutputPort {
    public int containerPort;
    public string containerPortStr;
    public int outPort;
    public string outPortStr;
    public string name;

    public constructor(int cPort, string cPortStr, int oPort, string oPortStr, string name) {
        this.containerPort = cPort;
        this.containerPortStr = cPortStr;
        this.outPort = oPort;
        this.outPortStr = oPortStr;
        this.name = name;
    }
}

class ThunderConfig {
    public bool isDefined = false;
    public string env = "";
    public Array<ThunderOutputPort*>* outputs = new Array<ThunderOutputPort*>();

    public constructor() {}

    public void addOutput(int cPort, string cPortStr, int oPort, string oPortStr, string name) {
        this.outputs->push(new ThunderOutputPort(cPort, cPortStr, oPort, oPortStr, name));
    }
}

class EnvItem {
    public string key;
    public string rawValue;
    public string resolvedValue;
    public bool isDynamic;
    public string sourceVarName;

    public constructor(string k, string rawVal, string resolvedVal, bool dynamic, string srcVar) {
        this.key = k;
        this.rawValue = rawVal;
        this.resolvedValue = resolvedVal;
        this.isDynamic = dynamic;
        this.sourceVarName = srcVar;
    }
}

class EnvMapping {
    public string environment;
    public string envPath;

    public constructor(string env, string path) {
        this.environment = env;
        this.envPath = path;
    }
}

class EnvConfigOptions {
    public Array<EnvMapping*>* envs = new Array<EnvMapping*>();
    public string activeEnvironment = "";

    public constructor() {}

    public void addEnv(string envName, string path) {
        this.envs->push(new EnvMapping(envName, path));
    }

    public string getPathForEnv(string envName) {
        int count = (int)this.envs->length();
        for (int i = 0; i < count; i = i + 1) {
            EnvMapping* m = this.envs->get(i);
            if (m->environment == envName) {
                return m->envPath;
            }
        }
        return "";
    }

    public bool hasEnv(string envName) {
        int count = (int)this.envs->length();
        for (int i = 0; i < count; i = i + 1) {
            EnvMapping* m = this.envs->get(i);
            if (m->environment == envName) {
                return true;
            }
        }
        return false;
    }
}

class CvmRepositoryConfig {
    public bool isDefined = false;
    public string type = "cvm";
    public string url = "";
    public string path = "cex-pack.json";
    public string branch = "main";

    public constructor() {}

    public constructor(string url, string p, string b) {
        this.isDefined = true;
        this.url = url;
        this.path = (p.length() > 0) ? p : "cex-pack.json";
        this.branch = (b.length() > 0) ? b : "main";
    }
}

class PackManifest {
    public string name = "";
    public string version = "";
    public string description = "";
    public string main = "";
    public string author = "";
    public string license = "";
    public string target = "";
    public bool hasRequired = false;
    public bool hasTarget = false;
    public bool hasDependencies = false;
    public ThunderConfig* thunder = new ThunderConfig();
    public EnvConfigOptions* envConfig = new EnvConfigOptions();
    public Array<EnvItem*>* processEnv = new Array<EnvItem*>();
    public bool hasEnvs = false;
    public bool hasProcessEnv = false;
    public CvmRepositoryConfig* cvmRepository = new CvmRepositoryConfig();
    public bool hasCvmRepository = false;

    public constructor() {}

    public void addEnvMapping(string envName, string path) {
        this.envConfig->addEnv(envName, path);
        this.hasEnvs = true;
    }

    public void addProcessEnvItem(string k, string rawVal, string resolvedVal, bool dynamic, string srcVar) {
        this.processEnv->push(new EnvItem(k, rawVal, resolvedVal, dynamic, srcVar));
        this.hasProcessEnv = true;
    }

    public void setCvmRepository(string url, string p, string b) {
        this.cvmRepository = new CvmRepositoryConfig(url, p, b);
        this.hasCvmRepository = true;
    }
}
