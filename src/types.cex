// CexPack Types and Data Structures (C-ext)

class ValidationError {
    public ruleId: string;
    public message: string;
    public line: int;
    public column: int;
    public severity: string; // "ERROR" | "WARNING"

    public constructor(rId: string, msg: string, l: int, col: int, sev: string) {
        this.ruleId = rId;
        this.message = msg;
        this.line = l;
        this.column = col;
        this.severity = sev;
    }
}

class ValidationResult {
    public isValid: bool = true;
    public errors: Array<ValidationError*>* = new Array<ValidationError*>();
    public warnings: Array<ValidationError*>* = new Array<ValidationError*>();
    public errorCount: int = 0;
    public warningCount: int = 0;

    public constructor() {}

    public addError(ruleId: string, msg: string, line: int, col: int): void {
        this.isValid = false;
        this.errors->push(new ValidationError(ruleId, msg, line, col, "ERROR"));
        this.errorCount = this.errorCount + 1;
    }

    public addWarning(ruleId: string, msg: string, line: int, col: int): void {
        this.warnings->push(new ValidationError(ruleId, msg, line, col, "WARNING"));
        this.warningCount = this.warningCount + 1;
    }
}

class ThunderOutputPort {
    public containerPort: int;
    public containerPortStr: string;
    public outPort: int;
    public outPortStr: string;
    public name: string;

    public constructor(cPort: int, cPortStr: string, oPort: int, oPortStr: string, name: string) {
        this.containerPort = cPort;
        this.containerPortStr = cPortStr;
        this.outPort = oPort;
        this.outPortStr = oPortStr;
        this.name = name;
    }
}

class ThunderConfig {
    public isDefined: bool = false;
    public env: string = "";
    public outputs: Array<ThunderOutputPort*>* = new Array<ThunderOutputPort*>();

    public constructor() {}

    public addOutput(cPort: int, cPortStr: string, oPort: int, oPortStr: string, name: string): void {
        this.outputs->push(new ThunderOutputPort(cPort, cPortStr, oPort, oPortStr, name));
    }
}

class EnvItem {
    public key: string;
    public rawValue: string;
    public resolvedValue: string;
    public isDynamic: bool;
    public sourceVarName: string;

    public constructor(k: string, rawVal: string, resolvedVal: string, dynamic: bool, srcVar: string) {
        this.key = k;
        this.rawValue = rawVal;
        this.resolvedValue = resolvedVal;
        this.isDynamic = dynamic;
        this.sourceVarName = srcVar;
    }
}

class EnvMapping {
    public environment: string;
    public envPath: string;

    public constructor(env: string, path: string) {
        this.environment = env;
        this.envPath = path;
    }
}

class EnvConfigOptions {
    public envs: Array<EnvMapping*>* = new Array<EnvMapping*>();
    public activeEnvironment: string = "";

    public constructor() {}

    public addEnv(envName: string, path: string): void {
        this.envs->push(new EnvMapping(envName, path));
    }

    public getPathForEnv(envName: string): string {
        let count: int = (int)this.envs->length();
        for (let i: int = 0; i < count; i = i + 1) {
            let m: EnvMapping* = this.envs->get(i);
            if (m->environment == envName) {
                return m->envPath;
            }
        }
        return "";
    }

    public hasEnv(envName: string): bool {
        let count: int = (int)this.envs->length();
        for (let i: int = 0; i < count; i = i + 1) {
            let m: EnvMapping* = this.envs->get(i);
            if (m->environment == envName) {
                return true;
            }
        }
        return false;
    }
}

class CvmRepositoryConfig {
    public isDefined: bool = false;
    public type: string = "cvm";
    public url: string = "";
    public path: string = "cex-pack.json";
    public branch: string = "main";

    public constructor() {}

    public constructor(url: string, p: string, b: string) {
        this.isDefined = true;
        this.url = url;
        this.path = (p.length() > 0) ? p : "cex-pack.json";
        this.branch = (b.length() > 0) ? b : "main";
    }
}

class PackManifest {
    public name: string = "";
    public version: string = "";
    public description: string = "";
    public main: string = "";
    public author: string = "";
    public license: string = "";
    public target: string = "";
    public hasRequired: bool = false;
    public hasTarget: bool = false;
    public hasDependencies: bool = false;
    public thunder: ThunderConfig* = new ThunderConfig();
    public envConfig: EnvConfigOptions* = new EnvConfigOptions();
    public processEnv: Array<EnvItem*>* = new Array<EnvItem*>();
    public hasEnvs: bool = false;
    public hasProcessEnv: bool = false;
    public cvmRepository: CvmRepositoryConfig* = new CvmRepositoryConfig();
    public hasCvmRepository: bool = false;

    public constructor() {}

    public addEnvMapping(envName: string, path: string): void {
        this.envConfig->addEnv(envName, path);
        this.hasEnvs = true;
    }

    public addProcessEnvItem(k: string, rawVal: string, resolvedVal: string, dynamic: bool, srcVar: string): void {
        this.processEnv->push(new EnvItem(k, rawVal, resolvedVal, dynamic, srcVar));
        this.hasProcessEnv = true;
    }

    public setCvmRepository(url: string, p: string, b: string): void {
        this.cvmRepository = new CvmRepositoryConfig(url, p, b);
        this.hasCvmRepository = true;
    }
}
