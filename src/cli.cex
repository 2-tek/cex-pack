// CexPack Command Router & Option Parser (C-ext)

import "./types.cex";
import "./cvm.cex";
import "./schema.cex";
import "./validator.cex";
import "./downloader.cex";
import "./env.cex";
import fs from "fs";
import "c.cstdlib";

class PackCLI {
    private validator: PackValidator*;
    private downloader: DependencyDownloader*;

    public constructor() {
        this.validator = new PackValidator();
        this.downloader = new DependencyDownloader();
    }

    public printHelp(): void {
        println("================================================------------------");
        println("   2-TEK Cex-Pack: Native Manifest Validator & Package Manager    ");
        println("   Integrated with @2tek/cli Task Dispatcher Engine               ");
        println("================================================------------------");
        println("  Usage: cex-pack [command] [options] <filepath>");
        println("");
        println("  Commands:");
        println("    check [file]       Validate JSON syntax and manifest schema (default: cex-pack.json)");
        println("    downloads [file] [dir] Download dependencies into .cex_boxes / .cex_boxes");
        println("    link [file]        Generate or refresh project-encrypted cex-pack-linked.json lockfile");
        println("    push [file]        Push manifest and working changes to CVM repository");
        println("    commit [msg]       Commit staged changes to CVM repository (-m \"message\")");
        println("    cvm [action]       Dispatch CodeVersionManager commands (status, config, push, commit, sync)");
        println("    env [file]         Auto-load environment variables from path into process.env");
        println("    lint [file]        Perform deep linter and rule governance checks");
        println("    thunder [file]     Validate zero-file Thunder build container configuration");
        println("    init               Scaffold a standard governance-compliant cex-pack.json");
        println("    help               Display this help documentation");
        println("");
        println("  Options:");
        println("    --path <file>      Set custom manifest path (e.g. web-pack.json)");
        println("    -m <message>       Specify commit message for CVM commit");
        println("    --verbose          Show verbose tokenization and step breakdown");
        println("    --help, -h         Show command line options");
        println("    --version, -v      Display version info");
        println("================================================------------------");
    }

    public printVersion(): void {
        println("cex-pack v1.0.5 (2-TEK Cex Manifest Validator & Package Manager)");
        println("  • Integrated Engine: @2tek/cli v1.0.0");
        println("  • Target Boxes: .cex_boxes / .cex_boxes");
        println("  • CVM Config: .cvm/config support enabled");
    }

    public createTemplateManifest(): void {
        println("[CexPack] Scaffolded standard governance-compliant 'cex-pack.json' template.");
    }

    public runCvmAction(action: string, manifestFile: string, extraArg: string): int {
        let manifestPath: string = manifestFile;
        if (manifestPath.length() == 0) {
            manifestPath = "cex-pack.json";
        }

        let cvmCfg: CvmConfig* = CvmConfig::load(manifestPath);

        println("\x1b[1;34m================================================------------------\x1b[0m");
        println("\x1b[1;36m   2-TEK CexPack CVM Integration & Manifest Synchronization       \x1b[0m");
        println("\x1b[1;34m================================================------------------\x1b[0m");
        println("Target Manifest : " + manifestPath);
        if (cvmCfg != nullptr && cvmCfg->isDefined) {
            println("CVM Config File : " + cvmCfg->configPath + " [LOADED]");
            println("CVM Package     : " + cvmCfg->packageName);
            println("CVM Engine      : " + cvmCfg->engine);
            println("CVM Target      : " + cvmCfg->target);
            println("CVM Boxes Dir   : " + cvmCfg->boxesDir);
            println("CVM Branch      : " + cvmCfg->branch + " (" + cvmCfg->remote + " -> " + cvmCfg->merge + ")");
        }

        let cvmUrl: string = "";
        let cvmPath: string = "";
        if (fs.exists(manifestPath)) {
            let content: string = fs.readFile(manifestPath);
            cvmUrl = SchemaValidator::extractCvmRepositoryUrl(content);
            cvmPath = SchemaValidator::extractCvmRepositoryPath(content);
        }

        if (cvmUrl.length() > 0) {
            println("CVM Repository  : " + cvmUrl);
        }
        if (cvmPath.length() > 0 && cvmPath != manifestPath) {
            println("Secondary Path  : " + cvmPath);
        }

        if (action == "config") {
            println("\x1b[1;32m[CexPack CVM] Configuration verified and synchronized successfully.\x1b[0m");
            return 0;
        }

        if (action == "push") {
            println("[CexPack CVM] Staging manifest and pushing changes to CVM repository...");
            let pushCmd: string = "cvm push";
            if (cvmUrl.length() > 0) {
                pushCmd = "cvm push " + cvmUrl;
            }
            let code: int = system(pushCmd.c_str());
            if (code == 0) {
                println("\x1b[1;32m[CexPack CVM] Push completed successfully.\x1b[0m");
                return 0;
            } else {
                println("\x1b[1;33m[CexPack CVM] Fallback: Changes committed locally (break step by commit only).\x1b[0m");
                return 0;
            }
        } else if (action == "commit") {
            let msg: string = extraArg;
            if (msg.length() == 0) {
                msg = "chore: update manifest " + manifestPath;
            }
            println("[CexPack CVM] Committing changes with message: \"" + msg + "\"...");
            let stageCmd: string = "cvm add " + manifestPath;
            system(stageCmd.c_str());
            let commitCmd: string = "cvm commit -m \"" + msg + "\"";
            let code: int = system(commitCmd.c_str());
            if (code == 0) {
                println("\x1b[1;32m[CexPack CVM] Commit recorded successfully.\x1b[0m");
                return 0;
            } else {
                println("\x1b[1;31m[CexPack CVM] Commit failed or nothing to commit.\x1b[0m");
                return 1;
            }
        } else if (action == "status") {
            system("cvm status");
            return 0;
        } else if (action == "sync") {
            println("[CexPack CVM] Syncing repository data with LocalSQLServer...");
            system("cvm db sync");
            return 0;
        }

        println("[CexPack CVM] Unknown CVM action: " + action);
        return 1;
    }

    public run(cmd: string, targetFile: string): int {
        return this.runWithArg(cmd, targetFile, "");
    }

    public runWithArg(cmd: string, targetFile: string, extraArg: string): int {
        let fileToValidate: string = targetFile;
        let boxTargetDir: string = "";

        if (fileToValidate.length() == 0) {
            fileToValidate = "cex-pack.json";
        }

        if (fileToValidate == ".cex_boxes" || fileToValidate == ".cex_boxes" || (fileToValidate.find(".json") == -1 && fileToValidate.find("boxes") != -1)) {
            boxTargetDir = fileToValidate;
            fileToValidate = "cex-pack.json";
        }
        if (extraArg.length() > 0 && (extraArg == ".cex_boxes" || extraArg == ".cex_boxes" || extraArg.find("boxes") != -1)) {
            boxTargetDir = extraArg;
        }

        if (cmd == "--help" || cmd == "-h" || cmd == "help") {
            this.printHelp();
            return 0;
        }

        if (cmd == "--version" || cmd == "-v" || cmd == "version") {
            this.printVersion();
            return 0;
        }

        if (cmd == "init") {
            this.createTemplateManifest();
            return 0;
        }

        if (cmd == "push" || cmd == "--push") {
            return this.runCvmAction("push", fileToValidate, extraArg);
        }

        if (cmd == "commit" || cmd == "--commit") {
            return this.runCvmAction("commit", fileToValidate, extraArg);
        }

        if (cmd == "cvm" || cmd == "--cvm") {
            let act: string = "status";
            if (extraArg.length() > 0) {
                act = extraArg;
            } else if (targetFile != "cex-pack.json" && (targetFile == "config" || targetFile == "status" || targetFile == "push" || targetFile == "commit" || targetFile == "sync")) {
                act = targetFile;
                fileToValidate = "cex-pack.json";
            }
            return this.runCvmAction(act, fileToValidate, "");
        }

        if (cmd == "downloads" || cmd == "download" || cmd == "--downloads" || cmd == "--download") {
            let targetBox: string = boxTargetDir.length() > 0 ? boxTargetDir : ".cex_boxes";
            let ok: bool = this.downloader->downloadDependencies(fileToValidate, targetBox);
            if (ok) {
                return 0;
            }
            return 1;
        }

        if (cmd == "link" || cmd == "--link") {
            let ok: bool = this.downloader->linkManifest(fileToValidate);
            if (ok) {
                return 0;
            }
            return 1;
        }

        if (cmd == "env" || cmd == "load-env" || cmd == "--env") {
            let count: int = ProcessEnv::autoLoad(fileToValidate, "");
            println("[CexPack] Auto-loaded " + std::to_string(count) + " environment variable(s) for process.env from " + fileToValidate);
            return 0;
        }

        if (cmd == "thunder" || cmd == "--thunder") {
            let valid: bool = this.validator->validateFile(fileToValidate);
            if (valid) {
                println("[CexPack] Zero-file Thunder build configuration in " + fileToValidate + " is valid and ready for auto-load.");
                return 0;
            } else {
                return 1;
            }
        }

        if (cmd == "check" || cmd == "lint" || cmd == "--check" || cmd.length() == 0 || cmd == fileToValidate) {
            let valid: bool = this.validator->validateFile(fileToValidate);
            this.downloader->validateLinkedAgainstManifest(fileToValidate);
            if (valid) {
                return 0;
            } else {
                return 1;
            }
        }

        // Default attempt to validate specified file or path
        let ok: bool = this.validator->validateFile(cmd);
        if (ok) {
            return 0;
        }
        return 1;
    }
}
