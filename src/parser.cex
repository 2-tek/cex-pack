// CexPack JSON Syntax Parser & Tokenizer (C-ext)

import "./types.cex";

class JsonParser {
    public string content;
    public int length;
    public int position;
    public int line;
    public int column;

    public JsonParser(string jsonStr) {
        this.content = jsonStr;
        this.length = (int)jsonStr.length();
        this.position = 0;
        this.line = 1;
        this.column = 1;
    }

    public ValidationResult* parseAndValidateSyntax() {
        let result: ValidationResult* = new ValidationResult();

        if (this.length == 0) {
            result->addError("SYNTAX_001", "Manifest file is completely empty", 1, 1);
            return result;
        }

        let braceDepth: int = 0;
        let bracketDepth: int = 0;
        let inString: bool = false;
        let isEscaped: bool = false;
        let currentLine: int = 1;
        let currentCol: int = 1;

        for (let i: int = 0; i < this.length; i = i + 1) {
            let ch: char = this.content[i];

            if (ch == '\n') {
                currentLine = currentLine + 1;
                currentCol = 1;
            } else {
                currentCol = currentCol + 1;
            }

            if (inString) {
                if (isEscaped) {
                    isEscaped = false;
                } else if (ch == '\\') {
                    isEscaped = true;
                } else if (ch == '"') {
                    inString = false;
                }
            } else {
                if (ch == '"') {
                    inString = true;
                } else if (ch == '{') {
                    braceDepth = braceDepth + 1;
                } else if (ch == '}') {
                    braceDepth = braceDepth - 1;
                    if (braceDepth < 0) {
                        result->addError("SYNTAX_BRACE_UNMATCHED", "Unexpected closing brace '}' without opening '{'", currentLine, currentCol);
                    }
                } else if (ch == '[') {
                    bracketDepth = bracketDepth + 1;
                } else if (ch == ']') {
                    bracketDepth = bracketDepth - 1;
                    if (bracketDepth < 0) {
                        result->addError("SYNTAX_BRACKET_UNMATCHED", "Unexpected closing bracket ']' without opening '['", currentLine, currentCol);
                    }
                }
            }
        }

        if (inString) {
            result->addError("SYNTAX_UNCLOSED_STRING", "Unterminated string literal in JSON manifest", currentLine, currentCol);
        }

        if (braceDepth != 0) {
            result->addError("SYNTAX_UNCLOSED_OBJECT", "Unclosed JSON object - missing closing brace '}'", currentLine, currentCol);
        }

        if (bracketDepth != 0) {
            result->addError("SYNTAX_UNCLOSED_ARRAY", "Unclosed JSON array - missing closing bracket ']'", currentLine, currentCol);
        }

        return result;
    }
}
