// @2tek/pack Main Entrypoint (C-ext)

import "./types.cex";
import "./parser.cex";
import "./schema.cex";
import "./reporter.cex";
import "./validator.cex";
import "./downloader.cex";
import "./cli.cex";

function main(args: Array<string>*): int {
    let cli: PackCLI* = new PackCLI();
    let cmd: string = "check";
    let targetFile: string = "cex-pack.json";

    let argc: int = (int)args->length();
    if (argc > 1) {
        cmd = args->get(1);
    }
    if (argc > 2) {
        targetFile = args->get(2);
    }

    return cli->run(cmd, targetFile);
}
