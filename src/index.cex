// @2tek/pack Main Entrypoint (C-ext)

import "./types.cex";
import "./parser.cex";
import "./schema.cex";
import "./reporter.cex";
import "./validator.cex";
import "./downloader.cex";
import "./env.cex";
import "./cli.cex";

fn main(argc: int, argv: char**): int {
    let cli: PackCLI* = new PackCLI();
    let cmd: string = "";
    let targetFile: string = "";
    let extraArg: string = "";

    for (let i: int = 1; i < argc; i = i + 1) {
        let arg: string = argv[i];
        if (arg == "--path" && i + 1 < argc) {
            targetFile = argv[i + 1];
            i = i + 1;
        } else if (arg.length() > 7 && arg.substr(0, 7) == "--path=") {
            targetFile = arg.substr(7, arg.length() - 7);
        } else if (arg == "-m" && i + 1 < argc) {
            extraArg = argv[i + 1];
            i = i + 1;
        } else if (arg.length() > 0 && arg.substr(0, 1) == "-") {
            if (cmd.length() == 0) {
                cmd = arg;
            }
        } else {
            if (cmd.length() == 0) {
                cmd = arg;
            } else if (targetFile.length() == 0) {
                targetFile = arg;
            } else if (extraArg.length() == 0) {
                extraArg = arg;
            }
        }
    }

    if (cmd.length() == 0) {
        cmd = "check";
    }
    if (targetFile.length() == 0) {
        targetFile = "cex-pack.json";
    }

    return cli->runWithArg(cmd, targetFile, extraArg);
}
