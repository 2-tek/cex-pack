// CexPack Manifest Schema Validator & Governance Rules (C-ext)

import "./types.cex";

class SchemaValidator {
    public SchemaValidator() {}

    public void validateManifestSchema(string content, ValidationResult* result) {
        // 1. Mandatory Property Check: "name"
        if (content.find("\"name\"") == -1) {
            result->addError("SCHEMA_MISSING_NAME", "Mandatory property 'name' is missing from cex-pack.json", 1, 1);
        }

        // 2. Mandatory Property Check: "version"
        if (content.find("\"version\"") == -1) {
            result->addError("SCHEMA_MISSING_VERSION", "Mandatory property 'version' is missing from cex-pack.json", 1, 1);
        }

        // 3. Mandatory Property Check: "main"
        if (content.find("\"main\"") == -1) {
            result->addError("SCHEMA_MISSING_MAIN", "Mandatory property 'main' is missing from cex-pack.json", 1, 1);
        }

        // 4. Rule 69 Enforcement: "target": "runtime"
        if (content.find("\"target\"") == -1) {
            result->addError("RULE_69_MISSING_TARGET", "Rule 69 Violation: Mandatory property 'target' is missing. Must be set to \"runtime\"", 1, 1);
        } else if (content.find("\"target\": \"runtime\"") == -1 && content.find("\"target\":\ \"runtime\"") == -1) {
            result->addError("RULE_69_INVALID_TARGET", "Rule 69 Violation: Property 'target' must strictly be set to \"runtime\"", 1, 1);
        }

        // 5. Engine requirements check: "required"
        if (content.find("\"required\"") == -1) {
            result->addWarning("SCHEMA_RECOMMEND_REQUIRED", "Manifest is missing 'required' block defining engine dependencies (e.g. cexr, cexp)", 1, 1);
        }

        // 6. Recommendation check: scope format
        if (content.find("\"name\": \"@") == -1 && content.find("\"name\":\ \"@") == -1) {
            result->addWarning("RECOMMEND_SCOPED_NAME", "Package name should ideally use a scoped identifier (e.g., @2tek/... or @cex-...)", 1, 1);
        }
    }

    public void validateEofNewline(string content, ValidationResult* result) {
        let len: int = (int)content.length();
        if (len == 0) {
            return;
        }

        if (content[len - 1] != '\n') {
            result->addError("RULE_29_NO_EOF_NEWLINE", "Rule 29 Violation: Manifest file must end with a single trailing newline ('\\n')", 1, 1);
        }
    }
}
