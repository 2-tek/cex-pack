// CexPack Manifest Schema Validator & Governance Rules (C-ext)

import "./types.cex";

class SchemaValidator {
    public constructor() {}

    public validateManifestSchema(content: string, result: ValidationResult*): void {
        // 1. Mandatory Property Check: "name"
        if (content.find("\"name\"") == -1) {
            result->addError("SCHEMA_MISSING_NAME", "Mandatory property 'name' is missing from cex-pack.json", 1, 1);
        }

        // 2. Mandatory Property Check: "version"
        if (content.find("\"version\"") == -1) {
            result->addError("SCHEMA_MISSING_VERSION", "Mandatory property 'version' is missing from cex-pack.json", 1, 1);
        }

        // 3. Mandatory Property Check: "main"
        if (content.find("\"main\"") == -1) {
            result->addError("SCHEMA_MISSING_MAIN", "Mandatory property 'main' is missing from cex-pack.json", 1, 1);
        }

        // 4. Rule 69 Enforcement: "target": "runtime"
        if (content.find("\"target\"") == -1) {
            result->addError("RULE_69_MISSING_TARGET", "Rule 69 Violation: Mandatory property 'target' is missing. Must be set to \"runtime\"", 1, 1);
        } else if (content.find("\"target\": \"runtime\"") == -1 && content.find("\"target\":\"runtime\"") == -1) {
            result->addError("RULE_69_INVALID_TARGET", "Rule 69 Violation: Property 'target' must strictly be set to \"runtime\"", 1, 1);
        }

        // 5. Engine requirements check: "required"
        if (content.find("\"required\"") == -1) {
            result->addWarning("SCHEMA_RECOMMEND_REQUIRED", "Manifest is missing 'required' block defining engine dependencies (e.g. cexr, cexp)", 1, 1);
        }

        // 6. Recommendation check: scope format
        if (content.find("\"name\": \"@") == -1 && content.find("\"name\":\"@") == -1) {
            result->addWarning("RECOMMEND_SCOPED_NAME", "Package name should ideally use a scoped identifier (e.g., @2tek/... or @cex-...)", 1, 1);
        }

        // 7. Rule RULE_NO_EXTERNAL_INCLUDEDIRS: Prohibition of External and CexP/CexR includeDirs
        let incIdx: int = (int)content.find("\"includeDirs\"");
        if (incIdx != -1) {
            let openBracket: int = (int)content.find("[", incIdx);
            let closeBracket: int = (int)content.find("]", incIdx);
            if (openBracket != -1 && closeBracket != -1 && closeBracket > openBracket) {
                let incContent: string = content.substr(openBracket, closeBracket - openBracket + 1);
                if (incContent.find("..") != -1) {
                    result->addError("RULE_NO_EXTERNAL_INCLUDEDIRS", "Rule Violation: Manifest 'includeDirs' cannot contain parent traversal ('..'). Paths must stay within project root", 1, 1);
                }
                if (incContent.find("CexP") != -1 || incContent.find("CexR") != -1) {
                    result->addError("RULE_NO_CEXP_CEXR_INCLUDEDIRS", "Rule Violation: Manifest 'includeDirs' cannot reference CexP or CexR directly. Standard libraries are provided natively by the engine", 1, 1);
                }
            }
        }
    }

    public validateEofNewline(content: string, result: ValidationResult*): void {
        let len: int = (int)content.length();
        if (len == 0) {
            return;
        }

        if (content.substr(len - 1, 1) != "\n") {
            result->addError("RULE_29_NO_EOF_NEWLINE", "Rule 29 Violation: Manifest file must end with a single trailing newline ('\\n')", 1, 1);
        }
    }

    public validateThunderRule(content: string, result: ValidationResult*): void {
        let thunIdx: int = (int)content.find("\"thunder\"");
        if (thunIdx == -1) {
            return;
        }

        // Rule: Quick Define Thunder Build Without Any File (RULE_THUNDER_QUICK_DEFINE)
        let envIdx: int = (int)content.find("\"env\"", thunIdx);
        if (envIdx != -1) {
            let colonIdx: int = (int)content.find(":", envIdx);
            if (colonIdx == -1) {
                result->addError("RULE_THUNDER_INVALID_ENV", "Invalid 'env' property definition in thunder configuration", 1, 1);
            }
        }

        // Check output/ouput definition (supporting 'output' and shorthand 'ouput')
        let outIdx: int = (int)content.find("\"output\"", thunIdx);
        if (outIdx == -1) {
            outIdx = (int)content.find("\"ouput\"", thunIdx);
        }

        if (outIdx == -1) {
            result->addWarning("RULE_THUNDER_NO_OUTPUT", "Thunder configuration does not declare 'output' port mappings (default port 3000 will be used)", 1, 1);
        } else {
            let bracketIdx: int = (int)content.find("[", outIdx);
            let colonIdx: int = (int)content.find(":", outIdx);
            if (bracketIdx == -1 || (colonIdx != -1 && bracketIdx > colonIdx + 10)) {
                result->addError("RULE_THUNDER_INVALID_OUTPUT", "Thunder 'output' must be an array of port mappings: [{container: {PORT}, out: {PORT}, name: ...}]", 1, 1);
            } else {
                let closeBracket: int = (int)content.find("]", bracketIdx);
                if (closeBracket != -1) {
                    let outSub: string = content.substr(bracketIdx, closeBracket - bracketIdx + 1);
                    if (outSub.find("\"container\"") == -1) {
                        result->addError("RULE_THUNDER_MISSING_CONTAINER_PORT", "Thunder output mapping missing mandatory 'container' port definition", 1, 1);
                    }
                    if (outSub.find("\"out\"") == -1) {
                        result->addError("RULE_THUNDER_MISSING_OUT_PORT", "Thunder output mapping missing mandatory 'out' host port definition", 1, 1);
                    }
                }
            }
        }
    }

    public validateEnvsRule(content: string, result: ValidationResult*): void {
        let envsIdx: int = (int)content.find("\"envs\"");
        if (envsIdx == -1) {
            return;
        }

        let colonIdx: int = (int)content.find(":", envsIdx);
        if (colonIdx == -1) {
            result->addError("RULE_ENVS_INVALID_FORMAT", "Manifest 'envs' must be followed by ':' and an object of environment paths", 1, 1);
            return;
        }

        let nextOpen: int = (int)content.find("{", colonIdx);
        let nextQuote: int = (int)content.find("\"", colonIdx);
        let nextBracket: int = (int)content.find("[", colonIdx);

        if (nextOpen == -1 || (nextQuote != -1 && nextQuote < nextOpen) || (nextBracket != -1 && nextBracket < nextOpen)) {
            result->addError("RULE_ENVS_INVALID_TYPE", "Manifest 'envs' configuration must be an object: { [environmentName]: [root env path] }", 1, 1);
        }
    }

    public validateProcessEnvRule(content: string, result: ValidationResult*): void {
        let pos: int = 0;
        let cLen: int = (int)content.length();
        let targetPrefix: string = "ENV::[";
        while (pos < cLen) {
            let idx: int = (int)content.find(targetPrefix, pos);
            if (idx == -1) {
                break;
            }
            let nextQuote: int = (int)content.find("\"", idx);
            let nextClose: int = (int)content.find("]", idx);
            if (nextClose == -1 || (nextQuote != -1 && nextClose > nextQuote)) {
                result->addError("SCHEMA_UNCLOSED_ENV_BRACKET", "Unclosed bracket in ENV::[variableName] expression in manifest", 1, 1);
            } else if (nextClose == idx + 6) {
                result->addError("SCHEMA_EMPTY_ENV_VAR_NAME", "Empty environment variable name in ENV::[] expression in manifest", 1, 1);
            }
            pos = idx + 6;
        }

        if (content.find("\"ENV::\"") != -1) {
            result->addError("SCHEMA_EMPTY_ENV_VAR_NAME", "Empty environment variable name in ENV:: expression in manifest", 1, 1);
        }
    }

    public validateCvmRepositoryRule(content: string, result: ValidationResult*): void {
        let cvmIdx: int = (int)content.find("\"cvm_repository\"");
        if (cvmIdx == -1) {
            return;
        }

        let colonIdx: int = (int)content.find(":", cvmIdx);
        if (colonIdx == -1) {
            result->addError("RULE_CVM_REPO_INVALID", "Invalid cvm_repository definition in manifest", 1, 1);
            return;
        }

        let cLen: int = (int)content.length();
        let valStart: int = -1;
        for (let i: int = colonIdx + 1; i < cLen; i = i + 1) {
            let ch: string = content.substr(i, 1);
            if (ch != " " && ch != "\t" && ch != "\r" && ch != "\n") {
                valStart = i;
                break;
            }
        }

        if (valStart == -1) {
            result->addError("RULE_CVM_REPO_EMPTY", "Empty cvm_repository configuration in manifest", 1, 1);
            return;
        }

        let firstChar: string = content.substr(valStart, 1);
        if (firstChar == "\"") {
            let endQuote: int = (int)content.find("\"", valStart + 1);
            if (endQuote == -1) {
                result->addError("RULE_CVM_REPO_UNCLOSED_STRING", "Unclosed string literal in cvm_repository", 1, 1);
                return;
            }
            let repoUrl: string = content.substr(valStart + 1, endQuote - valStart - 1);
            if (repoUrl.length() == 0) {
                result->addError("RULE_CVM_REPO_EMPTY_URL", "cvm_repository URL cannot be empty", 1, 1);
            }
        } else if (firstChar == "{") {
            let openBrace: int = valStart;
            let closeBrace: int = (int)content.find("}", openBrace);
            if (closeBrace == -1) {
                result->addError("RULE_CVM_REPO_UNCLOSED_OBJECT", "Unclosed object in cvm_repository configuration", 1, 1);
                return;
            }

            let objSub: string = content.substr(openBrace, closeBrace - openBrace + 1);

            let pathIdx: int = (int)objSub.find("\"path\"");
            if (pathIdx != -1) {
                let pColon: int = (int)objSub.find(":", pathIdx);
                if (pColon != -1) {
                    let pStart: int = (int)objSub.find("\"", pColon);
                    if (pStart != -1) {
                        let pEnd: int = (int)objSub.find("\"", pStart + 1);
                        if (pEnd != -1) {
                            let pathVal: string = objSub.substr(pStart + 1, pEnd - pStart - 1);
                            if (pathVal.length() == 0) {
                                result->addError("RULE_CVM_REPO_EMPTY_PATH", "cvm_repository path property cannot be empty", 1, 1);
                            }
                            if (pathVal.find("..") != -1) {
                                result->addError("RULE_CVM_REPO_PATH_TRAVERSAL", "cvm_repository path cannot contain parent traversal ('..')", 1, 1);
                            }
                        }
                    }
                }
            }

            let urlIdx: int = (int)objSub.find("\"url\"");
            if (urlIdx != -1) {
                let uColon: int = (int)objSub.find(":", urlIdx);
                if (uColon != -1) {
                    let uStart: int = (int)objSub.find("\"", uColon);
                    if (uStart != -1) {
                        let uEnd: int = (int)objSub.find("\"", uStart + 1);
                        if (uEnd != -1) {
                            let urlVal: string = objSub.substr(uStart + 1, uEnd - uStart - 1);
                            if (urlVal.length() == 0) {
                                result->addError("RULE_CVM_REPO_EMPTY_URL", "cvm_repository url property cannot be empty", 1, 1);
                            }
                        }
                    }
                }
            }
        } else {
            result->addError("RULE_CVM_REPO_INVALID_TYPE", "cvm_repository must be a URL string or an object with url, path (e.g. web-pack.json), and branch", 1, 1);
        }
    }

    public static extractCvmRepositoryPath(content: string): string {
        let cvmIdx: int = (int)content.find("\"cvm_repository\"");
        if (cvmIdx == -1) {
            return "cex-pack.json";
        }
        let pathIdx: int = (int)content.find("\"path\"", cvmIdx);
        if (pathIdx == -1) {
            return "cex-pack.json";
        }
        let colonIdx: int = (int)content.find(":", pathIdx);
        if (colonIdx == -1) {
            return "cex-pack.json";
        }
        let quoteStart: int = (int)content.find("\"", colonIdx);
        if (quoteStart == -1) {
            return "cex-pack.json";
        }
        let quoteEnd: int = (int)content.find("\"", quoteStart + 1);
        if (quoteEnd == -1) {
            return "cex-pack.json";
        }
        let pathVal: string = content.substr(quoteStart + 1, quoteEnd - quoteStart - 1);
        return (pathVal.length() > 0) ? pathVal : "cex-pack.json";
    }

    public static extractCvmRepositoryUrl(content: string): string {
        let cvmIdx: int = (int)content.find("\"cvm_repository\"");
        if (cvmIdx == -1) {
            return "";
        }
        let colonIdx: int = (int)content.find(":", cvmIdx);
        if (colonIdx == -1) {
            return "";
        }
        let openBrace: int = (int)content.find("{", colonIdx);
        let firstQuote: int = (int)content.find("\"", colonIdx);
        if (openBrace != -1 && (firstQuote == -1 || openBrace < firstQuote)) {
            let urlIdx: int = (int)content.find("\"url\"", openBrace);
            if (urlIdx != -1) {
                let uColon: int = (int)content.find(":", urlIdx);
                if (uColon != -1) {
                    let uQuoteStart: int = (int)content.find("\"", uColon);
                    if (uQuoteStart != -1) {
                        let uQuoteEnd: int = (int)content.find("\"", uQuoteStart + 1);
                        if (uQuoteEnd != -1) {
                            return content.substr(uQuoteStart + 1, uQuoteEnd - uQuoteStart - 1);
                        }
                    }
                }
            }
            return "";
        }
        if (firstQuote != -1) {
            let quoteEnd: int = (int)content.find("\"", firstQuote + 1);
            if (quoteEnd != -1) {
                return content.substr(firstQuote + 1, quoteEnd - firstQuote - 1);
            }
        }
        return "";
    }

    public static synthesizeThunderDockerfile(appName: string, mainPath: string, envPath: string, port: int): string {
        let dockerfile: string = "FROM @2tek/thunder:latest\n";
        dockerfile = dockerfile + "WORKDIR /app\n";
        dockerfile = dockerfile + "COPY . .\n";
        if (mainPath.length() > 0) {
            dockerfile = dockerfile + "RUN cexp build " + mainPath + " -O3 -o /app/bin/" + appName + "\n";
        }
        if (envPath.length() > 0) {
            dockerfile = dockerfile + "ENV DOTENV_CONFIG_PATH=" + envPath + "\n";
        }
        if (port > 0) {
            dockerfile = dockerfile + "EXPOSE " + std::to_string(port) + "\n";
            dockerfile = dockerfile + "ENV PORT=" + std::to_string(port) + "\n";
        }
        if (mainPath.length() > 0) {
            dockerfile = dockerfile + "CMD /app/bin/" + appName + "\n";
        } else {
            dockerfile = dockerfile + "CMD /app/bin/server\n";
        }
        return dockerfile;
    }
}
