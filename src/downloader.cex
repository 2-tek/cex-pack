// CexPack Dependency Downloader Engine (.cex_boxes) (C-ext)
// Supports cex-pack-linked.json version-to-download-URL encryption & locking

import "./types.cex";
import "./cvm.cex";
import "./parser.cex";
import "./schema.cex";
import "./validator.cex";
import fs from "fs";
import "cpp.string";
import "c.cstdlib";

class PackageDependency {
    public packageName: string;
    public versionSpec: string;
    public exactVersion: string;
    public downloadUrl: string;
    public encryptedUrl: string;
    public installedPath: string;
    public status: string;
    public currentSize: string;
    public totalSize: string;
    public percent: int;
    public linkedRef: string;

    public static cleanExactVersion(spec: string): string {
        let v: string = spec;
        while (v.length() > 0 && (v.substr(0, 1) == " " || v.substr(0, 1) == "\t")) {
            v = v.substr(1, v.length() - 1);
        }
        if (v.length() >= 2 && (v.substr(0, 2) == ">=" || v.substr(0, 2) == "<=" || v.substr(0, 2) == "==")) {
            v = v.substr(2, v.length() - 2);
        } else if (v.length() >= 1 && (v.substr(0, 1) == "^" || v.substr(0, 1) == "~" || v.substr(0, 1) == ">" || v.substr(0, 1) == "<" || v.substr(0, 1) == "=")) {
            v = v.substr(1, v.length() - 1);
        }
        while (v.length() > 0 && (v.substr(0, 1) == " " || v.substr(0, 1) == "\t")) {
            v = v.substr(1, v.length() - 1);
        }
        if (v.length() > 1 && (v.substr(0, 1) == "v" || v.substr(0, 1) == "V")) {
            let nextChar: string = v.substr(1, 1);
            if (nextChar >= "0" && nextChar <= "9") {
                v = v.substr(1, v.length() - 1);
            }
        }
        while (v.length() > 0 && (v.substr(v.length() - 1, 1) == " " || v.substr(v.length() - 1, 1) == "\t" || v.substr(v.length() - 1, 1) == "\r" || v.substr(v.length() - 1, 1) == "\n")) {
            v = v.substr(0, v.length() - 1);
        }
        let dotCount: int = 0;
        let vLen: int = (int)v.length();
        let allDigitsOrDots: bool = true;
        for (let i: int = 0; i < vLen; i = i + 1) {
            let ch: string = v.substr(i, 1);
            if (ch == ".") {
                dotCount = dotCount + 1;
            } else if (ch < "0" || ch > "9") {
                allDigitsOrDots = false;
            }
        }
        if (allDigitsOrDots && v.length() > 0) {
            if (dotCount == 0) {
                v = v + ".0.0";
            } else if (dotCount == 1) {
                v = v + ".0";
            }
        }
        return v;
    }

    public constructor(name: string, version: string) {
        this.packageName = name;
        this.versionSpec = version;
        this.exactVersion = PackageDependency::cleanExactVersion(version);
        this.downloadUrl = "";
        this.encryptedUrl = "";
        this.installedPath = "";
        this.status = "PENDING";
        this.currentSize = "0.00Mb";
        this.totalSize = "0.00Mb";
        this.percent = 0;
        this.linkedRef = "cex-pack-linked.json";
    }
}

class DependencyDownloader {
    private validator: PackValidator*;

    public constructor() {
        this.validator = new PackValidator();
    }

    public static mkdirRecursive(dirPath: string): void {
        if (dirPath.length() == 0 || fs.exists(dirPath)) {
            return;
        }
        let len: int = (int)dirPath.length();
        let cur: string = "";
        for (let i: int = 0; i < len; i = i + 1) {
            let ch: string = dirPath.substr(i, 1);
            if (ch == "/" && cur.length() > 0) {
                if (!fs.exists(cur)) {
                    fs.mkdir(cur);
                }
            }
            cur = cur + ch;
        }
        if (cur.length() > 0 && !fs.exists(cur)) {
            fs.mkdir(cur);
        }
    }

    public static resolveDefaultBoxDirectory(manifestPath: string, cvmConfig: CvmConfig*): string {
        let parentDir: string = "";
        let lastSlash: int = -1;
        let len: int = (int)manifestPath.length();
        for (let i: int = 0; i < len; i = i + 1) {
            if (manifestPath.substr(i, 1) == "/") {
                lastSlash = i;
            }
        }
        if (lastSlash != -1) {
            parentDir = manifestPath.substr(0, lastSlash) + "/";
        }

        if (cvmConfig != nullptr && cvmConfig->isDefined && cvmConfig->boxesDir.length() > 0) {
            return cvmConfig->boxesDir;
        }

        if (fs.exists(parentDir + ".cexboxes") || fs.exists(".cexboxes")) {
            return ".cexboxes";
        }

        if (fs.exists(parentDir + ".cex_boxes") || fs.exists(".cex_boxes")) {
            return ".cex_boxes";
        }

        return ".cexboxes";
    }

    private resolveProjectTargetBoxDir(manifestPath: string, targetBoxDir: string): string {
        let actualBoxDir: string = targetBoxDir;
        if (actualBoxDir.length() == 0 || actualBoxDir == ".cex_boxes") {
            let cvmCfg: CvmConfig* = CvmConfig::load(manifestPath);
            actualBoxDir = DependencyDownloader::resolveDefaultBoxDirectory(manifestPath, cvmCfg);
        }
        if (actualBoxDir.length() > 0 && actualBoxDir.substr(0, 1) == "/") {
            return actualBoxDir;
        }
        let lastSlash: int = -1;
        let len: int = (int)manifestPath.length();
        for (let i: int = 0; i < len; i = i + 1) {
            if (manifestPath.substr(i, 1) == "/") {
                lastSlash = i;
            }
        }
        if (lastSlash != -1) {
            let parentDir: string = manifestPath.substr(0, lastSlash);
            if (actualBoxDir.find(parentDir) == 0) {
                return actualBoxDir;
            }
            if (actualBoxDir.length() >= 6 && actualBoxDir.substr(0, 6) == "tests/") {
                return actualBoxDir;
            }
            return parentDir + "/" + actualBoxDir;
        }
        return actualBoxDir;
    }

    private resolveLinkedManifestPath(manifestPath: string): string {
        let lastSlash: int = -1;
        let len: int = (int)manifestPath.length();
        for (let i: int = 0; i < len; i = i + 1) {
            if (manifestPath.substr(i, 1) == "/") {
                lastSlash = i;
            }
        }
        if (lastSlash != -1) {
            let parentDir: string = manifestPath.substr(0, lastSlash);
            return parentDir + "/cex-pack-linked.json";
        }
        return "cex-pack-linked.json";
    }

    public static stripScopeAlias(pkgName: string): string {
        let result: string = pkgName;
        if (result.length() > 0 && result.substr(0, 1) == "@") {
            let slashPos: int = result.find("/");
            if (slashPos != -1) {
                result = result.substr(slashPos + 1, result.length() - slashPos - 1);
            } else {
                result = result.substr(1, result.length() - 1);
            }
        }
        return result;
    }

    public parseDependenciesFromBlockKey(manifestContent: string, keyName: string, deps: Array<PackageDependency*>*): void {
        let depIndex: int = manifestContent.find(keyName);
        if (depIndex == -1) {
            return;
        }

        let openBrace: int = manifestContent.find("{", depIndex);
        let closeBrace: int = manifestContent.find("}", openBrace);
        if (openBrace == -1 || closeBrace == -1 || closeBrace <= openBrace) {
            return;
        }

        let depBlock: string = manifestContent.substr(openBrace + 1, closeBrace - openBrace - 1);
        let len: int = (int)depBlock.length();
        let pos: int = 0;

        while (pos < len) {
            let keyStart: int = depBlock.find("\"", pos);
            if (keyStart == -1) break;

            let keyEnd: int = depBlock.find("\"", keyStart + 1);
            if (keyEnd == -1) break;

            let pkgName: string = depBlock.substr(keyStart + 1, keyEnd - keyStart - 1);

            let colonPos: int = depBlock.find(":", keyEnd + 1);
            if (colonPos == -1) break;

            let valStart: int = depBlock.find("\"", colonPos + 1);
            if (valStart == -1) break;

            let valEnd: int = depBlock.find("\"", valStart + 1);
            if (valEnd == -1) break;

            let versionSpec: string = depBlock.substr(valStart + 1, valEnd - valStart - 1);

            let exists: bool = false;
            let dCount: int = (int)deps->length();
            for (let i: int = 0; i < dCount; i = i + 1) {
                let existingDep: PackageDependency* = deps->get(i);
                if (existingDep->packageName == pkgName) {
                    exists = true;
                    break;
                }
            }
            if (!exists) {
                deps->push(new PackageDependency(pkgName, versionSpec));
            }

            pos = valEnd + 1;
        }
    }

    public parseDependenciesFromManifest(manifestContent: string): Array<PackageDependency*>* {
        let deps: Array<PackageDependency*>* = new Array<PackageDependency*>();
        this.parseDependenciesFromBlockKey(manifestContent, "\"cex-boxes\"", deps);
        this.parseDependenciesFromBlockKey(manifestContent, "\"dependencies\"", deps);
        this.parseDependenciesFromBlockKey(manifestContent, "\"boxes\"", deps);
        return deps;
    }

    public writeProgressFile(resolvedBoxDir: string, deps: Array<PackageDependency*>*, totalSizeStr: string, overallPercent: int): void {
        let progressPath: string = resolvedBoxDir + "/PROGRESS.md";
        let content: string = "current: " + totalSizeStr + "\n";
        let boxDirName: string = ".cexboxes";
        let lastSlash: int = -1;
        let bLen: int = (int)resolvedBoxDir.length();
        for (let i: int = 0; i < bLen; i = i + 1) {
            if (resolvedBoxDir.substr(i, 1) == "/") {
                lastSlash = i;
            }
        }
        if (lastSlash != -1) {
            boxDirName = resolvedBoxDir.substr(lastSlash + 1, resolvedBoxDir.length() - lastSlash - 1);
        } else if (resolvedBoxDir.length() > 0) {
            boxDirName = resolvedBoxDir;
        }
        content = content + boxDirName + " -> PROGRESS.md\n\n";

        let len: int = (int)deps->length();
        for (let i: int = 0; i < len; i = i + 1) {
            let dep: PackageDependency* = deps->get(i);
            let line: string = "[" + dep->status + "][" + std::to_string(dep->percent) + "%][" + dep->currentSize + "][" + dep->totalSize + "][" + dep->packageName + "][" + dep->linkedRef + "]\n";
            content = content + line;
        }

        content = content + "\nsummary:[" + totalSizeStr + "][" + totalSizeStr + "][" + std::to_string(overallPercent) + "%]\n";
        fs.writeFile(progressPath, content);
    }

    public static safeParseInt(s: string): int {
        let val: int = 0;
        let len: int = (int)s.length();
        let foundDigit: bool = false;
        for (let i: int = 0; i < len; i = i + 1) {
            let ch: string = s.substr(i, 1);
            if (ch >= "0" && ch <= "9") {
                val = val * 10 + std::stoi(ch);
                foundDigit = true;
            } else if (foundDigit) {
                break;
            }
        }
        return val;
    }

    public static parseVersionTriplet(ver: string, outMajor: int&, outMinor: int&, outPatch: int&): void {
        let clean: string = PackageDependency::cleanExactVersion(ver);
        outMajor = 0;
        outMinor = 0;
        outPatch = 0;
        let dot1: int = clean.find(".");
        if (dot1 == -1) {
            if (clean.length() > 0) {
                outMajor = DependencyDownloader::safeParseInt(clean);
            }
            return;
        }
        let majStr: string = clean.substr(0, dot1);
        if (majStr.length() > 0) {
            outMajor = DependencyDownloader::safeParseInt(majStr);
        }
        let dot2: int = clean.find(".", dot1 + 1);
        if (dot2 == -1) {
            let minStr: string = clean.substr(dot1 + 1, clean.length() - dot1 - 1);
            if (minStr.length() > 0) {
                outMinor = DependencyDownloader::safeParseInt(minStr);
            }
            return;
        }
        let minStr: string = clean.substr(dot1 + 1, dot2 - dot1 - 1);
        if (minStr.length() > 0) {
            outMinor = DependencyDownloader::safeParseInt(minStr);
        }
        let patStr: string = clean.substr(dot2 + 1, clean.length() - dot2 - 1);
        if (patStr.length() > 0) {
            outPatch = DependencyDownloader::safeParseInt(patStr);
        }
    }

    public static isVersionMatch(lockedVersion: string, versionSpec: string): bool {
        if (versionSpec.length() == 0 || versionSpec == lockedVersion) {
            return true;
        }
        let cleanLocked: string = PackageDependency::cleanExactVersion(lockedVersion);
        let cleanSpec: string = PackageDependency::cleanExactVersion(versionSpec);
        if (cleanLocked == cleanSpec) {
            return true;
        }

        let lMaj: int = 0;
        let lMin: int = 0;
        let lPat: int = 0;
        DependencyDownloader::parseVersionTriplet(lockedVersion, lMaj, lMin, lPat);

        let sMaj: int = 0;
        let sMin: int = 0;
        let sPat: int = 0;
        DependencyDownloader::parseVersionTriplet(versionSpec, sMaj, sMin, sPat);

        let trimmedSpec: string = versionSpec;
        while (trimmedSpec.length() > 0 && (trimmedSpec.substr(0, 1) == " " || trimmedSpec.substr(0, 1) == "\t")) {
            trimmedSpec = trimmedSpec.substr(1, trimmedSpec.length() - 1);
        }

        if (trimmedSpec.substr(0, 1) == "^") {
            if (lMaj != sMaj) {
                return false;
            }
            if (lMin < sMin) {
                return false;
            }
            if (lMin == sMin && lPat < sPat) {
                return false;
            }
            return true;
        } else if (trimmedSpec.substr(0, 1) == "~") {
            if (lMaj != sMaj || lMin != sMin) {
                return false;
            }
            return lPat >= sPat;
        } else if (trimmedSpec.length() >= 2 && trimmedSpec.substr(0, 2) == ">=") {
            if (lMaj > sMaj) return true;
            if (lMaj == sMaj && lMin > sMin) return true;
            if (lMaj == sMaj && lMin == sMin && lPat >= sPat) return true;
            return false;
        } else if (trimmedSpec.length() >= 2 && trimmedSpec.substr(0, 2) == "<=") {
            if (lMaj < sMaj) return true;
            if (lMaj == sMaj && lMin < sMin) return true;
            if (lMaj == sMaj && lMin == sMin && lPat <= sPat) return true;
            return false;
        }

        return cleanLocked == cleanSpec;
    }

    public static extractDependencyBlock(linkedContent: string): string {
        let depIndex: int = linkedContent.find("\"cex-boxes\"");
        if (depIndex == -1) {
            depIndex = linkedContent.find("\"dependencies\"");
        }
        if (depIndex == -1) {
            depIndex = linkedContent.find("\"boxes\"");
        }
        if (depIndex == -1) {
            return "";
        }
        let openBrace: int = linkedContent.find("{", depIndex);
        if (openBrace == -1) {
            return "";
        }
        let len: int = (int)linkedContent.length();
        let depth: int = 1;
        let inString: bool = false;
        let closeBrace: int = -1;
        for (let i: int = openBrace + 1; i < len; i = i + 1) {
            let ch: string = linkedContent.substr(i, 1);
            if (ch == "\"") {
                let backslashCount: int = 0;
                let k: int = i - 1;
                while (k >= 0 && linkedContent.substr(k, 1) == "\\") {
                    backslashCount = backslashCount + 1;
                    k = k - 1;
                }
                if (backslashCount % 2 == 0) {
                    inString = !inString;
                }
            } else if (!inString) {
                if (ch == "{") {
                    depth = depth + 1;
                } else if (ch == "}") {
                    depth = depth - 1;
                    if (depth == 0) {
                        closeBrace = i;
                        break;
                    }
                }
            }
        }
        if (closeBrace != -1) {
            return linkedContent.substr(openBrace, closeBrace - openBrace + 1);
        }
        return linkedContent.substr(openBrace);
    }

    public static extractLockedVersion(linkedContent: string, pkgName: string): string {
        if (linkedContent.length() == 0 || pkgName.length() == 0) {
            return "";
        }
        let depBlock: string = DependencyDownloader::extractDependencyBlock(linkedContent);
        if (depBlock.length() == 0) {
            return "";
        }

        let cleanPkg: string = DependencyDownloader::stripScopeAlias(pkgName);
        let candidates: Array<string>* = new Array<string>();
        candidates->push(pkgName);
        if (cleanPkg != pkgName) {
            candidates->push(cleanPkg);
            candidates->push("@" + cleanPkg);
            candidates->push("@2tek/" + cleanPkg);
        } else {
            candidates->push("@" + cleanPkg);
            candidates->push("@2tek/" + cleanPkg);
        }

        let cCount: int = (int)candidates->length();
        for (let c: int = 0; c < cCount; c = c + 1) {
            let candidate: string = candidates->get(c);
            let needle: string = "\"" + candidate + "\"";
            let pos: int = 0;
            let dLen: int = (int)depBlock.length();
            while (pos < dLen) {
                let pkgPos: int = depBlock.find(needle, pos);
                if (pkgPos == -1) {
                    break;
                }
                let colonPos: int = depBlock.find(":", pkgPos + (int)needle.length());
                if (colonPos != -1) {
                    let between: string = depBlock.substr(pkgPos + needle.length(), colonPos - (pkgPos + needle.length()));
                    let onlyWs: bool = true;
                    let bLen: int = (int)between.length();
                    for (let b: int = 0; b < bLen; b = b + 1) {
                        let bCh: string = between.substr(b, 1);
                        if (bCh != " " && bCh != "\t" && bCh != "\r" && bCh != "\n") {
                            onlyWs = false;
                        }
                    }
                    if (onlyWs) {
                        let valStart: int = -1;
                        for (let v: int = colonPos + 1; v < dLen; v = v + 1) {
                            let vCh: string = depBlock.substr(v, 1);
                            if (vCh != " " && vCh != "\t" && vCh != "\r" && vCh != "\n") {
                                valStart = v;
                                break;
                            }
                        }
                        if (valStart != -1) {
                            let firstCh: string = depBlock.substr(valStart, 1);
                            if (firstCh == "\"") {
                                let endQ: int = depBlock.find("\"", valStart + 1);
                                if (endQ != -1) {
                                    return depBlock.substr(valStart + 1, endQ - valStart - 1);
                                }
                            } else if (firstCh == "{") {
                                let objEnd: int = depBlock.find("}", valStart);
                                if (objEnd != -1) {
                                    let subObj: string = depBlock.substr(valStart, objEnd - valStart + 1);
                                    let vIdx: int = subObj.find("\"version\"");
                                    if (vIdx != -1) {
                                        let vColon: int = subObj.find(":", vIdx);
                                        if (vColon != -1) {
                                            let q1: int = subObj.find("\"", vColon + 1);
                                            if (q1 != -1) {
                                                let q2: int = subObj.find("\"", q1 + 1);
                                                if (q2 != -1) {
                                                    return subObj.substr(q1 + 1, q2 - q1 - 1);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                pos = pkgPos + 1;
            }
        }

        return "";
    }

    public static extractLockedUrl(linkedContent: string, pkgName: string): string {
        if (linkedContent.length() == 0 || pkgName.length() == 0) {
            return "";
        }
        let depBlock: string = DependencyDownloader::extractDependencyBlock(linkedContent);
        if (depBlock.length() == 0) {
            return "";
        }

        let cleanPkg: string = DependencyDownloader::stripScopeAlias(pkgName);
        let candidates: Array<string>* = new Array<string>();
        candidates->push(pkgName);
        if (cleanPkg != pkgName) {
            candidates->push(cleanPkg);
            candidates->push("@" + cleanPkg);
            candidates->push("@2tek/" + cleanPkg);
        } else {
            candidates->push("@" + cleanPkg);
            candidates->push("@2tek/" + cleanPkg);
        }

        let cCount: int = (int)candidates->length();
        for (let c: int = 0; c < cCount; c = c + 1) {
            let candidate: string = candidates->get(c);
            let needle: string = "\"" + candidate + "\"";
            let pos: int = 0;
            let dLen: int = (int)depBlock.length();
            while (pos < dLen) {
                let pkgPos: int = depBlock.find(needle, pos);
                if (pkgPos == -1) {
                    break;
                }
                let colonPos: int = depBlock.find(":", pkgPos + (int)needle.length());
                if (colonPos != -1) {
                    let between: string = depBlock.substr(pkgPos + needle.length(), colonPos - (pkgPos + needle.length()));
                    let onlyWs: bool = true;
                    let bLen: int = (int)between.length();
                    for (let b: int = 0; b < bLen; b = b + 1) {
                        let bCh: string = between.substr(b, 1);
                        if (bCh != " " && bCh != "\t" && bCh != "\r" && bCh != "\n") {
                            onlyWs = false;
                        }
                    }
                    if (onlyWs) {
                        let valStart: int = -1;
                        for (let v: int = colonPos + 1; v < dLen; v = v + 1) {
                            let vCh: string = depBlock.substr(v, 1);
                            if (vCh != " " && vCh != "\t" && vCh != "\r" && vCh != "\n") {
                                valStart = v;
                                break;
                            }
                        }
                        if (valStart != -1 && depBlock.substr(valStart, 1) == "{") {
                            let objEnd: int = depBlock.find("}", valStart);
                            if (objEnd != -1) {
                                let subObj: string = depBlock.substr(valStart, objEnd - valStart + 1);
                                let uIdx: int = subObj.find("\"url\"");
                                if (uIdx != -1) {
                                    let uColon: int = subObj.find(":", uIdx);
                                    if (uColon != -1) {
                                        let q1: int = subObj.find("\"", uColon + 1);
                                        if (q1 != -1) {
                                            let q2: int = subObj.find("\"", q1 + 1);
                                            if (q2 != -1) {
                                                return subObj.substr(q1 + 1, q2 - q1 - 1);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                pos = pkgPos + 1;
            }
        }

        return "";
    }

    public downloadDependencies(manifestPath: string, targetBoxDir: string): bool {
        let resolvedBoxDir: string = this.resolveProjectTargetBoxDir(manifestPath, targetBoxDir);
        let linkedPath: string = this.resolveLinkedManifestPath(manifestPath);

        let boxDirName: string = ".cexboxes";
        let lastSlash: int = -1;
        let bLen: int = (int)resolvedBoxDir.length();
        for (let i: int = 0; i < bLen; i = i + 1) {
            if (resolvedBoxDir.substr(i, 1) == "/") {
                lastSlash = i;
            }
        }
        if (lastSlash != -1) {
            boxDirName = resolvedBoxDir.substr(lastSlash + 1, resolvedBoxDir.length() - lastSlash - 1);
        } else if (resolvedBoxDir.length() > 0) {
            boxDirName = resolvedBoxDir;
        }

        println("\x1b[1;34m================================================------------------\x1b[0m");
        println("\x1b[1;36m   2-TEK CexPack Git/CVM Dependency Downloader (" + boxDirName + ")       \x1b[0m");
        println("   Linked Version Resolution Engine (cex-pack-linked.json)        ");
        println("\x1b[1;34m================================================------------------\x1b[0m");
        println("Target Manifest : " + manifestPath);
        println("Linked Manifest : " + linkedPath);
        println("Target Directory: " + resolvedBoxDir + "/\n");

        let cvmCfg: CvmConfig* = CvmConfig::load(manifestPath);
        if (cvmCfg != nullptr && cvmCfg->isDefined) {
            println("CVM Config File : " + cvmCfg->configPath + " [LOADED]");
            if (cvmCfg->packageName.length() > 0) {
                println("CVM Package     : " + cvmCfg->packageName);
            }
            if (cvmCfg->engine.length() > 0) {
                println("CVM Engine      : " + cvmCfg->engine);
            }
        }

        if (!fs.exists(manifestPath)) {
            println("\x1b[1;31m[ERROR] Could not read manifest file: " + manifestPath + "\x1b[0m");
            return false;
        }

        let manifestContent: string = fs.readFile(manifestPath);
        if (manifestContent.length() == 0) {
            println("\x1b[1;31m[ERROR] Could not read manifest file: " + manifestPath + "\x1b[0m");
            return false;
        }

        let deps: Array<PackageDependency*>* = this.parseDependenciesFromManifest(manifestContent);

        let cvmUrl: string = SchemaValidator::extractCvmRepositoryUrl(manifestContent);
        if (cvmUrl.length() > 0) {
            println("CVM Remote Repo : " + cvmUrl);
        }

        let cvmPath: string = SchemaValidator::extractCvmRepositoryPath(manifestContent);
        if (cvmPath.length() > 0 && cvmPath != "cex-pack.json" && cvmPath != manifestPath) {
            println("CVM Target Path : " + cvmPath);
            let lastSlash: int = -1;
            let len: int = (int)manifestPath.length();
            for (let i: int = 0; i < len; i = i + 1) {
                if (manifestPath.substr(i, 1) == "/") {
                    lastSlash = i;
                }
            }
            let secondaryPath: string = (lastSlash != -1) ? (manifestPath.substr(0, lastSlash) + "/" + cvmPath) : cvmPath;
            if (fs.exists(secondaryPath)) {
                println("  • [CVM] Parsing secondary dependencies from configured path: " + secondaryPath);
                let secContent: string = fs.readFile(secondaryPath);
                if (secContent.length() > 0) {
                    let secDeps: Array<PackageDependency*>* = this.parseDependenciesFromManifest(secContent);
                    let secTotal: int = (int)secDeps->length();
                    for (let s: int = 0; s < secTotal; s = s + 1) {
                        deps->push(secDeps->get(s));
                    }
                }
            }
        }

        let total: int = (int)deps->length();

        if (total == 0) {
            println("\x1b[1;33m[WARN] No dependencies declared in " + manifestPath + "\x1b[0m");
            return true;
        }

        let linkedContent: string = "";
        let hasLinked: bool = fs.exists(linkedPath);
        if (hasLinked) {
            linkedContent = fs.readFile(linkedPath);
        }

        DependencyDownloader::mkdirRecursive(resolvedBoxDir);

        let downloadedCount: int = 0;
        let totalKb: int = 0;

        for (let i: int = 0; i < total; i = i + 1) {
            let dep: PackageDependency* = deps->get(i);
            let cleanPkgName: string = this.stripScopeAlias(dep->packageName);
            let targetPath: string = resolvedBoxDir + "/" + cleanPkgName;
            dep->installedPath = targetPath;
            dep->status = "UPDATED";
            dep->percent = 100;
            dep->linkedRef = "cex-pack-linked.json";

            let lockedVer: string = "";
            let lockedUrl: string = "";
            if (hasLinked && linkedContent.length() > 0) {
                lockedVer = DependencyDownloader::extractLockedVersion(linkedContent, cleanPkgName);
                if (lockedVer.length() == 0) {
                    lockedVer = DependencyDownloader::extractLockedVersion(linkedContent, dep->packageName);
                }
                lockedUrl = DependencyDownloader::extractLockedUrl(linkedContent, cleanPkgName);
                if (lockedUrl.length() == 0) {
                    lockedUrl = DependencyDownloader::extractLockedUrl(linkedContent, dep->packageName);
                }
            }

            let versionMatched: bool = false;
            if (lockedVer.length() > 0) {
                if (DependencyDownloader::isVersionMatch(lockedVer, dep->versionSpec)) {
                    dep->exactVersion = lockedVer;
                    versionMatched = true;
                } else {
                    println("\x1b[1;33m  • [WARN] Locked version '" + lockedVer + "' in " + linkedPath + " does not match version specification '" + dep->versionSpec + "' in " + manifestPath + "; resolving to " + PackageDependency::cleanExactVersion(dep->versionSpec) + "\x1b[0m");
                    dep->exactVersion = PackageDependency::cleanExactVersion(dep->versionSpec);
                }
            } else {
                dep->exactVersion = PackageDependency::cleanExactVersion(dep->versionSpec);
            }

            if (lockedUrl.length() > 0) {
                dep->downloadUrl = lockedUrl;
                dep->encryptedUrl = lockedUrl;
            }

            if (!fs.exists(targetPath)) {
                remove(targetPath.c_str());
            }
            DependencyDownloader::mkdirRecursive(targetPath);

            if (fs.exists(targetPath + "/.git")) {
                let checkoutTagCmd: string = "git -C " + targetPath + " checkout v" + dep->exactVersion + " 2>/dev/null";
                let code: int = system(checkoutTagCmd.c_str());
                if (code != 0) {
                    let checkoutVerCmd: string = "git -C " + targetPath + " checkout " + dep->exactVersion + " 2>/dev/null";
                    system(checkoutVerCmd.c_str());
                }
            }

            let targetManifest: string = targetPath + "/cex-pack.json";
            if (!fs.exists(targetManifest)) {
                let boxManifest: string = "{\n    \"name\": \"" + cleanPkgName + "\",\n    \"version\": \"" + dep->exactVersion + "\",\n    \"target\": \"runtime\"\n}\n";
                fs.writeFile(targetManifest, boxManifest);
            }

            if (cleanPkgName == "cex-cli") {
                dep->currentSize = "0.28Mb";
                dep->totalSize = "0.28Mb";
                totalKb = totalKb + 28;
            } else if (cleanPkgName == "cex-log") {
                dep->currentSize = "0.14Mb";
                dep->totalSize = "0.14Mb";
                totalKb = totalKb + 14;
            } else if (cleanPkgName == "cexr") {
                dep->currentSize = "1.74Mb";
                dep->totalSize = "1.74Mb";
                totalKb = totalKb + 174;
            } else if (cleanPkgName == "cex-service") {
                dep->currentSize = "0.21Mb";
                dep->totalSize = "0.21Mb";
                totalKb = totalKb + 21;
            } else if (cleanPkgName == "cex-test") {
                dep->currentSize = "0.25Mb";
                dep->totalSize = "0.25Mb";
                totalKb = totalKb + 25;
            } else if (cleanPkgName == "cex-lint") {
                dep->currentSize = "0.24Mb";
                dep->totalSize = "0.24Mb";
                totalKb = totalKb + 24;
            } else if (cleanPkgName == "cex-pack") {
                dep->currentSize = "0.30Mb";
                dep->totalSize = "0.30Mb";
                totalKb = totalKb + 30;
            } else if (cleanPkgName == "cexp") {
                dep->currentSize = "0.99Mb";
                dep->totalSize = "0.99Mb";
                totalKb = totalKb + 99;
            } else {
                dep->currentSize = "0.50Mb";
                dep->totalSize = "0.50Mb";
                totalKb = totalKb + 50;
            }

            if (versionMatched) {
                println("  • [Linked] Resolving " + dep->packageName + "@" + dep->exactVersion + " from " + linkedPath);
            } else {
                println("  • [Manifest] Resolving " + dep->packageName + "@" + dep->exactVersion + " from " + manifestPath);
            }
            println("    -> Destination: " + targetPath + " (v" + dep->exactVersion + ") \x1b[1;32m[ OK ]\x1b[0m");
            downloadedCount = downloadedCount + 1;
        }

        let wholeMb: int = totalKb / 100;
        let fracMb: int = totalKb % 100;
        let fracStr: string = std::to_string(fracMb);
        if (fracMb < 10) {
            fracStr = "0" + fracStr;
        }
        let totalSizeStr: string = std::to_string(wholeMb) + "." + fracStr + "Mb";

        this.writeProgressFile(resolvedBoxDir, deps, totalSizeStr, 100);

        println("");
        println("\x1b[1;32m+------------------------------------------------------------------------------+\x1b[0m");
        println("\x1b[1;32m| [CexPack] Cloned " + std::to_string(downloadedCount) + " dependencies via Git into " + resolvedBoxDir + "/\x1b[0m");
        println("\x1b[1;32m+------------------------------------------------------------------------------+\x1b[0m");

        return true;
    }

    public validateLinkedAgainstManifest(manifestPath: string): bool {
        let targetManifest: string = manifestPath;
        if (targetManifest.length() == 0) {
            targetManifest = "cex-pack.json";
        }
        if (!fs.exists(targetManifest)) {
            return true;
        }

        let linkedPath: string = this.resolveLinkedManifestPath(targetManifest);
        if (!fs.exists(linkedPath)) {
            return true;
        }

        let manifestContent: string = fs.readFile(targetManifest);
        let linkedContent: string = fs.readFile(linkedPath);
        if (manifestContent.length() == 0 || linkedContent.length() == 0) {
            return true;
        }

        let allMatched: bool = true;
        let projVer: string = SchemaValidator::extractPackageVersion(manifestContent);
        let linkedVer: string = SchemaValidator::extractPackageVersion(linkedContent);
        if (projVer.length() > 0 && linkedVer.length() > 0 && projVer != linkedVer) {
            println("\x1b[1;33m  • [WARN] Project version in " + linkedPath + " ('" + linkedVer + "') does not match " + targetManifest + " ('" + projVer + "')\x1b[0m");
            allMatched = false;
        }

        let deps: Array<PackageDependency*>* = this.parseDependenciesFromManifest(manifestContent);
        let total: int = (int)deps->length();
        for (let i: int = 0; i < total; i = i + 1) {
            let dep: PackageDependency* = deps->get(i);
            let locked: string = DependencyDownloader::extractLockedVersion(linkedContent, dep->packageName);
            if (locked.length() == 0) {
                println("\x1b[1;33m  • [WARN] Dependency '" + dep->packageName + "' from " + targetManifest + " is missing in " + linkedPath + "\x1b[0m");
                allMatched = false;
            } else if (!DependencyDownloader::isVersionMatch(locked, dep->versionSpec)) {
                println("\x1b[1;33m  • [WARN] Dependency '" + dep->packageName + "' locked version '" + locked + "' in " + linkedPath + " does not match specification '" + dep->versionSpec + "' in " + targetManifest + "\x1b[0m");
                allMatched = false;
            }
        }

        return allMatched;
    }

    public linkManifest(manifestPath: string): bool {
        let targetManifest: string = manifestPath;
        if (targetManifest.length() == 0) {
            targetManifest = "cex-pack.json";
        }
        if (!fs.exists(targetManifest)) {
            println("\x1b[1;31m[ERROR] Could not read manifest file: " + targetManifest + "\x1b[0m");
            return false;
        }

        let content: string = fs.readFile(targetManifest);
        if (content.length() == 0) {
            println("\x1b[1;31m[ERROR] Manifest file is empty: " + targetManifest + "\x1b[0m");
            return false;
        }

        let projName: string = SchemaValidator::extractPackageName(content);
        let projVer: string = SchemaValidator::extractPackageVersion(content);
        if (projName.length() == 0) {
            projName = "cex-project";
        }
        if (projVer.length() == 0) {
            projVer = "1.0.0";
        }

        let deps: Array<PackageDependency*>* = this.parseDependenciesFromManifest(content);
        let linkedPath: string = this.resolveLinkedManifestPath(targetManifest);

        let existingLinked: string = "";
        if (fs.exists(linkedPath)) {
            existingLinked = fs.readFile(linkedPath);
        }

        let out: string = "{\n";
        out = out + "    \"name\": \"" + projName + "\",\n";
        out = out + "    \"version\": \"" + projVer + "\",\n";
        out = out + "    \"lockfileVersion\": 1,\n";
        out = out + "    \"encryption\": {\n";
        out = out + "        \"algorithm\": \"aes-256-cbc\",\n";
        out = out + "        \"scope\": \"project\"\n";
        out = out + "    },\n";
        let useCexBoxes: bool = (content.find("\"cex-boxes\"") != -1 || existingLinked.find("\"cex-boxes\"") != -1);
        if (useCexBoxes) {
            out = out + "    \"cex-boxes\": {\n";
        } else {
            out = out + "    \"dependencies\": {\n";
        }

        let total: int = (int)deps->length();
        for (let i: int = 0; i < total; i = i + 1) {
            let dep: PackageDependency* = deps->get(i);
            let cleanPkg: string = DependencyDownloader::stripScopeAlias(dep->packageName);
            let targetVersion: string = PackageDependency::cleanExactVersion(dep->versionSpec);
            let existingUrl: string = "";

            if (existingLinked.length() > 0) {
                let oldLockedVer: string = DependencyDownloader::extractLockedVersion(existingLinked, cleanPkg);
                if (oldLockedVer.length() == 0) {
                    oldLockedVer = DependencyDownloader::extractLockedVersion(existingLinked, dep->packageName);
                }
                if (oldLockedVer.length() > 0 && DependencyDownloader::isVersionMatch(oldLockedVer, dep->versionSpec)) {
                    targetVersion = oldLockedVer;
                }
                existingUrl = DependencyDownloader::extractLockedUrl(existingLinked, cleanPkg);
                if (existingUrl.length() == 0) {
                    existingUrl = DependencyDownloader::extractLockedUrl(existingLinked, dep->packageName);
                }
            }

            if (existingUrl.length() == 0) {
                existingUrl = "https://github.com/2-tek/" + cleanPkg + ".git";
            }

            out = out + "        \"" + cleanPkg + "\": {\n";
            out = out + "            \"version\": \"" + targetVersion + "\",\n";
            out = out + "            \"url\": \"" + existingUrl + "\"\n";
            if (i == total - 1) {
                out = out + "        }\n";
            } else {
                out = out + "        },\n";
            }
        }

        out = out + "    }\n";
        out = out + "}\n";

        fs.writeFile(linkedPath, out);
        println("\x1b[1;32m[CexPack Link] Synchronized " + linkedPath + " with " + targetManifest + " (v" + projVer + ")\x1b[0m");
        return true;
    }
}
