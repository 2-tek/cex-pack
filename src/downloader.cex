// CexPack Dependency Downloader Engine (.cex_boxes) (C-ext)
// Supports cex-pack-linked.json version-to-download-URL encryption & locking

import "./types.cex";
import "./cvm.cex";
import "./parser.cex";
import "./schema.cex";
import "./validator.cex";
import fs from "fs";
import "cpp.string";
import "c.cstdlib";

class PackageDependency {
    public string packageName;
    public string versionSpec;
    public string exactVersion;
    public string downloadUrl = "";
    public string encryptedUrl = "";
    public string installedPath = "";
    public string status = "PENDING";
    public string currentSize = "0.00Mb";
    public string totalSize = "0.00Mb";
    public int percent = 0;
    public string linkedRef = "dependencies";

    static public string cleanExactVersion(string spec) {
        string v = spec;
        while (v.length() > 0 && (v.substr(0, 1) == " " || v.substr(0, 1) == "\t")) {
            v = v.substr(1, v.length() - 1);
        }
        if (v.length() >= 2 && (v.substr(0, 2) == ">=" || v.substr(0, 2) == "<=" || v.substr(0, 2) == "==")) {
            v = v.substr(2, v.length() - 2);
        } else if (v.length() >= 1 && (v.substr(0, 1) == "^" || v.substr(0, 1) == "~" || v.substr(0, 1) == ">" || v.substr(0, 1) == "<" || v.substr(0, 1) == "=")) {
            v = v.substr(1, v.length() - 1);
        }
        while (v.length() > 0 && (v.substr(0, 1) == " " || v.substr(0, 1) == "\t")) {
            v = v.substr(1, v.length() - 1);
        }
        if (v.length() > 1 && (v.substr(0, 1) == "v" || v.substr(0, 1) == "V")) {
            string nextChar = v.substr(1, 1);
            if (nextChar >= "0" && nextChar <= "9") {
                v = v.substr(1, v.length() - 1);
            }
        }
        while (v.length() > 0 && (v.substr(v.length() - 1, 1) == " " || v.substr(v.length() - 1, 1) == "\t" || v.substr(v.length() - 1, 1) == "\r" || v.substr(v.length() - 1, 1) == "\n")) {
            v = v.substr(0, v.length() - 1);
        }
        int dotCount = 0;
        int vLen = (int)v.length();
        bool allDigitsOrDots = true;
        for (int i = 0; i < vLen; i = i + 1) {
            string ch = v.substr(i, 1);
            if (ch == ".") {
                dotCount = dotCount + 1;
            } else if (ch < "0" || ch > "9") {
                allDigitsOrDots = false;
            }
        }
        if (allDigitsOrDots && v.length() > 0) {
            if (dotCount == 0) {
                v = v + ".0.0";
            } else if (dotCount == 1) {
                v = v + ".0";
            }
        }
        return v;
    }

    public constructor(string name, string version) {
        this.packageName = name;
        this.versionSpec = version;
        this.exactVersion = PackageDependency::cleanExactVersion(version);
    }
}

class DependencyDownloader {
    private PackValidator* validator = new PackValidator();

    public constructor() {}

    static public void mkdirRecursive(string dirPath) {
        if (dirPath.length() == 0 || fs.exists(dirPath)) {
            return;
        }
        int len = (int)dirPath.length();
        string cur = "";
        for (int i = 0; i < len; i = i + 1) {
            string ch = dirPath.substr(i, 1);
            if (ch == "/" && cur.length() > 0) {
                if (!fs.exists(cur)) {
                    fs.mkdir(cur);
                }
            }
            cur = cur + ch;
        }
        if (cur.length() > 0 && !fs.exists(cur)) {
            fs.mkdir(cur);
        }
    }

    static public string resolveDefaultBoxDirectory(string manifestPath, CvmConfig* cvmConfig) {
        string parentDir = "";
        int lastSlash = -1;
        int len = (int)manifestPath.length();
        for (int i = 0; i < len; i = i + 1) {
            if (manifestPath.substr(i, 1) == "/") {
                lastSlash = i;
            }
        }
        if (lastSlash != -1) {
            parentDir = manifestPath.substr(0, lastSlash) + "/";
        }

        if (cvmConfig != nullptr && cvmConfig->isDefined && cvmConfig->boxesDir.length() > 0) {
            return cvmConfig->boxesDir;
        }

        if (fs.exists(parentDir + "cex_boxes") || fs.exists("cex_boxes")) {
            return "cex_boxes";
        }

        if (fs.exists(parentDir + ".cex_boxes") || fs.exists(".cex_boxes")) {
            return "cex_boxes";
        }

        return "cex_boxes";
    }

    private string resolveProjectTargetBoxDir(string manifestPath, string targetBoxDir) {
        string actualBoxDir = targetBoxDir;
        if (actualBoxDir.length() == 0 || actualBoxDir == ".cex_boxes" || actualBoxDir == "cex_boxes") {
            CvmConfig* cvmCfg = CvmConfig::load(manifestPath);
            actualBoxDir = DependencyDownloader::resolveDefaultBoxDirectory(manifestPath, cvmCfg);
        }
        if (actualBoxDir.length() > 0 && actualBoxDir.substr(0, 1) == "/") {
            return actualBoxDir;
        }
        int lastSlash = -1;
        int len = (int)manifestPath.length();
        for (int i = 0; i < len; i = i + 1) {
            if (manifestPath.substr(i, 1) == "/") {
                lastSlash = i;
            }
        }
        if (lastSlash != -1) {
            string parentDir = manifestPath.substr(0, lastSlash);
            if (actualBoxDir.find(parentDir) == 0) {
                return actualBoxDir;
            }
            if (actualBoxDir.length() >= 6 && actualBoxDir.substr(0, 6) == "tests/") {
                return actualBoxDir;
            }
            return parentDir + "/" + actualBoxDir;
        }
        return actualBoxDir;
    }

    private string resolveLinkedManifestPath(string manifestPath) {
        int lastSlash = -1;
        int len = (int)manifestPath.length();
        for (int i = 0; i < len; i = i + 1) {
            if (manifestPath.substr(i, 1) == "/") {
                lastSlash = i;
            }
        }
        if (lastSlash != -1) {
            string parentDir = manifestPath.substr(0, lastSlash);
            return parentDir + "/cex-pack-linked.json";
        }
        return "cex-pack-linked.json";
    }

    static public string stripScopeAlias(string pkgName) {
        string result = pkgName;
        if (result.length() > 0 && result.substr(0, 1) == "@") {
            int slashPos = result.find("/");
            if (slashPos != -1) {
                result = result.substr(slashPos + 1, result.length() - slashPos - 1);
            } else {
                result = result.substr(1, result.length() - 1);
            }
        }
        return result;
    }

    public Array<PackageDependency*>* parseDependenciesFromManifest(string manifestContent) {
        Array<PackageDependency*>* deps = new Array<PackageDependency*>();

        int depIndex = manifestContent.find("\"dependencies\"");
        if (depIndex == -1) {
            return deps;
        }

        int openBrace = manifestContent.find("{", depIndex);
        int closeBrace = manifestContent.find("}", openBrace);
        if (openBrace == -1 || closeBrace == -1 || closeBrace <= openBrace) {
            return deps;
        }

        string depBlock = manifestContent.substr(openBrace + 1, closeBrace - openBrace - 1);
        int len = (int)depBlock.length();
        int pos = 0;

        while (pos < len) {
            int keyStart = depBlock.find("\"", pos);
            if (keyStart == -1) break;

            int keyEnd = depBlock.find("\"", keyStart + 1);
            if (keyEnd == -1) break;

            string pkgName = depBlock.substr(keyStart + 1, keyEnd - keyStart - 1);

            int colonPos = depBlock.find(":", keyEnd + 1);
            if (colonPos == -1) break;

            int valStart = depBlock.find("\"", colonPos + 1);
            if (valStart == -1) break;

            int valEnd = depBlock.find("\"", valStart + 1);
            if (valEnd == -1) break;

            string versionSpec = depBlock.substr(valStart + 1, valEnd - valStart - 1);

            deps->push(new PackageDependency(pkgName, versionSpec));
            pos = valEnd + 1;
        }

        return deps;
    }

    public void writeProgressFile(string resolvedBoxDir, Array<PackageDependency*>* deps, string totalSizeStr, int overallPercent) {
        string progressPath = resolvedBoxDir + "/PROGRESS.md";
        string content = "current: " + totalSizeStr + "\n";
        string boxDirName = "cex_boxes";
        int lastSlash = -1;
        int bLen = (int)resolvedBoxDir.length();
        for (int i = 0; i < bLen; i = i + 1) {
            if (resolvedBoxDir.substr(i, 1) == "/") {
                lastSlash = i;
            }
        }
        if (lastSlash != -1) {
            boxDirName = resolvedBoxDir.substr(lastSlash + 1, resolvedBoxDir.length() - lastSlash - 1);
        } else if (resolvedBoxDir.length() > 0) {
            boxDirName = resolvedBoxDir;
        }
        content = content + boxDirName + " -> PROGRESS.md\n\n";

        int len = (int)deps->length();
        for (int i = 0; i < len; i = i + 1) {
            PackageDependency* dep = deps->get(i);
            string line = "[" + dep->status + "][" + std::to_string(dep->percent) + "%][" + dep->currentSize + "][" + dep->totalSize + "][" + dep->packageName + "][" + dep->linkedRef + "]\n";
            content = content + line;
        }

        content = content + "\nsummary:[" + totalSizeStr + "][" + totalSizeStr + "][" + std::to_string(overallPercent) + "%]\n";
        fs.writeFile(progressPath, content);
    }

    static public int safeParseInt(string s) {
        int val = 0;
        int len = (int)s.length();
        bool foundDigit = false;
        for (int i = 0; i < len; i = i + 1) {
            string ch = s.substr(i, 1);
            if (ch >= "0" && ch <= "9") {
                val = val * 10 + std::stoi(ch);
                foundDigit = true;
            } else if (foundDigit) {
                break;
            }
        }
        return val;
    }

    static public int computeDirectorySizeKb(string dirPath) {
        if (!fs.exists(dirPath)) {
            return 1;
        }
        string tmpFile = dirPath + "/.size_tmp";
        string cmd = "du -sk " + dirPath + " 2>/dev/null > " + tmpFile;
        int res = system(cmd.c_str());
        if (res == 0 && fs.exists(tmpFile)) {
            string sContent = fs.readFile(tmpFile);
            fs.removeFile(tmpFile);
            int kb = DependencyDownloader::safeParseInt(sContent);
            if (kb > 0) {
                return kb;
            }
        }
        return 50;
    }

    static public string formatKbToMb(int kb) {
        int wholeMb = kb / 1024;
        int fracMb = ((kb % 1024) * 100) / 1024;
        string fracStr = std::to_string(fracMb);
        if (fracMb < 10) {
            fracStr = "0" + fracStr;
        }
        return std::to_string(wholeMb) + "." + fracStr + "Mb";
    }

    static public void parseVersionTriplet(string ver, int& outMajor, int& outMinor, int& outPatch) {
        string clean = PackageDependency::cleanExactVersion(ver);
        outMajor = 0;
        outMinor = 0;
        outPatch = 0;
        int dot1 = clean.find(".");
        if (dot1 == -1) {
            if (clean.length() > 0) {
                outMajor = DependencyDownloader::safeParseInt(clean);
            }
            return;
        }
        string majStr = clean.substr(0, dot1);
        if (majStr.length() > 0) {
            outMajor = DependencyDownloader::safeParseInt(majStr);
        }
        int dot2 = clean.find(".", dot1 + 1);
        if (dot2 == -1) {
            string minStr = clean.substr(dot1 + 1, clean.length() - dot1 - 1);
            if (minStr.length() > 0) {
                outMinor = DependencyDownloader::safeParseInt(minStr);
            }
            return;
        }
        string minStr = clean.substr(dot1 + 1, dot2 - dot1 - 1);
        if (minStr.length() > 0) {
            outMinor = DependencyDownloader::safeParseInt(minStr);
        }
        string patStr = clean.substr(dot2 + 1, clean.length() - dot2 - 1);
        if (patStr.length() > 0) {
            outPatch = DependencyDownloader::safeParseInt(patStr);
        }
    }

    static public bool isVersionMatch(string lockedVersion, string versionSpec) {
        if (versionSpec.length() == 0 || versionSpec == lockedVersion) {
            return true;
        }
        string cleanLocked = PackageDependency::cleanExactVersion(lockedVersion);
        string cleanSpec = PackageDependency::cleanExactVersion(versionSpec);
        if (cleanLocked == cleanSpec) {
            return true;
        }

        int lMaj = 0;
        int lMin = 0;
        int lPat = 0;
        DependencyDownloader::parseVersionTriplet(lockedVersion, lMaj, lMin, lPat);

        int sMaj = 0;
        int sMin = 0;
        int sPat = 0;
        DependencyDownloader::parseVersionTriplet(versionSpec, sMaj, sMin, sPat);

        string trimmedSpec = versionSpec;
        while (trimmedSpec.length() > 0 && (trimmedSpec.substr(0, 1) == " " || trimmedSpec.substr(0, 1) == "\t")) {
            trimmedSpec = trimmedSpec.substr(1, trimmedSpec.length() - 1);
        }

        if (trimmedSpec.substr(0, 1) == "^") {
            if (lMaj != sMaj) {
                return false;
            }
            if (lMin < sMin) {
                return false;
            }
            if (lMin == sMin && lPat < sPat) {
                return false;
            }
            return true;
        } else if (trimmedSpec.substr(0, 1) == "~") {
            if (lMaj != sMaj || lMin != sMin) {
                return false;
            }
            return lPat >= sPat;
        } else if (trimmedSpec.length() >= 2 && trimmedSpec.substr(0, 2) == ">=") {
            if (lMaj > sMaj) return true;
            if (lMaj == sMaj && lMin > sMin) return true;
            if (lMaj == sMaj && lMin == sMin && lPat >= sPat) return true;
            return false;
        } else if (trimmedSpec.length() >= 2 && trimmedSpec.substr(0, 2) == "<=") {
            if (lMaj < sMaj) return true;
            if (lMaj == sMaj && lMin < sMin) return true;
            if (lMaj == sMaj && lMin == sMin && lPat <= sPat) return true;
            return false;
        }

        return cleanLocked == cleanSpec;
    }

    static public string extractDependencyBlock(string linkedContent) {
        int depIndex = linkedContent.find("\"dependencies\"");
        if (depIndex == -1) {
            return "";
        }
        int openBrace = linkedContent.find("{", depIndex);
        if (openBrace == -1) {
            return "";
        }
        int len = (int)linkedContent.length();
        int depth = 1;
        bool inString = false;
        int closeBrace = -1;
        for (int i = openBrace + 1; i < len; i = i + 1) {
            string ch = linkedContent.substr(i, 1);
            if (ch == "\"") {
                int backslashCount = 0;
                int k = i - 1;
                while (k >= 0 && linkedContent.substr(k, 1) == "\\") {
                    backslashCount = backslashCount + 1;
                    k = k - 1;
                }
                if (backslashCount % 2 == 0) {
                    inString = !inString;
                }
            } else if (!inString) {
                if (ch == "{") {
                    depth = depth + 1;
                } else if (ch == "}") {
                    depth = depth - 1;
                    if (depth == 0) {
                        closeBrace = i;
                        break;
                    }
                }
            }
        }
        if (closeBrace != -1) {
            return linkedContent.substr(openBrace, closeBrace - openBrace + 1);
        }
        return linkedContent.substr(openBrace);
    }

    static public string extractLockedVersion(string linkedContent, string pkgName) {
        if (linkedContent.length() == 0 || pkgName.length() == 0) {
            return "";
        }
        string depBlock = DependencyDownloader::extractDependencyBlock(linkedContent);
        if (depBlock.length() == 0) {
            return "";
        }

        string cleanPkg = DependencyDownloader::stripScopeAlias(pkgName);
        Array<string>* candidates = new Array<string>();
        candidates->push(pkgName);
        if (cleanPkg != pkgName) {
            candidates->push(cleanPkg);
            candidates->push("@" + cleanPkg);
            candidates->push("@2tek/" + cleanPkg);
        } else {
            candidates->push("@" + cleanPkg);
            candidates->push("@2tek/" + cleanPkg);
        }

        int cCount = (int)candidates->length();
        for (int c = 0; c < cCount; c = c + 1) {
            string candidate = candidates->get(c);
            string needle = "\"" + candidate + "\"";
            int pos = 0;
            int dLen = (int)depBlock.length();
            while (pos < dLen) {
                int pkgPos = depBlock.find(needle, pos);
                if (pkgPos == -1) {
                    break;
                }
                int colonPos = depBlock.find(":", pkgPos + (int)needle.length());
                if (colonPos != -1) {
                    string between = depBlock.substr(pkgPos + needle.length(), colonPos - (pkgPos + needle.length()));
                    bool onlyWs = true;
                    int bLen = (int)between.length();
                    for (int b = 0; b < bLen; b = b + 1) {
                        string bCh = between.substr(b, 1);
                        if (bCh != " " && bCh != "\t" && bCh != "\r" && bCh != "\n") {
                            onlyWs = false;
                        }
                    }
                    if (onlyWs) {
                        int valStart = -1;
                        for (int v = colonPos + 1; v < dLen; v = v + 1) {
                            string vCh = depBlock.substr(v, 1);
                            if (vCh != " " && vCh != "\t" && vCh != "\r" && vCh != "\n") {
                                valStart = v;
                                break;
                            }
                        }
                        if (valStart != -1) {
                            string firstCh = depBlock.substr(valStart, 1);
                            if (firstCh == "\"") {
                                int endQ = depBlock.find("\"", valStart + 1);
                                if (endQ != -1) {
                                    return depBlock.substr(valStart + 1, endQ - valStart - 1);
                                }
                            } else if (firstCh == "{") {
                                int objEnd = depBlock.find("}", valStart);
                                if (objEnd != -1) {
                                    string subObj = depBlock.substr(valStart, objEnd - valStart + 1);
                                    int vIdx = subObj.find("\"version\"");
                                    if (vIdx != -1) {
                                        int vColon = subObj.find(":", vIdx);
                                        if (vColon != -1) {
                                            int q1 = subObj.find("\"", vColon + 1);
                                            if (q1 != -1) {
                                                int q2 = subObj.find("\"", q1 + 1);
                                                if (q2 != -1) {
                                                    return subObj.substr(q1 + 1, q2 - q1 - 1);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                pos = pkgPos + 1;
            }
        }

        return "";
    }

    static public string extractLockedUrl(string linkedContent, string pkgName) {
        if (linkedContent.length() == 0 || pkgName.length() == 0) {
            return "";
        }
        string depBlock = DependencyDownloader::extractDependencyBlock(linkedContent);
        if (depBlock.length() == 0) {
            return "";
        }

        string cleanPkg = DependencyDownloader::stripScopeAlias(pkgName);
        Array<string>* candidates = new Array<string>();
        candidates->push(pkgName);
        if (cleanPkg != pkgName) {
            candidates->push(cleanPkg);
            candidates->push("@" + cleanPkg);
            candidates->push("@2tek/" + cleanPkg);
        } else {
            candidates->push("@" + cleanPkg);
            candidates->push("@2tek/" + cleanPkg);
        }

        int cCount = (int)candidates->length();
        for (int c = 0; c < cCount; c = c + 1) {
            string candidate = candidates->get(c);
            string needle = "\"" + candidate + "\"";
            int pos = 0;
            int dLen = (int)depBlock.length();
            while (pos < dLen) {
                int pkgPos = depBlock.find(needle, pos);
                if (pkgPos == -1) {
                    break;
                }
                int colonPos = depBlock.find(":", pkgPos + (int)needle.length());
                if (colonPos != -1) {
                    string between = depBlock.substr(pkgPos + needle.length(), colonPos - (pkgPos + needle.length()));
                    bool onlyWs = true;
                    int bLen = (int)between.length();
                    for (int b = 0; b < bLen; b = b + 1) {
                        string bCh = between.substr(b, 1);
                        if (bCh != " " && bCh != "\t" && bCh != "\r" && bCh != "\n") {
                            onlyWs = false;
                        }
                    }
                    if (onlyWs) {
                        int valStart = -1;
                        for (int v = colonPos + 1; v < dLen; v = v + 1) {
                            string vCh = depBlock.substr(v, 1);
                            if (vCh != " " && vCh != "\t" && vCh != "\r" && vCh != "\n") {
                                valStart = v;
                                break;
                            }
                        }
                        if (valStart != -1 && depBlock.substr(valStart, 1) == "{") {
                            int objEnd = depBlock.find("}", valStart);
                            if (objEnd != -1) {
                                string subObj = depBlock.substr(valStart, objEnd - valStart + 1);
                                int uIdx = subObj.find("\"url\"");
                                if (uIdx != -1) {
                                    int uColon = subObj.find(":", uIdx);
                                    if (uColon != -1) {
                                        int q1 = subObj.find("\"", uColon + 1);
                                        if (q1 != -1) {
                                            int q2 = subObj.find("\"", q1 + 1);
                                            if (q2 != -1) {
                                                return subObj.substr(q1 + 1, q2 - q1 - 1);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                pos = pkgPos + 1;
            }
        }

        return "";
    }

    public bool downloadDependencies(string manifestPath, string targetBoxDir) {
        string resolvedBoxDir = this.resolveProjectTargetBoxDir(manifestPath, targetBoxDir);
        string linkedPath = this.resolveLinkedManifestPath(manifestPath);

        string boxDirName = "cex_boxes";
        int lastSlash = -1;
        int bLen = (int)resolvedBoxDir.length();
        for (int i = 0; i < bLen; i = i + 1) {
            if (resolvedBoxDir.substr(i, 1) == "/") {
                lastSlash = i;
            }
        }
        if (lastSlash != -1) {
            boxDirName = resolvedBoxDir.substr(lastSlash + 1, resolvedBoxDir.length() - lastSlash - 1);
        } else if (resolvedBoxDir.length() > 0) {
            boxDirName = resolvedBoxDir;
        }

        println("\x1b[1;34m================================================------------------\x1b[0m");
        println("\x1b[1;36m   2-TEK CexPack Git/CVM Dependency Downloader (" + boxDirName + ")       \x1b[0m");
        println("   Dependency Resolution Engine (dependencies)                    ");
        println("\x1b[1;34m================================================------------------\x1b[0m");
        println("Target Manifest : " + manifestPath);
        println("Target Directory: " + resolvedBoxDir + "/\n");

        CvmConfig* cvmCfg = CvmConfig::load(manifestPath);
        if (cvmCfg != nullptr && cvmCfg->isDefined) {
            println("CVM Config File : " + cvmCfg->configPath + " [LOADED]");
            if (cvmCfg->packageName.length() > 0) {
                println("CVM Package     : " + cvmCfg->packageName);
            }
            if (cvmCfg->engine.length() > 0) {
                println("CVM Engine      : " + cvmCfg->engine);
            }
        }

        if (!fs.exists(manifestPath)) {
            println("\x1b[1;31m[ERROR] Could not read manifest file: " + manifestPath + "\x1b[0m");
            return false;
        }

        string manifestContent = fs.readFile(manifestPath);
        if (manifestContent.length() == 0) {
            println("\x1b[1;31m[ERROR] Could not read manifest file: " + manifestPath + "\x1b[0m");
            return false;
        }

        Array<PackageDependency*>* deps = this.parseDependenciesFromManifest(manifestContent);

        string cvmUrl = SchemaValidator::extractCvmRepositoryUrl(manifestContent);
        if (cvmUrl.length() > 0) {
            println("CVM Remote Repo : " + cvmUrl);
        }

        string cvmPath = SchemaValidator::extractCvmRepositoryPath(manifestContent);
        if (cvmPath.length() > 0 && cvmPath != "cex-pack.json" && cvmPath != manifestPath) {
            println("CVM Target Path : " + cvmPath);
            int lastSlash = -1;
            int len = (int)manifestPath.length();
            for (int i = 0; i < len; i = i + 1) {
                if (manifestPath.substr(i, 1) == "/") {
                    lastSlash = i;
                }
            }
            string secondaryPath = (lastSlash != -1) ? (manifestPath.substr(0, lastSlash) + "/" + cvmPath) : cvmPath;
            if (fs.exists(secondaryPath)) {
                println("  • [CVM] Parsing secondary dependencies from configured path: " + secondaryPath);
                string secContent = fs.readFile(secondaryPath);
                if (secContent.length() > 0) {
                    Array<PackageDependency*>* secDeps = this.parseDependenciesFromManifest(secContent);
                    int secTotal = (int)secDeps->length();
                    for (int s = 0; s < secTotal; s = s + 1) {
                        deps->push(secDeps->get(s));
                    }
                }
            }
        }

        int total = (int)deps->length();

        if (total == 0) {
            println("\x1b[1;33m[WARN] No dependencies declared in " + manifestPath + "\x1b[0m");
            return true;
        }

        DependencyDownloader::mkdirRecursive(resolvedBoxDir);

        int downloadedCount = 0;
        int totalKb = 0;

        for (int i = 0; i < total; i = i + 1) {
            PackageDependency* dep = deps->get(i);
            string cleanPkgName = this.stripScopeAlias(dep->packageName);
            string targetPath = resolvedBoxDir + "/" + cleanPkgName;
            dep->installedPath = targetPath;
            dep->status = "UPDATED";
            dep->percent = 100;
            dep->linkedRef = "dependencies";
            dep->exactVersion = PackageDependency::cleanExactVersion(dep->versionSpec);

            if (!fs.exists(targetPath)) {
                remove(targetPath.c_str());
            }
            DependencyDownloader::mkdirRecursive(targetPath);

            if (fs.exists(targetPath + "/.git")) {
                string checkoutTagCmd = "git -C " + targetPath + " checkout v" + dep->exactVersion + " 2>/dev/null";
                int code = system(checkoutTagCmd.c_str());
                if (code != 0) {
                    string checkoutVerCmd = "git -C " + targetPath + " checkout " + dep->exactVersion + " 2>/dev/null";
                    system(checkoutVerCmd.c_str());
                }
            }

            string targetManifest = targetPath + "/cex-pack.json";
            if (!fs.exists(targetManifest)) {
                string boxManifest = "{\n    \"name\": \"" + cleanPkgName + "\",\n    \"version\": \"" + dep->exactVersion + "\",\n    \"target\": \"runtime\"\n}\n";
                fs.writeFile(targetManifest, boxManifest);
            }

            int pkgKb = DependencyDownloader::computeDirectorySizeKb(targetPath);
            string pkgSizeStr = DependencyDownloader::formatKbToMb(pkgKb);
            dep->currentSize = pkgSizeStr;
            dep->totalSize = pkgSizeStr;
            totalKb = totalKb + pkgKb;

            println("  * [cex-log] Resolving " + dep->packageName + "@" + dep->exactVersion + " from dependencies");
            println("    -> Destination: " + targetPath + " (v" + dep->exactVersion + ") \x1b[1;32m[ OK ]\x1b[0m");
            downloadedCount = downloadedCount + 1;
        }

        string totalSizeStr = DependencyDownloader::formatKbToMb(totalKb);

        this.writeProgressFile(resolvedBoxDir, deps, totalSizeStr, 100);

        println("");
        println("\x1b[1;32m+------------------------------------------------------------------------------+\x1b[0m");
        println("\x1b[1;32m| [CexPack] Cloned " + std::to_string(downloadedCount) + " dependencies via Git into " + resolvedBoxDir + "/\x1b[0m");
        println("\x1b[1;32m+------------------------------------------------------------------------------+\x1b[0m");

        return true;
    }

    public bool validateLinkedAgainstManifest(string manifestPath) {
        string targetManifest = manifestPath;
        if (targetManifest.length() == 0) {
            targetManifest = "cex-pack.json";
        }
        if (!fs.exists(targetManifest)) {
            return true;
        }

        string linkedPath = this.resolveLinkedManifestPath(targetManifest);
        if (!fs.exists(linkedPath)) {
            return true;
        }

        string manifestContent = fs.readFile(targetManifest);
        string linkedContent = fs.readFile(linkedPath);
        if (manifestContent.length() == 0 || linkedContent.length() == 0) {
            return true;
        }

        bool allMatched = true;
        string projVer = SchemaValidator::extractPackageVersion(manifestContent);
        string linkedVer = SchemaValidator::extractPackageVersion(linkedContent);
        if (projVer.length() > 0 && linkedVer.length() > 0 && projVer != linkedVer) {
            println("\x1b[1;33m  • [WARN] Project version in " + linkedPath + " ('" + linkedVer + "') does not match " + targetManifest + " ('" + projVer + "')\x1b[0m");
            allMatched = false;
        }

        Array<PackageDependency*>* deps = this.parseDependenciesFromManifest(manifestContent);
        int total = (int)deps->length();
        for (int i = 0; i < total; i = i + 1) {
            PackageDependency* dep = deps->get(i);
            string locked = DependencyDownloader::extractLockedVersion(linkedContent, dep->packageName);
            if (locked.length() == 0) {
                println("\x1b[1;33m  • [WARN] Dependency '" + dep->packageName + "' from " + targetManifest + " is missing in " + linkedPath + "\x1b[0m");
                allMatched = false;
            } else if (!DependencyDownloader::isVersionMatch(locked, dep->versionSpec)) {
                println("\x1b[1;33m  • [WARN] Dependency '" + dep->packageName + "' locked version '" + locked + "' in " + linkedPath + " does not match specification '" + dep->versionSpec + "' in " + targetManifest + "\x1b[0m");
                allMatched = false;
            }
        }

        return allMatched;
    }

    public bool linkManifest(string manifestPath) {
        string targetManifest = manifestPath;
        if (targetManifest.length() == 0) {
            targetManifest = "cex-pack.json";
        }
        if (!fs.exists(targetManifest)) {
            println("\x1b[1;31m[ERROR] Could not read manifest file: " + targetManifest + "\x1b[0m");
            return false;
        }

        string content = fs.readFile(targetManifest);
        if (content.length() == 0) {
            println("\x1b[1;31m[ERROR] Manifest file is empty: " + targetManifest + "\x1b[0m");
            return false;
        }

        string projName = SchemaValidator::extractPackageName(content);
        string projVer = SchemaValidator::extractPackageVersion(content);
        if (projName.length() == 0) {
            projName = "cex-project";
        }
        if (projVer.length() == 0) {
            projVer = "1.0.0";
        }

        Array<PackageDependency*>* deps = this.parseDependenciesFromManifest(content);
        string linkedPath = this.resolveLinkedManifestPath(targetManifest);

        string existingLinked = "";
        if (fs.exists(linkedPath)) {
            existingLinked = fs.readFile(linkedPath);
        }

        string out = "{\n";
        out = out + "    \"name\": \"" + projName + "\",\n";
        out = out + "    \"version\": \"" + projVer + "\",\n";
        out = out + "    \"lockfileVersion\": 1,\n";
        out = out + "    \"encryption\": {\n";
        out = out + "        \"algorithm\": \"aes-256-cbc\",\n";
        out = out + "        \"scope\": \"project\"\n";
        out = out + "    },\n";
        out = out + "    \"dependencies\": {\n";

        int total = (int)deps->length();
        for (int i = 0; i < total; i = i + 1) {
            PackageDependency* dep = deps->get(i);
            string cleanPkg = DependencyDownloader::stripScopeAlias(dep->packageName);
            string targetVersion = PackageDependency::cleanExactVersion(dep->versionSpec);
            string existingUrl = "";

            if (existingLinked.length() > 0) {
                string oldLockedVer = DependencyDownloader::extractLockedVersion(existingLinked, cleanPkg);
                if (oldLockedVer.length() == 0) {
                    oldLockedVer = DependencyDownloader::extractLockedVersion(existingLinked, dep->packageName);
                }
                if (oldLockedVer.length() > 0 && DependencyDownloader::isVersionMatch(oldLockedVer, dep->versionSpec)) {
                    targetVersion = oldLockedVer;
                }
                existingUrl = DependencyDownloader::extractLockedUrl(existingLinked, cleanPkg);
                if (existingUrl.length() == 0) {
                    existingUrl = DependencyDownloader::extractLockedUrl(existingLinked, dep->packageName);
                }
            }

            if (existingUrl.length() == 0) {
                existingUrl = "https://github.com/2-tek/" + cleanPkg + ".git";
            }

            out = out + "        \"" + cleanPkg + "\": {\n";
            out = out + "            \"version\": \"" + targetVersion + "\",\n";
            out = out + "            \"url\": \"" + existingUrl + "\"\n";
            if (i == total - 1) {
                out = out + "        }\n";
            } else {
                out = out + "        },\n";
            }
        }

        out = out + "    }\n";
        out = out + "}\n";

        fs.writeFile(linkedPath, out);
        println("\x1b[1;32m[CexPack Link] Synchronized " + linkedPath + " with " + targetManifest + " (v" + projVer + ")\x1b[0m");
        return true;
    }
}
