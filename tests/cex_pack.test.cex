}

fn testEnvAndProcessEnvModule(): void {
    println("[SUITE 11] Testing Environment Loader & Process.Env Module...");

    // 1. EnvParser trim
    assertTrue(EnvParser::trim("  \t\nhello world\r\n ") == "hello world", "EnvParser trim removes surrounding whitespace");

    // 2. EnvParser parseLine
    let k1: string = "";
    let v1: string = "";
    assertTrue(EnvParser::parseLine("DATABASE_HOST=localhost", k1, v1) && k1 == "DATABASE_HOST" && v1 == "localhost", "EnvParser parseLine simple assignment");

    let k2: string = "";
    let v2: string = "";
    assertTrue(EnvParser::parseLine("export API_TOKEN=\"secret#token\\n\"", k2, v2) && k2 == "API_TOKEN" && v2 == "secret#token\n", "EnvParser parseLine with export and escaped quotes");

    let k3: string = "";
    let v3: string = "";
    assertTrue(EnvParser::parseLine("APP_PORT=3000 # default port", k3, v3) && k3 == "APP_PORT" && v3 == "3000", "EnvParser parseLine with trailing inline comment");

    let k4: string = "";
    let v4: string = "";
    assertTrue(!EnvParser::parseLine("# Comment line only", k4, v4), "EnvParser parseLine ignores comment lines");
    assertTrue(!EnvParser::parseLine("    ", k4, v4), "EnvParser parseLine ignores empty lines");

    // 3. EnvParser extractVarName
    assertTrue(EnvParser::extractVarName("ENV::[PORT]") == "PORT", "extractVarName extracts PORT from ENV::[PORT]");
    assertTrue(EnvParser::extractVarName("ENV::DATABASE_URL") == "DATABASE_URL", "extractVarName extracts DATABASE_URL from ENV::DATABASE_URL");
    assertTrue(EnvParser::extractVarName("{{ENV->[PORT]}}") == "PORT", "extractVarName extracts PORT from {{ENV->[PORT]}}");
    assertTrue(EnvParser::extractVarName("{{ENV->API_KEY}}") == "API_KEY", "extractVarName extracts API_KEY from {{ENV->API_KEY}}");
    assertTrue(EnvParser::extractVarName("static_value") == "", "extractVarName returns empty for static value");

    // 4. EnvParser isDynamic
    assertTrue(EnvParser::isDynamic("ENV::[PORT]"), "isDynamic returns true for ENV::[PORT]");
    assertTrue(EnvParser::isDynamic("ENV::HOST"), "isDynamic returns true for ENV::HOST");
    assertTrue(!EnvParser::isDynamic("localhost:8080"), "isDynamic returns false for static value");

    // 5. EnvParser interpolateString
    let dummyItems: Array<EnvItem*>* = new Array<EnvItem*>();
    dummyItems->push(new EnvItem("PORT", "3000", "3000", false, ""));
    dummyItems->push(new EnvItem("HOST", "127.0.0.1", "127.0.0.1", false, ""));
    let interp: string = EnvParser::interpolateString("http://ENV::[HOST]:ENV::[PORT]/api", dummyItems);
    assertTrue(interp == "http://127.0.0.1:3000/api", "interpolateString resolves embedded ENV::[var] expressions");

    // 6. EnvManager parseEnvsOptions
    let opts1: EnvConfigOptions* = EnvManager::parseEnvsOptions("{\n  \"options\": {\n    \"envs\": {\n      \"development\": \"./tests/fixtures/.env.dev\",\n      \"production\": \"./tests/fixtures/.env.prod\"\n    }\n  }\n}\n");
    assertTrue(opts1->hasEnv("development"), "parseEnvsOptions parses development from options.envs");
    assertTrue(opts1->hasEnv("production"), "parseEnvsOptions parses production from options.envs");
    assertTrue(opts1->getPathForEnv("development") == "./tests/fixtures/.env.dev", "parseEnvsOptions resolves development path");
    assertTrue(opts1->getPathForEnv("production") == "./tests/fixtures/.env.prod", "parseEnvsOptions resolves production path");

    let opts2: EnvConfigOptions* = EnvManager::parseEnvsOptions("{\n  \"envs\": {\n    \"test\": \"./tests/fixtures/.env.test\"\n  }\n}\n");
    assertTrue(opts2->hasEnv("test"), "parseEnvsOptions parses top-level envs");
    assertTrue(opts2->getPathForEnv("test") == "./tests/fixtures/.env.test", "parseEnvsOptions resolves top-level path");

    // 7. EnvManager parseProcessEnv
    let pItems1: Array<EnvItem*>* = EnvManager::parseProcessEnv("{\n  \"process.env\": {\n    \"PORT\": \"ENV::[PORT]\",\n    \"DB\": \"ENV::[DATABASE_NAME]\",\n    \"TITLE\": \"My App\"\n  }\n}\n");
    assertTrue(pItems1->length() == 3, "parseProcessEnv parses 3 items from process.env");
    assertTrue(pItems1->get(0)->key == "PORT" && pItems1->get(0)->isDynamic && pItems1->get(0)->sourceVarName == "PORT", "parseProcessEnv parses dynamic PORT item");
    assertTrue(pItems1->get(1)->key == "DB" && pItems1->get(1)->isDynamic && pItems1->get(1)->sourceVarName == "DATABASE_NAME", "parseProcessEnv parses dynamic DB item");
    assertTrue(pItems1->get(2)->key == "TITLE" && !pItems1->get(2)->isDynamic && pItems1->get(2)->rawValue == "My App", "parseProcessEnv parses static TITLE item");

    let pItems2: Array<EnvItem*>* = EnvManager::parseProcessEnv("{\n  \"process\": {\n    \"env\": {\n      \"PORT\": \"ENV::PORT\"\n    }\n  }\n}\n");
    assertTrue(pItems2->length() == 1, "parseProcessEnv parses item from process: { env: ... }");
    assertTrue(pItems2->get(0)->key == "PORT" && pItems2->get(0)->isDynamic, "parseProcessEnv dynamic item from process: { env: ... }");

    let pItems3: Array<EnvItem*>* = EnvManager::parseProcessEnv("{\n  \"env\": {\n    \"PORT\": \"ENV::[PORT]\"\n  }\n}\n");
    assertTrue(pItems3->length() == 1, "parseProcessEnv parses item from top-level env: { ... }");

    // 8. EnvManager loadEnvFile
    let devFileItems: Array<EnvItem*>* = EnvManager::loadEnvFile("tests/fixtures/.env.dev");
    assertTrue(devFileItems->length() == 4, "loadEnvFile loads 4 items from tests/fixtures/.env.dev");

    // 9. EnvManager autoLoad with tests/fixtures/env-manifest.json in development
    ProcessEnv::clear();
    let devLoaded: int = EnvManager::autoLoad("tests/fixtures/env-manifest.json", "development");
    assertTrue(devLoaded > 0, "autoLoad with development env loads variables");
    assertTrue(ProcessEnv::get("PORT", "") == "3000", "ProcessEnv::get PORT is 3000 in development");
    assertTrue(ProcessEnv::getInt("PORT", 0) == 3000, "ProcessEnv::getInt PORT is 3000 in development");
    assertTrue(ProcessEnv::get("DB_NAME", "") == "mydb_dev", "ProcessEnv::get DB_NAME is mydb_dev");
    assertTrue(ProcessEnv::get("APP_ENV_VAL", "") == "dev_secret_123", "ProcessEnv::get APP_ENV_VAL is dev_secret_123");
    assertTrue(ProcessEnv::get("STATIC_KEY", "") == "custom_val", "ProcessEnv::get STATIC_KEY is custom_val");
    assertTrue(process.env.get("PORT", "") == "3000", "process.env.get PORT is 3000 in development");
    assertTrue(process.env.getInt("PORT", 0) == 3000, "process.env.getInt PORT is 3000 in development");

    // 10. EnvManager autoLoad with tests/fixtures/env-manifest.json in production
    ProcessEnv::clear();
    let prodLoaded: int = EnvManager::autoLoad("tests/fixtures/env-manifest.json", "production");
    assertTrue(prodLoaded > 0, "autoLoad with production env loads variables");
    assertTrue(ProcessEnv::get("PORT", "") == "8080", "ProcessEnv::get PORT is 8080 in production");
    assertTrue(ProcessEnv::getInt("PORT", 0) == 8080, "ProcessEnv::getInt PORT is 8080 in production");
    assertTrue(ProcessEnv::get("DB_NAME", "") == "mydb_prod", "ProcessEnv::get DB_NAME is mydb_prod");
    assertTrue(ProcessEnv::get("APP_ENV_VAL", "") == "prod_secret_456", "ProcessEnv::get APP_ENV_VAL is prod_secret_456");
    assertTrue(process.env.get("PORT", "") == "8080", "process.env.get PORT is 8080 in production");

    // 11. ProcessEnv::set and ProcessEnv::has
    ProcessEnv::set("CUSTOM_DYNAMIC_VAR", "active_session");
    assertTrue(ProcessEnv::has("CUSTOM_DYNAMIC_VAR"), "ProcessEnv::has returns true for newly set var");
    assertTrue(ProcessEnv::get("CUSTOM_DYNAMIC_VAR", "") == "active_session", "ProcessEnv::get returns newly set var");
    assertTrue(process.env.has("CUSTOM_DYNAMIC_VAR"), "process.env.has returns true");
    assertTrue(process.env.get("CUSTOM_DYNAMIC_VAR", "") == "active_session", "process.env.get returns newly set var");

    // 12. EnvManager resolveManifest
    let rawManifestStr: string = "{\n  \"serverPort\": \"ENV::[PORT]\",\n  \"database\": \"ENV::[DATABASE_NAME]\"\n}\n";
    let resolvedJson: string = EnvManager::resolveManifest(rawManifestStr, "production", "tests/fixtures/env-manifest.json");
    assertTrue(resolvedJson.find("\"serverPort\": \"8080\"") != -1, "resolveManifest replaces ENV::[PORT] with 8080 in production");
    assertTrue(resolvedJson.find("\"database\": \"mydb_prod\"") != -1, "resolveManifest replaces ENV::[DATABASE_NAME] with mydb_prod in production");

    // 13. CLI run env
    let cli: PackCLI* = new PackCLI();
    assertTrue(cli->run("env", "tests/fixtures/env-manifest.json") == 0, "CLI run env with manifest returns 0");
}

fn testCvmRepositoryModule(): void {
    println("[SUITE 12] Testing CVM Repository & Web-Pack.json Manifest Configuration...");

    // 1. CvmRepositoryConfig defaults
    let cvmCfg: CvmRepositoryConfig* = new CvmRepositoryConfig();
    assertTrue(!cvmCfg->isDefined, "CvmRepositoryConfig default isDefined is false");
    assertTrue(cvmCfg->type == "cvm", "CvmRepositoryConfig default type is cvm");
    assertTrue(cvmCfg->url == "", "CvmRepositoryConfig default url is empty");
    assertTrue(cvmCfg->path == "cex-pack.json", "CvmRepositoryConfig default path is cex-pack.json");
    assertTrue(cvmCfg->branch == "main", "CvmRepositoryConfig default branch is main");

    // 2. Custom constructor with web-pack.json
    let customCfg: CvmRepositoryConfig* = new CvmRepositoryConfig("cvm://localhost:3110/repo/web", "web-pack.json", "release");
    assertTrue(customCfg->isDefined, "CvmRepositoryConfig custom isDefined is true");
    assertTrue(customCfg->url == "cvm://localhost:3110/repo/web", "CvmRepositoryConfig custom url matches");
    assertTrue(customCfg->path == "web-pack.json", "CvmRepositoryConfig custom path matches web-pack.json");
    assertTrue(customCfg->branch == "release", "CvmRepositoryConfig custom branch matches release");

    // 3. PackManifest setCvmRepository
    let manifest: PackManifest* = new PackManifest();
    assertTrue(!manifest->hasCvmRepository, "PackManifest default hasCvmRepository is false");
    manifest->setCvmRepository("cvm://localhost:3110/repo/app", "web-pack.json", "main");
    assertTrue(manifest->hasCvmRepository, "PackManifest hasCvmRepository is true after setCvmRepository");
    assertTrue(manifest->cvmRepository->path == "web-pack.json", "PackManifest cvmRepository path is web-pack.json");

    // 4. Schema validation with string cvm_repository
    let schemaVal: SchemaValidator* = new SchemaValidator();
    let strCvmManifest: string = "{\n  \"name\": \"@2tek/app\",\n  \"version\": \"1.0.0\",\n  \"main\": \"src/index.cex\",\n  \"target\": \"runtime\",\n  \"cvm_repository\": \"cvm://localhost:3110/repo/app\"\n}\n";
    let res1: ValidationResult* = new ValidationResult();
    schemaVal->validateCvmRepositoryRule(strCvmManifest, res1);
    assertTrue(res1->isValid && res1->errorCount == 0, "String cvm_repository passes validation");

    // 5. Schema validation with object cvm_repository pointing to web-pack.json
    let objCvmManifest: string = "{\n  \"name\": \"@2tek/app\",\n  \"version\": \"1.0.0\",\n  \"main\": \"src/index.cex\",\n  \"target\": \"runtime\",\n  \"cvm_repository\": {\n    \"type\": \"cvm\",\n    \"url\": \"cvm://localhost:3110/repo/app\",\n    \"path\": \"web-pack.json\",\n    \"branch\": \"main\"\n  }\n}\n";
    let res2: ValidationResult* = new ValidationResult();
    schemaVal->validateCvmRepositoryRule(objCvmManifest, res2);
    assertTrue(res2->isValid && res2->errorCount == 0, "Object cvm_repository with web-pack.json passes validation");

    // 6. Schema validation: empty path detection
    let emptyPathManifest: string = "{\n  \"name\": \"@2tek/app\",\n  \"version\": \"1.0.0\",\n  \"main\": \"src/index.cex\",\n  \"target\": \"runtime\",\n  \"cvm_repository\": {\n    \"type\": \"cvm\",\n    \"url\": \"cvm://localhost:3110/repo/app\",\n    \"path\": \"\",\n    \"branch\": \"main\"\n  }\n}\n";
    let res3: ValidationResult* = new ValidationResult();
    schemaVal->validateCvmRepositoryRule(emptyPathManifest, res3);
    assertTrue(!res3->isValid, "Empty cvm_repository path triggers validation error");

    // 7. Schema validation: path traversal prohibition
    let traversalManifest: string = "{\n  \"name\": \"@2tek/app\",\n  \"version\": \"1.0.0\",\n  \"main\": \"src/index.cex\",\n  \"target\": \"runtime\",\n  \"cvm_repository\": {\n    \"type\": \"cvm\",\n    \"url\": \"cvm://localhost:3110/repo/app\",\n    \"path\": \"../web-pack.json\"\n  }\n}\n";
    let res4: ValidationResult* = new ValidationResult();
    schemaVal->validateCvmRepositoryRule(traversalManifest, res4);
    assertTrue(!res4->isValid, "cvm_repository path traversal ('..') triggers validation error");

    // 8. Extraction helpers
    let extractedPath: string = SchemaValidator::extractCvmRepositoryPath(objCvmManifest);
    assertTrue(extractedPath == "web-pack.json", "extractCvmRepositoryPath correctly extracts web-pack.json");

    let defaultPath: string = SchemaValidator::extractCvmRepositoryPath("{\n  \"name\": \"app\"\n}\n");
    assertTrue(defaultPath == "cex-pack.json", "extractCvmRepositoryPath defaults to cex-pack.json");

    let extractedUrl: string = SchemaValidator::extractCvmRepositoryUrl(objCvmManifest);
    assertTrue(extractedUrl == "cvm://localhost:3110/repo/app", "extractCvmRepositoryUrl correctly extracts url from object");

    let extractedStrUrl: string = SchemaValidator::extractCvmRepositoryUrl(strCvmManifest);
    assertTrue(extractedStrUrl == "cvm://localhost:3110/repo/app", "extractCvmRepositoryUrl correctly extracts url from string");

    // 9. PackCLI CVM dispatching
    let cli: PackCLI* = new PackCLI();
    assertTrue(cli->runWithArg("check", "cex-pack.json", "") == 0, "CLI check on valid cex-pack.json returns 0");
}

fn testCvmConfigAndCexBoxesModule(): void {
    println("[SUITE 13] Testing CVM Config (.cvm/config) & .cex_boxes Target Resolution...");

    let sampleIni: string = "[repository]\n    formatversion = 2\n    target = runtime\n    engine = CexR-v8\n    package = @2tek/pack\n    boxes = .cex_boxes\n\n[cvm]\n    patchFormat = 2.0\n    compress = true\n    author = \"2-TEK Ecosystem <dev@2tek.local>\"\n\n[branch \"main\"]\n    remote = origin\n    merge = refs/heads/main\n";
    let cfg: CvmConfig* = CvmConfig::parseCvmConfig(sampleIni, ".cvm/config");

    assertTrue(cfg->isDefined, "CvmConfig isDefined is true after parsing valid INI");
    assertTrue(cfg->formatVersion == 2, "CvmConfig formatVersion is 2");
    assertTrue(cfg->target == "runtime", "CvmConfig target is runtime");
    assertTrue(cfg->engine == "CexR-v8", "CvmConfig engine is CexR-v8");
    assertTrue(cfg->packageName == "@2tek/pack", "CvmConfig package is @2tek/pack");
    assertTrue(cfg->boxesDir == ".cex_boxes", "CvmConfig boxes is .cex_boxes");
    assertTrue(cfg->patchFormat == "2.0", "CvmConfig patchFormat is 2.0");
    assertTrue(cfg->compress, "CvmConfig compress is true");
    assertTrue(cfg->author == "2-TEK Ecosystem <dev@2tek.local>", "CvmConfig author matches");
    assertTrue(cfg->remote == "origin", "CvmConfig remote is origin");
    assertTrue(cfg->merge == "refs/heads/main", "CvmConfig merge is refs/heads/main");
    assertTrue(cfg->branch == "main", "CvmConfig branch is main");

    let loadedCfg: CvmConfig* = CvmConfig::load("cex-pack.json");
    assertTrue(loadedCfg->isDefined, "CvmConfig::load on cex-pack.json loads local .cvm/config");
    assertTrue(loadedCfg->boxesDir == ".cex_boxes", "Loaded .cvm/config sets boxesDir to .cex_boxes");

    let boxDir: string = DependencyDownloader::resolveDefaultBoxDirectory("cex-pack.json", loadedCfg);
    assertTrue(boxDir == ".cex_boxes", "resolveDefaultBoxDirectory resolves to .cex_boxes when configured in .cvm");

    let cli: PackCLI* = new PackCLI();
    assertTrue(cli->runWithArg("cvm", "cex-pack.json", "config") == 0, "CLI cvm config returns 0");
}

fn main(): int {
    println("================================================------------------");
    println("      Running CexPack 100% Full Coverage Test Suite               ");
    println("================================================------------------");

    testTypesModule();
    testParserModule();
    testSchemaModule();
    testRule29EofModule();
    testThunderModule();
    testReporterModule();
    testValidatorModule();
    testDownloaderModule();
    testCLIModule();
    testExamplesIntegration();
    testEnvAndProcessEnvModule();
    testCvmRepositoryModule();
    testCvmConfigAndCexBoxesModule();

    println("================================================------------------");
    print("  Assertions: ");
    print(totalAsserts);
    print(" total, ");
    print(passedAsserts);
    print(" passed, ");
    print(failedAsserts);
    println(" failed.");
    println("================================================------------------");

    if (failedAsserts > 0) {
        println("  Status: FAILED - One or more assertions failed!");
        return 1;
    }

    println("  Status: ALL TESTCASES PASSED (100% COVERAGE)!");
    println("================================================------------------");
    return 0;
}
