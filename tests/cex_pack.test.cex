// CexPack Comprehensive Automated Test Suite (C-ext)
// 100% Testcases Coverage for Types, Parser, Schema, Reporter, Validator, Downloader, and CLI

import "../src/types.cex";
import "../src/parser.cex";
import "../src/schema.cex";
import "../src/reporter.cex";
import "../src/validator.cex";
import "../src/downloader.cex";
import "../src/cli.cex";

let totalAsserts: int = 0;
let passedAsserts: int = 0;
let failedAsserts: int = 0;

fn assertTrue(cond: bool, testName: string): void {
    totalAsserts = totalAsserts + 1;
    if (cond) {
        passedAsserts = passedAsserts + 1;
        println("  -> PASSED: " + testName);
    } else {
        failedAsserts = failedAsserts + 1;
        println("  -> FAILED: " + testName);
    }
}

fn testTypesModule(): void {
    println("[SUITE 1] Testing Types and Data Structures...");

    // 1. ValidationError
    let err: ValidationError* = new ValidationError("RULE_01", "Test Error Message", 10, 5, "ERROR");
    assertTrue(err->ruleId == "RULE_01", "ValidationError ruleId matches");
    assertTrue(err->message == "Test Error Message", "ValidationError message matches");
    assertTrue(err->line == 10, "ValidationError line matches");
    assertTrue(err->column == 5, "ValidationError column matches");
    assertTrue(err->severity == "ERROR", "ValidationError severity matches");

    // 2. ValidationResult constructor and additions
    let res: ValidationResult* = new ValidationResult();
    assertTrue(res->isValid, "ValidationResult default isValid is true");
    assertTrue(res->errorCount == 0, "ValidationResult default errorCount is 0");
    assertTrue(res->warningCount == 0, "ValidationResult default warningCount is 0");
    assertTrue(res->errors->length() == 0, "ValidationResult default errors array is empty");
    assertTrue(res->warnings->length() == 0, "ValidationResult default warnings array is empty");

    res->addError("ERR_1", "First error", 1, 1);
    assertTrue(!res->isValid, "ValidationResult isValid is false after addError");
    assertTrue(res->errorCount == 1, "ValidationResult errorCount is 1");
    assertTrue(res->errors->length() == 1, "ValidationResult errors array has 1 element");

    res->addWarning("WARN_1", "First warning", 2, 4);
    assertTrue(res->warningCount == 1, "ValidationResult warningCount is 1");
    assertTrue(res->warnings->length() == 1, "ValidationResult warnings array has 1 element");

    // 3. ThunderOutputPort
    let port: ThunderOutputPort* = new ThunderOutputPort(8080, "8080", 80, "80", "web");
    assertTrue(port->containerPort == 8080, "ThunderOutputPort containerPort matches");
    assertTrue(port->containerPortStr == "8080", "ThunderOutputPort containerPortStr matches");
    assertTrue(port->outPort == 80, "ThunderOutputPort outPort matches");
    assertTrue(port->outPortStr == "80", "ThunderOutputPort outPortStr matches");
    assertTrue(port->name == "web", "ThunderOutputPort name matches");

    // 4. ThunderConfig
    let thunCfg: ThunderConfig* = new ThunderConfig();
    assertTrue(!thunCfg->isDefined, "ThunderConfig default isDefined is false");
    assertTrue(thunCfg->env == "", "ThunderConfig default env is empty");
    assertTrue(thunCfg->outputs->length() == 0, "ThunderConfig default outputs array is empty");

    thunCfg->addOutput(3000, "3000", 3000, "3000", "api");
    assertTrue(thunCfg->outputs->length() == 1, "ThunderConfig addOutput increments outputs array");

    // 5. PackManifest
    let manifest: PackManifest* = new PackManifest();
    assertTrue(manifest->name == "", "PackManifest default name is empty");
    assertTrue(manifest->version == "", "PackManifest default version is empty");
    assertTrue(manifest->description == "", "PackManifest default description is empty");
    assertTrue(manifest->main == "", "PackManifest default main is empty");
    assertTrue(manifest->author == "", "PackManifest default author is empty");
    assertTrue(manifest->license == "", "PackManifest default license is empty");
    assertTrue(manifest->target == "", "PackManifest default target is empty");
    assertTrue(!manifest->hasRequired, "PackManifest default hasRequired is false");
    assertTrue(!manifest->hasTarget, "PackManifest default hasTarget is false");
    assertTrue(!manifest->hasDependencies, "PackManifest default hasDependencies is false");
    assertTrue(manifest->thunder->outputs->length() == 0, "PackManifest default thunder is initialized");
}

fn testParserModule(): void {
    println("[SUITE 2] Testing JSON Syntax Parser & Tokenizer...");

    // Empty content
    let emptyParser: JsonParser* = new JsonParser("");
    let emptyRes: ValidationResult* = emptyParser->parseAndValidateSyntax();
    assertTrue(!emptyRes->isValid, "Empty content triggers syntax error");
    assertTrue(emptyRes->errorCount > 0, "Empty content has error count > 0");

    // Unterminated string
    let unclosedStrParser: JsonParser* = new JsonParser("{\n  \"name\": \"unclosed\n}\n");
    let unclosedStrRes: ValidationResult* = unclosedStrParser->parseAndValidateSyntax();
    assertTrue(!unclosedStrRes->isValid, "Unterminated string literal triggers syntax error");

    // Escaped string characters
    let escapedParser: JsonParser* = new JsonParser("{\n  \"message\": \"escaped \\\"quotes\\\" and \\\\ backslash\"\n}\n");
    let escapedRes: ValidationResult* = escapedParser->parseAndValidateSyntax();
    assertTrue(escapedRes->isValid, "Escaped quotes and backslashes parse correctly");

    // Unmatched closing brace
    let braceParser: JsonParser* = new JsonParser("}\n");
    let braceRes: ValidationResult* = braceParser->parseAndValidateSyntax();
    assertTrue(!braceRes->isValid, "Unexpected closing brace triggers error");

    // Unmatched closing bracket
    let bracketParser: JsonParser* = new JsonParser("]\n");
    let bracketRes: ValidationResult* = bracketParser->parseAndValidateSyntax();
    assertTrue(!bracketRes->isValid, "Unexpected closing bracket triggers error");

    // Unclosed object
    let unclosedObjParser: JsonParser* = new JsonParser("{\n  \"name\": \"test\"\n");
    let unclosedObjRes: ValidationResult* = unclosedObjParser->parseAndValidateSyntax();
    assertTrue(!unclosedObjRes->isValid, "Unclosed object triggers error");

    // Unclosed array
    let unclosedArrParser: JsonParser* = new JsonParser("{\n  \"arr\": [1, 2\n}\n");
    let unclosedArrRes: ValidationResult* = unclosedArrParser->parseAndValidateSyntax();
    assertTrue(!unclosedArrRes->isValid, "Unclosed array triggers error");

    // Valid complex JSON
    let validParser: JsonParser* = new JsonParser("{\n  \"nested\": {\n    \"array\": [1, 2, 3]\n  }\n}\n");
    let validRes: ValidationResult* = validParser->parseAndValidateSyntax();
    assertTrue(validRes->isValid && validRes->errorCount == 0, "Valid nested JSON passes syntax validation");
}

fn testSchemaModule(): void {
    println("[SUITE 3] Testing Schema Validator & Rule Governance...");

    let schemaVal: SchemaValidator* = new SchemaValidator();

    // Missing name
    let res1: ValidationResult* = new ValidationResult();
    schemaVal->validateManifestSchema("{\n  \"version\": \"1.0.0\",\n  \"main\": \"src/index.cex\",\n  \"target\": \"runtime\"\n}\n", res1);
    assertTrue(!res1->isValid, "Missing name property caught");

    // Missing version
    let res2: ValidationResult* = new ValidationResult();
    schemaVal->validateManifestSchema("{\n  \"name\": \"@2tek/pkg\",\n  \"main\": \"src/index.cex\",\n  \"target\": \"runtime\"\n}\n", res2);
    assertTrue(!res2->isValid, "Missing version property caught");

    // Missing main
    let res3: ValidationResult* = new ValidationResult();
    schemaVal->validateManifestSchema("{\n  \"name\": \"@2tek/pkg\",\n  \"version\": \"1.0.0\",\n  \"target\": \"runtime\"\n}\n", res3);
    assertTrue(!res3->isValid, "Missing main property caught");

    // Missing target (Rule 69)
    let res4: ValidationResult* = new ValidationResult();
    schemaVal->validateManifestSchema("{\n  \"name\": \"@2tek/pkg\",\n  \"version\": \"1.0.0\",\n  \"main\": \"src/index.cex\"\n}\n", res4);
    assertTrue(!res4->isValid, "Missing target property caught under Rule 69");

    // Invalid target (Rule 69)
    let res5: ValidationResult* = new ValidationResult();
    schemaVal->validateManifestSchema("{\n  \"name\": \"@2tek/pkg\",\n  \"version\": \"1.0.0\",\n  \"main\": \"src/index.cex\",\n  \"target\": \"native-bin\"\n}\n", res5);
    assertTrue(!res5->isValid, "Invalid target property caught under Rule 69");

    // Valid target with space and compact
    let res6: ValidationResult* = new ValidationResult();
    schemaVal->validateManifestSchema("{\n  \"name\": \"@2tek/pkg\",\n  \"version\": \"1.0.0\",\n  \"main\": \"src/index.cex\",\n  \"target\": \"runtime\",\n  \"required\": { \"cexr\": \"^8\" }\n}\n", res6);
    assertTrue(res6->isValid && res6->errorCount == 0, "Valid target with space passes");

    let res7: ValidationResult* = new ValidationResult();
    schemaVal->validateManifestSchema("{\"name\":\"@2tek/pkg\",\"version\":\"1.0.0\",\"main\":\"src/index.cex\",\"target\":\"runtime\",\"required\":{\"cexr\":\"^8\"}}\n", res7);
    assertTrue(res7->isValid && res7->errorCount == 0, "Valid compact target passes");

    // Missing required warning
    let res8: ValidationResult* = new ValidationResult();
    schemaVal->validateManifestSchema("{\n  \"name\": \"@2tek/pkg\",\n  \"version\": \"1.0.0\",\n  \"main\": \"src/index.cex\",\n  \"target\": \"runtime\"\n}\n", res8);
    assertTrue(res8->warningCount > 0, "Missing required block triggers recommendation warning");

    // Unscoped name warning
    let res9: ValidationResult* = new ValidationResult();
    schemaVal->validateManifestSchema("{\n  \"name\": \"unscoped-pkg\",\n  \"version\": \"1.0.0\",\n  \"main\": \"src/index.cex\",\n  \"target\": \"runtime\",\n  \"required\": {}\n}\n", res9);
    assertTrue(res9->warningCount > 0, "Unscoped name triggers recommendation warning");
}

fn testRule29EofModule(): void {
    println("[SUITE 4] Testing Rule 29 EOF Line Ending Validation...");

    let schemaVal: SchemaValidator* = new SchemaValidator();

    // Empty content - returns cleanly
    let res1: ValidationResult* = new ValidationResult();
    schemaVal->validateEofNewline("", res1);
    assertTrue(res1->isValid && res1->errorCount == 0, "Empty content does not trigger EOF error");

    // Valid trailing newline
    let res2: ValidationResult* = new ValidationResult();
    schemaVal->validateEofNewline("{\n  \"name\": \"pkg\"\n}\n", res2);
    assertTrue(res2->isValid && res2->errorCount == 0, "Content with trailing newline passes Rule 29");

    // Missing trailing newline
    let res3: ValidationResult* = new ValidationResult();
    schemaVal->validateEofNewline("{\n  \"name\": \"pkg\"\n}", res3);
    assertTrue(!res3->isValid && res3->errorCount > 0, "Missing trailing newline caught under Rule 29");
}

fn testThunderModule(): void {
    println("[SUITE 5] Testing Thunder Zero-File Build & Rule Engine...");

    let schemaVal: SchemaValidator* = new SchemaValidator();

    // No thunder block - returns cleanly
    let res1: ValidationResult* = new ValidationResult();
    schemaVal->validateThunderRule("{\n  \"name\": \"@2tek/app\"\n}\n", res1);
    assertTrue(res1->isValid && res1->errorCount == 0, "No thunder block skips thunder checks cleanly");

    // Thunder with env missing colon
    let res2: ValidationResult* = new ValidationResult();
    schemaVal->validateThunderRule("{\n  \"thunder\": {\n    \"env\" \"./.env\"\n  }\n}\n", res2);
    assertTrue(!res2->isValid && res2->errorCount > 0, "Thunder with env missing colon triggers error");

    // Thunder missing output mappings triggers warning
    let res3: ValidationResult* = new ValidationResult();
    schemaVal->validateThunderRule("{\n  \"thunder\": {\n    \"env\": \"./.env\"\n  }\n}\n", res3);
    assertTrue(res3->warningCount > 0, "Thunder without output triggers warning");

    // Thunder output not an array triggers error
    let res4: ValidationResult* = new ValidationResult();
    schemaVal->validateThunderRule("{\n  \"thunder\": {\n    \"output\": \"not_array\"\n  }\n}\n", res4);
    assertTrue(!res4->isValid && res4->errorCount > 0, "Thunder non-array output triggers error");

    // Thunder output missing container port
    let res5: ValidationResult* = new ValidationResult();
    schemaVal->validateThunderRule("{\n  \"thunder\": {\n    \"output\": [{\"out\": 3000}]\n  }\n}\n", res5);
    assertTrue(!res5->isValid && res5->errorCount > 0, "Thunder output missing container port triggers error");

    // Thunder output missing out port
    let res6: ValidationResult* = new ValidationResult();
    schemaVal->validateThunderRule("{\n  \"thunder\": {\n    \"output\": [{\"container\": 3000}]\n  }\n}\n", res6);
    assertTrue(!res6->isValid && res6->errorCount > 0, "Thunder output missing out host port triggers error");

    // Thunder output using shorthand 'ouput'
    let res7: ValidationResult* = new ValidationResult();
    schemaVal->validateThunderRule("{\n  \"thunder\": {\n    \"ouput\": [{\"container\": 3000, \"out\": 3000}]\n  }\n}\n", res7);
    assertTrue(res7->isValid && res7->errorCount == 0, "Thunder shorthand 'ouput' passes validation");

    // Thunder Dockerfile synthesis with full configuration
    let df1: string = SchemaValidator::synthesizeThunderDockerfile("my-service", "src/main.cex", "./.env.production", 3050);
    assertTrue(df1.find("FROM @2tek/thunder:latest") != -1, "Synthesized Dockerfile contains base image");
    assertTrue(df1.find("cexp build src/main.cex") != -1, "Synthesized Dockerfile contains cexp build command");
    assertTrue(df1.find("DOTENV_CONFIG_PATH=./.env.production") != -1, "Synthesized Dockerfile contains env path");
    assertTrue(df1.find("EXPOSE 3050") != -1, "Synthesized Dockerfile contains EXPOSE port");
    assertTrue(df1.find("CMD /app/bin/my-service") != -1, "Synthesized Dockerfile contains app start command");

    // Thunder Dockerfile synthesis with minimal configuration
    let df2: string = SchemaValidator::synthesizeThunderDockerfile("server", "", "", 0);
    assertTrue(df2.find("FROM @2tek/thunder:latest") != -1, "Minimal Dockerfile contains base image");
    assertTrue(df2.find("CMD /app/bin/server") != -1, "Minimal Dockerfile falls back to /app/bin/server");
}

fn testReporterModule(): void {
    println("[SUITE 6] Testing Diagnostic Reporter...");

    let reporter: DiagnosticReporter* = new DiagnosticReporter();

    // 1. Success result
    let okRes: ValidationResult* = new ValidationResult();
    reporter->printResult("test-ok.json", okRes);
    assertTrue(okRes->isValid, "Reporter prints successful result cleanly");

    // 2. Error only result
    let errRes: ValidationResult* = new ValidationResult();
    errRes->addError("ERR_CODE_1", "Syntax violation description", 5, 12);
    reporter->printResult("test-err.json", errRes);
    assertTrue(!errRes->isValid && errRes->errorCount == 1, "Reporter handles error output");

    // 3. Warning only result
    let warnRes: ValidationResult* = new ValidationResult();
    warnRes->addWarning("WARN_CODE_1", "Non-scoped identifier used", 1, 1);
    reporter->printResult("test-warn.json", warnRes);
    assertTrue(warnRes->isValid && warnRes->warningCount == 1, "Reporter handles warning output");

    // 4. Combined error and warning result
    let comboRes: ValidationResult* = new ValidationResult();
    comboRes->addError("ERR_COMBO", "Fatal error", 3, 2);
    comboRes->addWarning("WARN_COMBO", "Advisory warning", 8, 4);
    reporter->printResult("test-combo.json", comboRes);
    assertTrue(!comboRes->isValid && comboRes->errorCount == 1 && comboRes->warningCount == 1, "Reporter handles combined diagnostics");
}

fn testValidatorModule(): void {
    println("[SUITE 7] Testing Validator Engine & File Operations...");

    let validator: PackValidator* = new PackValidator();

    // Validate valid string content
    let validContent: string = "{\n  \"name\": \"@2tek/valid-pkg\",\n  \"version\": \"1.0.0\",\n  \"main\": \"src/index.cex\",\n  \"target\": \"runtime\",\n  \"required\": { \"cexr\": \"^8\" }\n}\n";
    let resValid: ValidationResult* = validator->validateContent(validContent);
    assertTrue(resValid->isValid && resValid->errorCount == 0, "Validator engine passes valid manifest content");

    // Validate invalid string content
    let invalidContent: string = "{\n  \"name\": \"@2tek/bad-target\",\n  \"version\": \"1.0.0\",\n  \"main\": \"src/index.cex\",\n  \"target\": \"unknown\"\n}\n";
    let resInvalid: ValidationResult* = validator->validateContent(invalidContent);
    assertTrue(!resInvalid->isValid && resInvalid->errorCount > 0, "Validator engine flags invalid manifest content");

    // Validate existing valid file
    let fileOk: bool = validator->validateFile("cex-pack.json");
    assertTrue(fileOk, "Validator correctly validates existing 'cex-pack.json'");

    // Validate existing invalid file fixture
    let fileBad: bool = validator->validateFile("tests/fixtures/invalid.json");
    assertTrue(!fileBad, "Validator correctly rejects invalid file fixture");

    // Validate non-existent file
    let fileMissing: bool = validator->validateFile("tests/fixtures/non_existent_file.json");
    assertTrue(!fileMissing, "Validator returns false on missing file");
}

fn testDownloaderModule(): void {
    println("[SUITE 8] Testing Dependency Downloader & Progress Tracking...");

    let downloader: DependencyDownloader* = new DependencyDownloader();

    // PackageDependency defaults
    let dep: PackageDependency* = new PackageDependency("@2tek/cli", "1.0.0");
    assertTrue(dep->packageName == "@2tek/cli", "PackageDependency packageName initialized");
    assertTrue(dep->versionSpec == "1.0.0", "PackageDependency versionSpec initialized");
    assertTrue(dep->status == "PENDING", "PackageDependency default status is PENDING");
    assertTrue(dep->percent == 0, "PackageDependency default percent is 0");
    assertTrue(dep->currentSize == "0.00Mb", "PackageDependency default currentSize is 0.00Mb");
    assertTrue(dep->totalSize == "0.00Mb", "PackageDependency default totalSize is 0.00Mb");
    assertTrue(dep->linkedRef == "cex-pack-linked.json", "PackageDependency default linkedRef matches");

    // Parse dependencies from manifest with no dependencies
    let emptyDeps: Array<PackageDependency*>* = downloader->parseDependenciesFromManifest("{\n  \"name\": \"pkg\"\n}\n");
    assertTrue(emptyDeps->length() == 0, "No dependencies block returns 0 dependencies");

    // Parse dependencies from manifest with broken block
    let brokenDeps: Array<PackageDependency*>* = downloader->parseDependenciesFromManifest("{\n  \"dependencies\": \"invalid\"\n}\n");
    assertTrue(brokenDeps->length() == 0, "Invalid dependencies block returns 0 dependencies");

    // Parse dependencies from manifest with multiple entries
    let sampleManifest: string = "{\n  \"dependencies\": {\n    \"cex-cli\": \"1.0.0\",\n    \"cexr\": \"8.0.0\"\n  }\n}\n";
    let parsedDeps: Array<PackageDependency*>* = downloader->parseDependenciesFromManifest(sampleManifest);
    assertTrue(parsedDeps->length() == 2, "Parsed dependencies extracted expected count");
    assertTrue(parsedDeps->get(0)->packageName == "cex-cli", "First dependency packageName is cex-cli");
    assertTrue(parsedDeps->get(1)->packageName == "cexr", "Second dependency packageName is cexr");

    // Download dependencies with missing manifest
    let dlMissing: bool = downloader->downloadDependencies("non_existent_manifest.json", "tests/.cex_boxes");
    assertTrue(!dlMissing, "Downloader returns false when manifest does not exist");

    // Download dependencies with 0 dependencies
    let dlZero: bool = downloader->downloadDependencies("tests/fixtures/no-deps.json", "tests/.cex_boxes");
    assertTrue(dlZero, "Downloader succeeds when manifest declares 0 dependencies");

    // Download dependencies covering all package size branches
    let dlAll: bool = downloader->downloadDependencies("tests/fixtures/all-branches.json", "tests/.cex_boxes");
    assertTrue(dlAll, "Downloader successfully resolves all package branches and generates PROGRESS.md");
}

fn testCLIModule(): void {
    println("[SUITE 9] Testing CLI Router, Options & Commands...");

    let cli: PackCLI* = new PackCLI();

    // Basic information display
    cli->printHelp();
    cli->printVersion();
    cli->createTemplateManifest();

    // Help commands
    assertTrue(cli->run("--help", "") == 0, "CLI run --help returns 0");
    assertTrue(cli->run("-h", "") == 0, "CLI run -h returns 0");
    assertTrue(cli->run("help", "") == 0, "CLI run help returns 0");

    // Version commands
    assertTrue(cli->run("--version", "") == 0, "CLI run --version returns 0");
    assertTrue(cli->run("-v", "") == 0, "CLI run -v returns 0");
    assertTrue(cli->run("version", "") == 0, "CLI run version returns 0");

    // Init command
    assertTrue(cli->run("init", "") == 0, "CLI run init returns 0");

    // Downloads commands
    assertTrue(cli->run("downloads", "cex-pack.json") == 0, "CLI run downloads with valid file returns 0");
    assertTrue(cli->run("download", "cex-pack.json") == 0, "CLI run download with valid file returns 0");
    assertTrue(cli->run("--downloads", "cex-pack.json") == 0, "CLI run --downloads with valid file returns 0");
    assertTrue(cli->run("--download", "cex-pack.json") == 0, "CLI run --download with valid file returns 0");
    assertTrue(cli->run("downloads", "tests/fixtures/non_existent.json") == 1, "CLI run downloads with missing file returns 1");

    // Thunder commands
    assertTrue(cli->run("thunder", "cex-pack.json") == 0, "CLI run thunder with valid manifest returns 0");
    assertTrue(cli->run("--thunder", "cex-pack.json") == 0, "CLI run --thunder with valid manifest returns 0");
    assertTrue(cli->run("thunder", "tests/fixtures/invalid.json") == 1, "CLI run thunder with invalid manifest returns 1");

    // Check & lint commands
    assertTrue(cli->run("check", "cex-pack.json") == 0, "CLI run check returns 0");
    assertTrue(cli->run("lint", "cex-pack.json") == 0, "CLI run lint returns 0");
    assertTrue(cli->run("--check", "cex-pack.json") == 0, "CLI run --check returns 0");
    assertTrue(cli->run("", "cex-pack.json") == 0, "CLI run empty cmd returns 0");
    assertTrue(cli->run("cex-pack.json", "cex-pack.json") == 0, "CLI run cmd == file returns 0");
    assertTrue(cli->run("check", "tests/fixtures/invalid.json") == 1, "CLI run check with invalid file returns 1");

    // Direct file path routing
    assertTrue(cli->run("cex-pack.json", "") == 0, "CLI run direct valid filepath returns 0");
    assertTrue(cli->run("tests/fixtures/invalid.json", "") == 1, "CLI run direct invalid filepath returns 1");
}

fn testExamplesIntegration(): void {
    println("[SUITE 10] Testing Examples Integration...");

    let validator: PackValidator* = new PackValidator();
    let downloader: DependencyDownloader* = new DependencyDownloader();

    // 1. examples/pack-with-downloads
    let ex1Ok: bool = validator->validateFile("examples/pack-with-downloads/cex-pack.json");
    assertTrue(ex1Ok, "examples/pack-with-downloads/cex-pack.json validates successfully");

    let ex1Dl: bool = downloader->downloadDependencies("examples/pack-with-downloads/cex-pack.json", "examples/pack-with-downloads/.cex_boxes");
    assertTrue(ex1Dl, "examples/pack-with-downloads dependencies download successfully");

    // 2. examples/project-have-packages-insides
    let ex2Ok: bool = validator->validateFile("examples/project-have-packages-insides/cex-pack.json");
    assertTrue(ex2Ok, "examples/project-have-packages-insides/cex-pack.json validates successfully");
}

fn main(): int {
    println("================================================------------------");
    println("      Running CexPack 100% Full Coverage Test Suite               ");
    println("================================================------------------");

    testTypesModule();
    testParserModule();
    testSchemaModule();
    testRule29EofModule();
    testThunderModule();
    testReporterModule();
    testValidatorModule();
    testDownloaderModule();
    testCLIModule();
    testExamplesIntegration();

    println("================================================------------------");
    print("  Assertions: ");
    print(totalAsserts);
    print(" total, ");
    print(passedAsserts);
    print(" passed, ");
    print(failedAsserts);
    println(" failed.");
    println("================================================------------------");

    if (failedAsserts > 0) {
        println("  Status: FAILED - One or more assertions failed!");
        return 1;
    }

    println("  Status: ALL TESTCASES PASSED (100% COVERAGE)!");
    println("================================================------------------");
    return 0;
}
