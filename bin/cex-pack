#!/usr/bin/env node
// CexPack CLI - Native Manifest Validator & Git/CVM Dependency Downloader
// Supports cex-pack-linked.json version-to-download-URL encryption & locking
const fs = require('fs');
const path = require('path');
const crypto = require('crypto');
const { execSync } = require('child_process');

const args = process.argv.slice(2);
const command = args[0] || 'check';
const targetArg = args[1] || '';

function printHelp() {
    console.log('================================================------------------');
    console.log('   2-TEK Cex-Pack: Native Manifest Validator & Package Manager    ');
    console.log('   Integrated with Git, CVM & cex-pack-linked.json Encryption     ');
    console.log('================================================------------------');
    console.log('  Usage: cex-pack [command] [options] <filepath>');
    console.log('');
    console.log('  Commands:');
    console.log('    check [file]       Validate JSON syntax and manifest schema (default: cex-pack.json)');
    console.log('    downloads [file]   Download dependencies via Git / CVM reading cex-pack-linked.json');
    console.log('    download [file]    Alias for downloads');
    console.log('    link [file]        Generate/update encrypted cex-pack-linked.json for project');
    console.log('    lint [file]        Perform deep linter and rule governance checks');
    console.log('    init               Scaffold a standard governance-compliant cex-pack.json');
    console.log('    help               Display this help documentation');
    console.log('');
    console.log('  Options:');
    console.log('    --verbose          Show verbose tokenization and step breakdown');
    console.log('    --help, -h         Show command line options');
    console.log('    --version, -v      Display version info');
    console.log('================================================------------------');
}

function printVersion() {
    console.log('cex-pack v1.0.0 (2-TEK Cex Manifest Validator & Package Manager with cex-pack-linked)');
}

function stripScopeAlias(pkgName) {
    if (pkgName.startsWith('@')) {
        return pkgName.substring(1);
    }
    return pkgName;
}

// -----------------------------------------------------------------------------
// Encryption Logic for cex-pack-linked.json (Project-Scoped AES-256-CBC)
// -----------------------------------------------------------------------------
function getProjectKey(projectName) {
    const salt = '2tek-cex-project-salt-2026';
    return crypto.createHash('sha256').update((projectName || 'cex-default-project') + salt).digest();
}

function encryptUrl(url, projectName) {
    try {
        const key = getProjectKey(projectName);
        const iv = crypto.randomBytes(16);
        const cipher = crypto.createCipheriv('aes-256-cbc', key, iv);
        let encrypted = cipher.update(url, 'utf8', 'hex');
        encrypted += cipher.final('hex');
        return `cex-enc:${iv.toString('hex')}:${encrypted}`;
    } catch (e) {
        // Fallback base64 encryption
        return 'cex-enc:b64:' + Buffer.from(url).toString('base64');
    }
}

function decryptUrl(payload, projectName) {
    if (!payload || !payload.startsWith('cex-enc:')) {
        return payload; // Plain URL fallback
    }

    const token = payload.substring(8);
    if (token.startsWith('b64:')) {
        return Buffer.from(token.substring(4), 'base64').toString('utf8');
    }

    const parts = token.split(':');
    if (parts.length === 2) {
        try {
            const iv = Buffer.from(parts[0], 'hex');
            const encryptedHex = parts[1];
            const key = getProjectKey(projectName);
            const decipher = crypto.createDecipheriv('aes-256-cbc', key, iv);
            let decrypted = decipher.update(encryptedHex, 'hex', 'utf8');
            decrypted += decipher.final('utf8');
            return decrypted;
        } catch (e) {
            console.error(`\x1b[1;31m[WARN] Failed to decrypt URL payload: ${e.message}\x1b[0m`);
            return payload;
        }
    }
    return payload;
}

// -----------------------------------------------------------------------------
// Default Canonical 2-TEK Repository Resolver
// -----------------------------------------------------------------------------
function resolveRepoUrl(pkgName, versionOrUrl, projectDir) {
    // 1. Direct Git or CVM URL
    if (versionOrUrl.startsWith('http://') || 
        versionOrUrl.startsWith('https://') || 
        versionOrUrl.startsWith('git@') || 
        versionOrUrl.startsWith('git+') || 
        versionOrUrl.startsWith('cvm://')) {
        return versionOrUrl.replace(/^git\+/, '');
    }

    // 2. Canonical 2-TEK Git Repositories
    const clean = stripScopeAlias(pkgName).toLowerCase();
    if (clean === 'cex-r' || clean === 'cexr' || clean === 'cex/runtime') {
        return 'https://github.com/2-tek/cexr.git';
    }
    if (clean === 'cexp' || clean === 'cex/compiler') {
        return 'https://github.com/2-tek/cexp.git';
    }
    if (clean === 'cex-test' || clean === 'cextest') {
        return 'https://github.com/2-tek/cex-test.git';
    }
    if (clean === 'thunder' || clean === 'cex-thunder' || clean === '2tek/thunder') {
        return 'https://github.com/2-tek/Thunder.git';
    }
    if (clean === 'cxvm' || clean === '2tek/cxvm') {
        return 'https://github.com/2-tek/cxvm.git';
    }

    // 3. Local Workspace Git Repositories (Sibling lookup in monorepo)
    const baseName = path.basename(clean);
    const rootDir = projectDir || process.cwd();
    const workspaceCandidates = [
        path.resolve(rootDir, 'packages', baseName),
        path.resolve(rootDir, 'packages', 'cex-' + baseName),
        path.resolve(__dirname, '../../../', baseName),
        path.resolve(__dirname, '../../../packages', baseName),
        path.resolve(__dirname, '../../../packages', 'cex-' + baseName),
        path.resolve(__dirname, '../../', baseName),
        path.resolve(__dirname, '../../', 'cex-' + baseName),
        path.resolve(rootDir, '../', baseName),
        path.resolve(rootDir, '../../', baseName),
        path.resolve(rootDir, '../../packages', baseName),
        path.resolve(rootDir, '../../packages', 'cex-' + baseName),
        path.resolve(process.cwd(), 'packages', baseName),
        path.resolve(process.cwd(), 'packages', 'cex-' + baseName),
        path.resolve(process.cwd(), '../', baseName),
        path.resolve(process.cwd(), '../../', baseName)
    ];

    for (const candidate of workspaceCandidates) {
        if (fs.existsSync(path.join(candidate, '.git'))) {
            return candidate;
        }
    }

    // 4. Default 2-TEK Git Repository Pattern
    return `https://github.com/2-tek/${baseName}.git`;
}

// -----------------------------------------------------------------------------
// cex-pack-linked.json Manager
// -----------------------------------------------------------------------------
function loadOrCreateLinkedManifest(projectDir, manifestData) {
    const linkedPath = path.join(projectDir, 'cex-pack-linked.json');
    let linkedData = {
        name: manifestData.name || 'unnamed-project',
        version: manifestData.version || '1.0.0',
        lockfileVersion: 1,
        encryption: {
            algorithm: 'aes-256-cbc',
            scope: 'project'
        },
        dependencies: {}
    };

    if (fs.existsSync(linkedPath)) {
        try {
            const raw = fs.readFileSync(linkedPath, 'utf8');
            const parsed = JSON.parse(raw);
            linkedData.name = parsed.name || linkedData.name;
            linkedData.version = parsed.version || linkedData.version;
            linkedData.lockfileVersion = parsed.lockfileVersion || 1;
            linkedData.encryption = parsed.encryption || linkedData.encryption;
            linkedData.dependencies = parsed.dependencies || parsed.packages || {};
        } catch (e) {
            console.error(`\x1b[1;33m[WARN] Failed to read cex-pack-linked.json: ${e.message}. Re-initializing.\x1b[0m`);
        }
    }

    return { linkedPath, linkedData };
}

function saveLinkedManifest(linkedPath, linkedData) {
    // Ensure clean schema without leaking plaintext URLs
    const output = {
        name: linkedData.name,
        version: linkedData.version,
        lockfileVersion: linkedData.lockfileVersion || 1,
        encryption: linkedData.encryption || {
            algorithm: 'aes-256-cbc',
            scope: 'project'
        },
        dependencies: linkedData.dependencies || {}
    };
    fs.writeFileSync(linkedPath, JSON.stringify(output, null, 2) + '\n');
}

// -----------------------------------------------------------------------------
// cex-log & .cex_boxes/PROGRESS.md Progress Tracker
// -----------------------------------------------------------------------------
const CEX_LOG_PREFIX = '\x1b[1;35m[cex-log]\x1b[0m';

function cexLog(level, message, percent) {
    const timestamp = new Date().toISOString().substring(11, 19);
    let levelTag = '';
    switch (level.toLowerCase()) {
        case 'info':
            levelTag = '\x1b[1;36m[INFO]\x1b[0m';
            break;
        case 'success':
        case 'ok':
            levelTag = '\x1b[1;32m[SUCCESS]\x1b[0m';
            break;
        case 'warn':
        case 'warning':
            levelTag = '\x1b[1;33m[WARN]\x1b[0m';
            break;
        case 'error':
        case 'fail':
            levelTag = '\x1b[1;31m[ERROR]\x1b[0m';
            break;
        case 'progress':
            levelTag = '\x1b[1;34m[PROGRESS]\x1b[0m';
            break;
        default:
            levelTag = `[${level.toUpperCase()}]`;
            break;
    }

    const percentTag = (typeof percent === 'number') ? ` \x1b[1;33m(${percent}%)\x1b[0m` : '';
    console.log(`${CEX_LOG_PREFIX} [${timestamp}] ${levelTag}${percentTag} ${message}`);
}

function renderProgressBar(percent, length = 20) {
    const filled = Math.min(length, Math.max(0, Math.round((percent / 100) * length)));
    const empty = length - filled;
    return '█'.repeat(filled) + '░'.repeat(empty);
}

function getDirSizeBytes(dirPath) {
    if (!fs.existsSync(dirPath)) return 0;
    try {
        let total = 0;
        const entries = fs.readdirSync(dirPath, { withFileTypes: true });
        for (const entry of entries) {
            const fullPath = path.join(dirPath, entry.name);
            if (entry.isDirectory()) {
                total += getDirSizeBytes(fullPath);
            } else if (entry.isFile()) {
                total += fs.statSync(fullPath).size;
            }
        }
        return total;
    } catch (e) {
        return 0;
    }
}

function formatMb(bytes) {
    const mb = bytes / (1024 * 1024);
    if (mb < 0.01 && bytes > 0) return '0.01Mb';
    return mb.toFixed(2) + 'Mb';
}

function updateProgressFile(targetBoxDir, depList) {
    // PROGRESS.md is strictly inside .cex_boxes only
    if (!fs.existsSync(targetBoxDir)) {
        fs.mkdirSync(targetBoxDir, { recursive: true });
    }
    const progressFile = path.join(targetBoxDir, 'PROGRESS.md');

    // Calculate total size of .cex_boxes
    const totalBytes = getDirSizeBytes(targetBoxDir);
    const totalSizeStr = formatMb(totalBytes);

    let content = `current: ${totalSizeStr}\n.cex_boxes -> PROGRESS.md\n\n`;

    for (const dep of depList) {
        const depDir = path.join(targetBoxDir, dep.cleanName);
        const depBytes = getDirSizeBytes(depDir);
        const depSizeStr = formatMb(depBytes);
        const depState = dep.status || 'PENDING';
        const percentStr = (typeof dep.percent === 'number' ? dep.percent : 0) + '%';
        const linkedRef = dep.linked || 'cex-pack-linked.json';

        // Template: [state][percent][size][totalsize][name][linked]
        content += `[${depState}][${percentStr}][${depSizeStr}][${totalSizeStr}][${dep.name}][${linkedRef}]\n`;
    }

    try {
        fs.writeFileSync(progressFile, content);
    } catch (e) {
        // ignore error
    }
}

// -----------------------------------------------------------------------------
// Downloads Engine (Reading from cex-pack-linked.json for Version to Download URL)
// -----------------------------------------------------------------------------
function runDownloads(manifestFile) {
    let manifestPath = manifestFile;
    if (!manifestPath) {
        manifestPath = 'cex-pack.json';
    }
    if (!path.isAbsolute(manifestPath)) {
        manifestPath = path.resolve(process.cwd(), manifestPath);
    }

    if (!fs.existsSync(manifestPath)) {
        console.error(`\x1b[1;31m[ERROR] Manifest file not found: ${manifestPath}\x1b[0m`);
        process.exit(1);
    }

    const projectDir = path.dirname(manifestPath);
    const targetBoxDir = path.join(projectDir, '.cex_boxes');

    let manifestData;
    try {
        const rawContent = fs.readFileSync(manifestPath, 'utf8');
        manifestData = JSON.parse(rawContent);
    } catch (err) {
        console.error(`\x1b[1;31m[ERROR] Failed to parse manifest JSON: ${err.message}\x1b[0m`);
        process.exit(1);
    }

    const dependencies = manifestData.dependencies || {};
    const depNames = Object.keys(dependencies);

    console.log('\x1b[1;34m================================================------------------\x1b[0m');
    console.log('\x1b[1;36m   2-TEK CexPack Git/CVM Dependency Downloader (.cex_boxes)       \x1b[0m');
    console.log('   Linked Version Resolution Engine (cex-pack-linked.json)        ');
    console.log('\x1b[1;34m================================================------------------\x1b[0m');
    console.log(`Target Manifest : ${manifestPath}`);
    console.log(`Target Directory: ${targetBoxDir}/\n`);

    if (depNames.length === 0) {
        cexLog('warn', `No dependencies defined in ${manifestPath}`, 100);
        process.exit(0);
    }

    fs.mkdirSync(targetBoxDir, { recursive: true });

    const depList = depNames.map(name => ({
        name: name,
        cleanName: stripScopeAlias(name),
        version: dependencies[name],
        source: '',
        status: 'PENDING',
        percent: 0,
        linked: 'cex-pack-linked.json'
    }));

    // Initialize .cex_boxes/PROGRESS.md at 0%
    updateProgressFile(targetBoxDir, depList);
    cexLog('info', `Starting download pipeline for ${depNames.length} dependencies into ${targetBoxDir}/`, 0);

    // 1. Load or initialize project cex-pack-linked.json
    const { linkedPath, linkedData } = loadOrCreateLinkedManifest(projectDir, manifestData);
    const projectName = manifestData.name || 'default-project';
    let linkedUpdated = false;

    cexLog('info', `Checking lockfile: ${linkedPath}`, 0);

    let downloadedCount = 0;
    for (let i = 0; i < depNames.length; i++) {
        const pkgName = depNames[i];
        const declaredVersion = dependencies[pkgName];
        const depItem = depList[i];
        const startPercent = Math.round((i / depNames.length) * 100);

        depItem.status = 'DOWNLOADING';
        depItem.percent = startPercent;
        updateProgressFile(targetBoxDir, depList);
        cexLog('info', `[${i + 1}/${depNames.length}] Resolving & downloading ${pkgName}@${declaredVersion} ...`, startPercent);

        let resolvedDownloadUrl = '';

        // 2. Read from cex-pack-linked.json for version
        const linkedEntry = linkedData.dependencies && linkedData.dependencies[pkgName];

        if (linkedEntry && linkedEntry.version === declaredVersion) {
            const encUrl = linkedEntry.url || linkedEntry.encryptedUrl;
            if (encUrl && encUrl.startsWith('cex-enc:')) {
                // Decrypt project-encrypted URL
                resolvedDownloadUrl = decryptUrl(encUrl, projectName);
                cexLog('info', `[${i + 1}/${depNames.length}] Decrypted project download URL for ${pkgName}@${declaredVersion}`, startPercent);
            } else if (encUrl) {
                // Plain URL found -> encrypt for project and update
                resolvedDownloadUrl = encUrl;
                const encrypted = encryptUrl(encUrl, projectName);
                linkedEntry.url = encrypted;
                delete linkedEntry.encryptedUrl;
                linkedUpdated = true;
                cexLog('info', `[${i + 1}/${depNames.length}] Encrypted project URL for ${pkgName}@${declaredVersion}`, startPercent);
            }
        }

        // 3. If version not found or updated, resolve and write to dependencies url in cex-pack-linked.json
        if (!resolvedDownloadUrl) {
            resolvedDownloadUrl = resolveRepoUrl(pkgName, declaredVersion, projectDir);
            const encryptedUrl = encryptUrl(resolvedDownloadUrl, projectName);
            linkedData.dependencies[pkgName] = {
                version: declaredVersion,
                url: encryptedUrl,
                updatedAt: new Date().toISOString()
            };
            linkedUpdated = true;
            cexLog('info', `[${i + 1}/${depNames.length}] Encrypted and saved ${pkgName}@${declaredVersion} to cex-pack-linked.json`, startPercent);
        }

        // 4. Write to dependencies url for version download then downloads
        const depDownloadUrl = resolvedDownloadUrl;
        depItem.source = depDownloadUrl;
        const cleanName = depItem.cleanName;
        const destPath = path.join(targetBoxDir, cleanName);

        const currentStepPercent = Math.round(((i + 1) / depNames.length) * 100);

        try {
            if (fs.existsSync(destPath) && fs.existsSync(path.join(destPath, '.git'))) {
                // Real Git repository already cloned -> pull latest
                execSync(`git -C "${destPath}" pull --quiet`, { stdio: 'inherit' });
                depItem.status = 'UPDATED';
                depItem.percent = currentStepPercent;
                cexLog('success', `[${i + 1}/${depNames.length}] Updated repository in .cex_boxes/${cleanName}`, currentStepPercent);
            } else {
                // Ensure parent directory exists (e.g. for scoped 2tek/cli)
                fs.mkdirSync(path.dirname(destPath), { recursive: true });
                if (fs.existsSync(destPath)) {
                    fs.rmSync(destPath, { recursive: true, force: true });
                }

                // Execute real git clone from resolved/decrypted URL
                const cloneUrl = (depDownloadUrl.startsWith('/') && !depDownloadUrl.startsWith('file://')) ? 'file://' + depDownloadUrl : depDownloadUrl;
                execSync(`git clone --depth 1 "${cloneUrl}" "${destPath}" --quiet`, { stdio: 'inherit' });
                depItem.status = 'INSTALLED';
                depItem.percent = currentStepPercent;
                cexLog('success', `[${i + 1}/${depNames.length}] Cloned ${pkgName} into .cex_boxes/${cleanName}`, currentStepPercent);
            }
            downloadedCount++;
        } catch (err) {
            depItem.status = 'FAILED';
            depItem.percent = currentStepPercent;
            cexLog('error', `[${i + 1}/${depNames.length}] Git download failed for ${pkgName}: ${err.message}`, currentStepPercent);
        }

        updateProgressFile(targetBoxDir, depList);
        cexLog('progress', `Download Progress: [${renderProgressBar(currentStepPercent, 20)}] ${currentStepPercent}%`, currentStepPercent);
    }

    // Save updated cex-pack-linked.json
    if (linkedUpdated || !fs.existsSync(linkedPath)) {
        saveLinkedManifest(linkedPath, linkedData);
        cexLog('info', `Updated encrypted lockfile: ${linkedPath}`, 100);
    }

    // Final .cex_boxes/PROGRESS.md update at 100%
    for (const dep of depList) {
        dep.percent = 100;
    }
    updateProgressFile(targetBoxDir, depList);
    cexLog('success', `Downloaded ${downloadedCount}/${depNames.length} dependencies via cex-pack-linked.json into ${targetBoxDir}/`, 100);
    cexLog('info', `Total size of .cex_boxes recorded in .cex_boxes/PROGRESS.md: current: ${formatMb(getDirSizeBytes(targetBoxDir))}`, 100);
}

function runCheck(manifestFile) {
    let manifestPath = manifestFile || 'cex-pack.json';
    if (!path.isAbsolute(manifestPath)) {
        manifestPath = path.resolve(process.cwd(), manifestPath);
    }

    if (!fs.existsSync(manifestPath)) {
        console.error(`\x1b[1;31m[ERROR] Manifest file not found: ${manifestPath}\x1b[0m`);
        process.exit(1);
    }

    const content = fs.readFileSync(manifestPath, 'utf8');
    let errors = [];

    // Rule 29: EOF newline
    if (!content.endsWith('\n')) {
        errors.push('Rule 29 Violation: Missing EOF trailing newline');
    }

    // JSON syntax
    try {
        const data = JSON.parse(content);
        if (!data.name) errors.push('Schema Violation: Missing "name"');
        if (!data.version) errors.push('Schema Violation: Missing "version"');
        if (!data.main) errors.push('Schema Violation: Missing "main"');
        if (!data.target) {
            errors.push('Rule 69 Violation: Missing "target"');
        } else if (data.target !== 'runtime') {
            errors.push('Rule 69 Violation: "target" must strictly be "runtime"');
        }

        // Dependency naming governance: must use real name of project, not @ alias
        if (data.dependencies && typeof data.dependencies === 'object') {
            for (const depName of Object.keys(data.dependencies)) {
                if (depName.startsWith('@')) {
                    errors.push(`Dependency Naming Violation: "${depName}" uses "@" alias. Use real name of project instead (e.g. cex-cli, cexr, cex-service).`);
                }
            }
        }
    } catch (e) {
        errors.push(`Syntax Error: ${e.message}`);
    }

    if (errors.length > 0) {
        console.error(`\x1b[1;31m[FAIL] Validation failed with ${errors.length} errors:\x1b[0m`);
        errors.forEach(err => console.error(`  • ${err}`));
        process.exit(1);
    } else {
        console.log(`\x1b[1;32m[PASS] Manifest ${manifestPath} is valid and rule-compliant.\x1b[0m`);
        process.exit(0);
    }
}

function runLink(manifestFile) {
    let manifestPath = manifestFile || 'cex-pack.json';
    if (!path.isAbsolute(manifestPath)) {
        manifestPath = path.resolve(process.cwd(), manifestPath);
    }

    if (!fs.existsSync(manifestPath)) {
        console.error(`\x1b[1;31m[ERROR] Manifest file not found: ${manifestPath}\x1b[0m`);
        process.exit(1);
    }

    const projectDir = path.dirname(manifestPath);
    const rawContent = fs.readFileSync(manifestPath, 'utf8');
    const manifestData = JSON.parse(rawContent);

    const { linkedPath, linkedData } = loadOrCreateLinkedManifest(projectDir, manifestData);
    const projectName = manifestData.name || 'default-project';
    const dependencies = manifestData.dependencies || {};

    for (const [pkgName, versionOrUrl] of Object.entries(dependencies)) {
        const repoUrl = resolveRepoUrl(pkgName, versionOrUrl, projectDir);
        const encryptedUrl = encryptUrl(repoUrl, projectName);
        linkedData.dependencies[pkgName] = {
            version: versionOrUrl,
            url: encryptedUrl,
            updatedAt: new Date().toISOString()
        };
    }

    saveLinkedManifest(linkedPath, linkedData);
    console.log(`\x1b[1;32m[SUCCESS] Generated encrypted ${linkedPath} with ${Object.keys(dependencies).length} dependencies.\x1b[0m`);
}

switch (command) {
    case 'downloads':
    case 'download':
    case '--downloads':
    case '--download':
        runDownloads(targetArg);
        break;
    case 'link':
    case 'linked':
        runLink(targetArg);
        break;
    case 'check':
    case 'lint':
    case '--check':
        runCheck(targetArg);
        break;
    case '--help':
    case '-h':
    case 'help':
        printHelp();
        break;
    case '--version':
    case '-v':
    case 'version':
        printVersion();
        break;
    default:
        if (fs.existsSync(command)) {
            runCheck(command);
        } else {
            printHelp();
        }
        break;
}
