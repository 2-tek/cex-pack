{
  "name": "@2tek/pack",
  "version": "1.0.0",
  "description": "CexPack: Native Syntax Checker & Manifest Validator for cex-pack.json configuration files in C-ext (Cex)",
  "main": "src/index.cex",
  "author": "2-TEK Ecosystem",
  "license": "MIT",
  "target": "runtime",
  "required": {
    "cexr": "^8",
    "cexp": "^8"
  },
  "scripts": {
    "build": "cexp build src/index.cex -o bin/cex-pack",
    "start": "cexr run src/index.cex",
    "dev": "cexr run src/index.cex",
    "lint": "cexr run src/index.cex --check",
    "test": "cexr run tests/cex_pack.test.cex"
  },
  "dependencies": {
    "@cex-r": "1.0.0",
    "@cex-s": "1.0.0",
    "@cex-test": "1.0.0"
  },
  "includeDirs": [
    "./src"
  ],
  "lint": {
    "onBuild": true,
    "include": [
      "src",
      "tests"
    ],
    "rules": {
      "indent": { "level": "error", "size": 4 },
      "quotes": { "level": "error", "style": "double" },
      "semi": "error",
      "no-tabs": "error",
      "no-trailing-spaces": "error",
      "eol-last": "error"
    }
  }
}
