{
    "name": "cex-pack",
    "version": "2.0.1",
    "description": "CexPack: Native Syntax Checker, Manifest Validator & Dependency Downloader for cex-pack.json configuration files in C-ext (Cex)",
    "main": "src/index.cex",
    "author": "2-TEK Ecosystem",
    "license": "MIT",
    "target": "runtime",
    "cvm_repository": {
        "type": "cvm",
        "url": "cvm://localhost:3110/repo/cex-pack",
        "path": "cex-pack.json",
        "branch": "main"
    },
    "required": {
        "cexr-factory": "^8",
        "cexp-v8": "^8",
        "cexp-v8-stable": "^8"
    },
    "scripts": {
        "build": "cexp-v8-stable build src/index.cex -o bin/cex-pack",
        "start": "cex-pack check",
        "dev": "cex-pack check",
        "lint": "cex-pack lint",
        "downloads": "cex-pack downloads",
        "download": "cex-pack downloads",
        "test": "cxvm test",
        "example:download": "cex-pack downloads examples/pack-with-downloads/cex-pack.json"
    },
    "dependencies": {
        "cex-env": "2.0.0",
        "cex-logger": "2.0.0",
        "cex-cli": "2.0.0",
        "cex-log": "2.0.0",
        "cex-service": "2.0.0",
        "cex-test": "2.0.0"
    },
    "includeDirs": [
        "./src"
    ],
    "lint": {
        "onBuild": false,
        "include": [
            "src",
            "tests",
            "examples"
        ],
        "rules": {
            "indent": {
                "level": "error",
                "size": 4
            },
            "quotes": {
                "level": "error",
                "style": "double"
            },
            "semi": "error",
            "no-tabs": "error",
            "no-trailing-spaces": "error",
            "eol-last": "error"
        }
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/2-tek/cex-pack.git"
    }
}
