// Example Internal Core Package (C-ext)

class CoreService {
    private serviceName: string;
    private initialized: bool = true;

    public constructor(string name) {
        this.serviceName = name;
    }

    public string getStatus() {
        if (this.initialized) {
            return "ONLINE: Core service [" + this.serviceName + "] operational.";
        }
        return "OFFLINE";
    }

    public int calculate(int val1, int val2) {
        return val1 + val2;
    }
}
