{
    "name": "project-have-packages-insides",
    "version": "2.0.0",
    "description": "Example Cex workspace demonstrating a project with internal packages inside packages/ directory",
    "main": "src/main.cex",
    "target": "runtime",
    "required": {
        "cexr-factory": "^8",
        "cexp-v8": "^6",
        "cexp-v8-stable": "^8"
    },
    "workspaces": [
        "packages/*"
    ],
    "packages": [
        "packages/core",
        "packages/ui"
    ],
    "scripts": {
        "install": "cex-pack downloads",
        "downloads": "cex-pack downloads",
        "start": "cexr-factory run src/main.cex",
        "test": "cext tests/workspace.test.cex"
    },
    "dependencies": {
        "cex-env": "2.0.0",
        "cex-logger": "2.0.0",
        "cex-cli": "2.0.0",
        "cex-service": "2.0.0",
        "cex-test": "2.0.0"
    },
    "includeDirs": [
        "./src",
        "./packages/core/src",
        "./packages/ui/src"
    ]
}
